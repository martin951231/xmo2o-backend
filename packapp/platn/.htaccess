<IfModule mod_rewrite.c>
	RewriteEngine On
		
	RewriteBase /packapp/platn/
	RewriteRule ^packapp/platn/index.html$ - [L]
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteCond %{REQUEST_URI} !^.*(\.css|\.js|\.gif|\.png|\.jpg|\.jpeg)$
	RewriteRule . /packapp/platn/index.html [L]
</IfModule>