<block wx:if="{{tabbar.tabbar_type=='business'}}"><block><block wx:if="{{!tabbar.hidden}}"><view class="tabbar_box" style="{{('background-color:'+tabbar.backgroundColor)}}"><block wx:for="{{tabbar.list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block><block wx:if="{{!item.page_path}}"><view class="tabbar_nav" style="{{('color:'+tabbar.color)}}" data-url="{{item.url}}" data-title="{{item.name}}" data-event-opts="{{[['tap',[['goUrl',['$event']]]]]}}" bindtap="__e"><image class="{{['tabbar_icon '+(item.type==1?'big':'')]}}" src="{{item.pic_path}}"></image><text>{{item.name}}</text></view></block><block wx:else><block><block wx:if="{{item.page_path!=tabbar.nowPage}}"><block><view class="tabbar_nav" style="{{('color:'+tabbar.color)}}" hover-class="none" data-url="{{item.page_url}}" data-event-opts="{{[['tap',[['switchUrl',['$event']]]]]}}" bindtap="__e"><image class="{{['tabbar_icon '+(item.type==1?'big':'')]}}" src="{{item.pic_path}}"></image><text>{{item.name}}</text></view></block></block><block wx:else><block><block wx:if="{{item.showTop}}"><view data-event-opts="{{[['tap',[['returnTop',['$event']]]]]}}" class="tabbar_nav" style="{{('color:'+tabbar.selectedColor)}}" bindtap="__e"><text class="iconfont icon-returnTop tabbar_icon"></text><lang vue-id="{{'586afa10-1-'+index}}" keywords="回到顶部" bind:__l="__l"></lang></view></block><block wx:else><view class="tabbar_nav" style="{{('color:'+tabbar.selectedColor)}}" hover-class="none" data-url="{{item.page_url}}" data-event-opts="{{[['tap',[['switchUrl',['$event']]]]]}}" bindtap="__e"><image class="{{['tabbar_icon '+(item.type==1?'big':'')]}}" src="{{item.hover_pic_path}}"></image><text>{{item.name}}</text></view></block></block></block></block></block></block></block></view></block></block></block><block wx:else><block><block wx:if="{{!tabbar.hidden}}"><view class="tabbar_box" style="{{('background-color:'+tabbar.backgroundColor)}}"><block wx:for="{{tabbar.list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block><block wx:if="{{item.isSpecial}}"><view class="tabbar_nav" style="{{('color:'+tabbar.color)}}" data-type="{{item.pageType}}" data-url="{{item.pagePath}}" data-title="{{item.text}}" data-index="{{index}}" data-event-opts="{{[['tap',[['goUrl',['$event']]]]]}}" bindtap="__e"><image class="{{['tabbar_icon '+(item.type==1?'big':'')]}}" src="{{item.iconPath}}"></image><block wx:if="{{item.type==0}}"><text>{{item.text}}</text></block></view></block><block wx:else><block><block wx:if="{{!item.selected}}"><block><navigator class="tabbar_nav" style="{{('color:'+tabbar.color)}}" hover-class="none" url="{{item.pagePath}}" open-type="switchTab" data-event-opts="{{[['tap',[['switchBottomTab',['$0'],[[['tabbar.list','',index]]]]]]]}}" bindtap="__e"><image class="{{['tabbar_icon '+(item.type==1?'big':'')]}}" src="{{item.iconPath}}"></image><block wx:if="{{item.type==0}}"><text>{{item.text}}</text></block></navigator></block></block><block wx:else><block><block wx:if="{{item.showTop}}"><view data-event-opts="{{[['tap',[['returnTop',['$event']]]]]}}" class="tabbar_nav" style="{{('color:'+tabbar.selectedColor)}}" bindtap="__e"><text class="iconfont icon-returnTop tabbar_icon"></text><lang vue-id="{{'586afa10-2-'+index}}" keywords="回到顶部" bind:__l="__l"></lang></view></block><block wx:else><navigator class="tabbar_nav" style="{{('color:'+tabbar.selectedColor)}}" hover-class="none" url="{{item.pagePath}}" open-type="switchTab"><image class="{{['tabbar_icon '+(item.type==1?'big':'')]}}" src="{{item.selectedIconPath}}"></image><block wx:if="{{item.type==0}}"><text>{{item.text}}</text></block></navigator></block></block></block></block></block></block></block></view></block></block></block>