<view class="container" style="height:100vh;"><view class="fixed-top"><view class="head-box"><view class="search-box"><image class="search-img" src="../../../static/images/search.png" mode></image><input class="ipt" type="text" value="{{searchwords}}" placeholder="业主姓名/手机号" placeholder-class="pla-text" data-event-opts="{{[['focus',[['focusbox',['$event']]]],['blur',[['blurbox',['$event']]]],['confirm',[['confirmbox',['$event']]]],['input',[['__set_model',['','searchwords','$event',[]]]]]]}}" bindfocus="__e" bindblur="__e" bindconfirm="__e" bindinput="__e"/></view><block wx:if="{{hidesearch}}"><view data-event-opts="{{[['tap',[['searchbtn',['$event']]]]]}}" class="search-text" bindtap="__e">搜索</view></block></view><view class="all-box"><block wx:if="{{isshow}}"><view class="cate-box"><view class="cate-text">{{"水费：￥"+alldata.water_price}}</view><view class="cate-text">{{"电费：￥"+alldata.electric_price}}</view><view class="cate-text">{{"燃气费：￥"+alldata.gas_price}}</view><view class="cate-text">{{"停车费：￥"+alldata.park_price}}</view><view class="cate-text">{{"物业费：￥"+alldata.property_price}}</view><view class="cate-text">{{"自定义缴费：￥"+alldata.payment_price}}</view></view></block><view class="all-money-box"><view class="cate-text">{{"合计：￥"+alldata.total_price}}</view><view data-event-opts="{{[['tap',[['showbox',['$event']]]]]}}" class="btn-box" bindtap="__e"><block wx:if="{{isshow}}"><view class="btn-text">收起</view></block><block wx:else><view class="btn-text">详情</view></block><view class="{{['jiantou-top',isshow?'':'jiantou-bottom']}}"></view></view></view></view></view><block wx:if="{{!no_data}}"><scroll-view class="scroll-box" style="{{(isshow?'padding-top: 410rpx;':'')}}" scroll-y="true"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><view data-event-opts="{{[['tap',[['godetails',['$0'],[[['listdata','',index,'pigcms_id']]]]]]]}}" class="card" bindtap="__e"><view class="top-box"><view class="left-box"><view class="top-title">{{item.name}}</view><block wx:if="{{item.type==0}}"><view class="right-box1">房主</view></block><block wx:if="{{item.type==1}}"><view class="right-box1">家人</view></block><block wx:if="{{item.type==2}}"><view class="right-box1">租客</view></block><block wx:if="{{item.type==3}}"><view class="right-box1">更新房主</view></block></view><view class="right-box"><view class="mini-title">¥</view><view class="top-title">{{item.money}}</view></view></view><view class="bottom-box"><view><view class="mini-flex"><view class="text">手机号码: </view><view class="text">{{item.phone}}</view></view><view class="mini-flex"><view class="text">地址: </view><view class="text">{{item.address}}</view></view></view></view></view></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="e065e390-1" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="e065e390-2" keywords="没有更多记录" bind:__l="__l"></lang></view></block></scroll-view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="https://hf.pigcms.com/static/images/house/no_data.png"></image><view class="no_tip_content">暂无内容~</view></view></block></view>