<view class="container" style="height:100vh;"><view class="head-box"><view class="search-box"><image class="search-img" src="../../../static/images/search.png" mode></image><input class="ipt" type="text" value="{{searchwords}}" placeholder="业主姓名/手机号" placeholder-class="pla-text" data-event-opts="{{[['focus',[['focusbox',['$event']]]],['blur',[['blurbox',['$event']]]],['confirm',[['confirmbox',['$event']]]],['input',[['__set_model',['','searchwords','$event',[]]]]]]}}" bindfocus="__e" bindblur="__e" bindconfirm="__e" bindinput="__e"/></view><block wx:if="{{hidesearch}}"><view data-event-opts="{{[['tap',[['searchbtn',['$event']]]]]}}" class="search-text" bindtap="__e">搜索</view></block></view><scroll-view class="scroll-box" scroll-y="true"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view data-event-opts="{{[['tap',[['godetails',['$0','$1'],[[['listdata','',index,'cashier_id']],[['listdata','',index,'url']]]]]]]}}" class="card" bindtap="__e"><view class="top-box"><view class="left-box"><view class="top-title">{{"收银台订单编号："+item.cashier_id}}</view></view><view class="right-box"><view class="mini-title">¥</view><view class="top-title" style="font-size:36rpx;">{{item.money}}</view></view></view><view class="bottom-box"><block wx:for="{{item.list}}" wx:for-item="items" wx:for-index="indexs"><view class="card-left"><view class="card-text"><text class="left-text">{{items.title}}</text>{{"："+(items.name?items.name:'暂无')}}</view></view></block></view><block wx:if="{{item.order_status==2}}"><view class="billbtn">已退款</view></block></view></block></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="6daad0a7-1" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="6daad0a7-2" keywords="没有更多记录" bind:__l="__l"></lang></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="https://hf.pigcms.com/static/images/house/no_data.png"></image><view class="no_tip_content">暂无搜素结果</view></view></block></scroll-view></view>