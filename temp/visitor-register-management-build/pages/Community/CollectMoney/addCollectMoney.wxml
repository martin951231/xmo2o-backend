<view class="container" style="height:100vh;"><view class="main-box"><view data-event-opts="{{[['tap',[['opens',['$event']]]]]}}" class="list-item" bindtap="__e"><view class="title">物业缴费类型</view><view class="flex-box"><view class="text" style="color:#000000;">{{selecttext}}</view><image class="close-img1" src="../../../static/images/right.png" mode></image></view></view><block wx:if="{{type=='custom'}}"><view class="list-item"><view class="title">缴费名称</view><view class="flex-box"><input class="ipt" type="text" value="{{collectname}}" placeholder="请输入缴费名称" placeholder-class="pla-text" data-event-opts="{{[['input',[['__set_model',['','collectname','$event',[]]]]]]}}" bindinput="__e"/></view></view></block><block wx:if="{{type=='custom'}}"><view class="list-item"><view class="title">缴费总额</view><view class="flex-box"><input class="ipt" type="digit" value="{{custom_price}}" placeholder="请输入缴费总额" placeholder-class="pla-text" data-event-opts="{{[['input',[['__set_model',['','custom_price','$event',[]]]]]]}}" bindinput="__e"/></view></view></block><block wx:if="{{type=='custom_payment'}}"><view class="list-item1"><view class="list-item" style="border-bottom:0rpx solid #F1F1F1;padding:0;"><view class="title">自定义缴费周期</view><view class="flex-box"><input class="ipt" style="width:390rpx;" type="number" value="{{month_num}}" placeholder="请输入缴费内容(最大十周期)" placeholder-class="pla-text" data-event-opts="{{[['input',[['__set_model',['','month_num','$event',[]]],['input_num',['$event']]]]]}}" bindinput="__e"/></view></view><view class="mini-box"><view class="title_1">缴费信息：</view><view class="mini_flex_box"><view class="text_1">{{"计算公式："+infolist.pay_type_html}}</view><block wx:if="{{infolist.pay_type==2}}"><view class="text_1">{{infolist.metering_mode+'：'+infolist.metering_mode_val}}</view></block><view class="text_1">{{"收费金额："+infolist.price}}</view><view class="text_1">{{"收费周期："+infolist.zhouqi_fee}}</view><view class="text_1">{{"服务日期："+infolist.service_time}}</view><view class="text_1">{{"您已缴费的周期个数："+infolist.paid_cycle_html}}</view></view></view><view class="list-item" style="border-bottom:0rpx solid #F1F1F1;padding:0;"><view class="title">缴费总额</view><view class="flex-box"><view class="text" style="color:#000000;">{{all_price}}</view></view></view></view></block><block wx:if="{{type=='property'}}"><view data-event-opts="{{[['tap',[['open',['$event']]]]]}}" class="list-item" bindtap="__e"><view class="title">物业缴费周期</view><view class="flex-box"><view class="text">{{payTime}}</view><image class="close-img1" src="../../../static/images/right.png" mode></image></view></view></block><view class="list-item1"><view class="title">填写备注</view><view class="textarea-back"><textarea class="textarea-box" maxlength="300" value="{{remark}}" placeholder="请填写" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" bindinput="__e"></textarea></view></view></view><view data-event-opts="{{[['tap',[['confirms',['$event']]]]]}}" class="btn" bindtap="__e"><text class="btn-text">保存</text></view><view><uni-popups class="vue-ref" style="width:100%;" vue-id="14e814ae-1" type="bottom" maskClick="{{false}}" data-ref="popups" bind:__l="__l" vue-slots="{{['default']}}"><view class="active-box"><view data-event-opts="{{[['tap',[['closePopup',['$event']]]]]}}" class="cancel-text" bindtap="__e">取消</view><view class="active-title">选择缴费周期</view><view data-event-opts="{{[['tap',[['confirmtext',['$event']]]]]}}" class="detail-icon" bindtap="__e">确定</view></view><view class="popups-list"><scroll-view class="scroll-box" scroll-y="true" scroll-top="0" show-scrollbar="true"><view class="card-box"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{true}}"><view data-event-opts="{{[['tap',[['selectmonth',['$0',index],[[['listdata','',index]]]]]]]}}" class="{{['mini-card',num===index?'active1':'']}}" bindtap="__e"><view class="text-box"><view class="text4">{{''+item.property_month_num+'个月'}}</view><view class="text5">{{"¥"+item.property_fee}}</view></view><block wx:if="{{item.presented_property_month_num!=0}}"><view class="tips">{{'送'+item.presented_property_month_num+'个月'}}</view></block></view></block></block></view></scroll-view></view></uni-popups></view><block wx:if="{{$root.g0!=0}}"><w-picker class="vue-ref" vue-id="14e814ae-2" mode="selector" defaultVal="{{['女']}}" themeColor="#f00" selectList="{{selectList}}" data-ref="selector" data-event-opts="{{[['^confirm',[['onConfirm']]]]}}" bind:confirm="__e" bind:__l="__l"></w-picker></block></view>