<view class="detail-page data-v-e9bec890"><view class="section data-v-e9bec890"><view class="section-title data-v-e9bec890">审批信息</view><view class="info-row data-v-e9bec890"><text class="label data-v-e9bec890">审批编号</text><text class="value data-v-e9bec890">{{info.id||'-'}}</text></view><view class="info-row data-v-e9bec890"><text class="label data-v-e9bec890">状态</text><text class="{{['value','status-text','data-v-e9bec890','status-'+info.status]}}">{{$root.m0}}</text></view><view class="info-row data-v-e9bec890"><text class="label data-v-e9bec890">标题</text><text class="value data-v-e9bec890">{{info.title||'-'}}</text></view><view class="info-row data-v-e9bec890"><text class="label data-v-e9bec890">业务类型</text><text class="value data-v-e9bec890">{{info.business_type_name||info.business_type||'-'}}</text></view><view class="info-row data-v-e9bec890"><text class="label data-v-e9bec890">当前节点</text><text class="value data-v-e9bec890">{{info.current_node_name||'-'}}</text></view><view class="info-row data-v-e9bec890"><text class="label data-v-e9bec890">发起人</text><text class="value data-v-e9bec890">{{info.apply_name||'-'}}</text></view><view class="info-row data-v-e9bec890"><text class="label data-v-e9bec890">发起时间</text><text class="value data-v-e9bec890">{{info.add_time_text||'-'}}</text></view><view class="info-row data-v-e9bec890"><text class="label data-v-e9bec890">申请说明</text><text class="value data-v-e9bec890">{{info.apply_remark||info.apply_reason||'-'}}</text></view></view><view class="section data-v-e9bec890"><view class="section-title data-v-e9bec890">变更内容</view><view class="change-content data-v-e9bec890">{{info.change_content_text||'-'}}</view></view><view class="section data-v-e9bec890"><view class="section-title data-v-e9bec890">审批节点</view><block wx:for="{{nodes}}" wx:for-item="node" wx:for-index="index" wx:key="id"><view class="node data-v-e9bec890"><view class="node-left data-v-e9bec890"><view class="{{['dot','data-v-e9bec890','dot-'+node.status]}}"></view><block wx:if="{{index!==$root.g0-1}}"><view class="line data-v-e9bec890"></view></block></view><view class="node-content data-v-e9bec890"><view class="node-head data-v-e9bec890"><text class="node-name data-v-e9bec890">{{"第 "+node.sort+" 级："+node.node_name}}</text><text class="{{['node-status','data-v-e9bec890','status-'+node.status]}}">{{node.status_text}}</text></view><view class="node-row data-v-e9bec890">{{"审批人："+(node.approver_name||'-')}}</view><block wx:if="{{node.approve_time_text}}"><view class="node-row data-v-e9bec890">{{"审批时间："+node.approve_time_text}}</view></block><block wx:if="{{node.remark}}"><view class="node-row data-v-e9bec890">{{"备注："+node.remark}}</view></block></view></view></block></view><block wx:if="{{info.can_approve}}"><view class="section action-section data-v-e9bec890"><view class="section-title data-v-e9bec890">审批操作</view><view class="action-choice data-v-e9bec890"><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="{{['choice','data-v-e9bec890',(action==='pass')?'active':'']}}" bindtap="__e">通过</view><view data-event-opts="{{[['tap',[['e1',['$event']]]]]}}" class="{{['choice','reject','data-v-e9bec890',(action==='reject')?'active':'']}}" bindtap="__e">驳回</view></view><view class="remark-box data-v-e9bec890"><textarea maxlength="300" placeholder="请输入审批备注" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" value="{{remark}}" bindinput="__e" class="data-v-e9bec890"></textarea></view><view data-event-opts="{{[['tap',[['submitApproval',['$event']]]]]}}" class="submit-btn data-v-e9bec890" bindtap="__e">提交审批</view></view></block></view>