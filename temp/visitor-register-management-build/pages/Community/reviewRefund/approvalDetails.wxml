<view class="approval_details data-v-99ce4dec"><block wx:if="{{$root.g0}}"><view class="bill_details data-v-99ce4dec"><view class="bill_title data-v-99ce4dec">账单详情</view><block wx:for="{{detailList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="bill_list data-v-99ce4dec"><view class="title data-v-99ce4dec">{{item.title}}</view><view class="value data-v-99ce4dec">{{item.content?item.content:'暂无'}}</view></view></block></view></block><view class="bill_details data-v-99ce4dec"><view class="bill_title data-v-99ce4dec">申请详情</view><block wx:for="{{applyList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="bill_list data-v-99ce4dec"><view class="title data-v-99ce4dec">{{item.title}}</view><view class="value data-v-99ce4dec">{{item.content?item.content:'暂无'}}</view></view></block></view><view class="approval_process data-v-99ce4dec"><view class="process_title data-v-99ce4dec">审批流程</view><block wx:for="{{checkLog}}" wx:for-item="item" wx:for-index="index"><view class="u_step_list data-v-99ce4dec" Key="{{index}}"><view class="stet_icon data-v-99ce4dec"><image class="stet_icon_inner data-v-99ce4dec" src="../static/images/node_icon.png" mode></image></view><block wx:if="{{index!=$root.g1-1}}"><view class="stet_line data-v-99ce4dec"></view></block><view class="step_content data-v-99ce4dec"><view class="content_top data-v-99ce4dec"><view class="left_name data-v-99ce4dec"><view class="head_portrait data-v-99ce4dec"><image src="{{item.avatar}}" mode class="data-v-99ce4dec"></image><view class="status_icon data-v-99ce4dec"><block wx:if="{{item.status==0}}"><image src="../static/images/normal_status_icon.png" mode class="data-v-99ce4dec"></image></block><block wx:else><image src="../static/images/active_status_icon.png" mode class="data-v-99ce4dec"></image></block></view></view><view class="name data-v-99ce4dec">{{item.list[0].content?item.list[0].content:'暂无'}}</view></view><view class="right_date data-v-99ce4dec">{{item.list[2].content?item.list[2].content:'暂无'}}</view></view><view class="content_bottom data-v-99ce4dec"><view class="left_desc data-v-99ce4dec">{{"说明："+(item.list[3].content?item.list[3].content:'暂无')}}</view><view class="{{['status_1','data-v-99ce4dec',item.status*1==0?'status_2':item.status*1==1?'status_3':item.status*1==2?'status_4':'']}}">{{''+(item.list[1].content?item.list[1].content:'暂无')}}</view></view></view></view></block></view><block wx:if="{{approvalInfo.status==0}}"><view hidden="{{!(showBottom)}}" class="audit_description data-v-99ce4dec"><view class="description_title data-v-99ce4dec">审批说明</view><view class="description_textarea data-v-99ce4dec"><textarea placeholder="请填写审核说明" data-event-opts="{{[['input',[['__set_model',['','auditDescription','$event',[]]]]]]}}" value="{{auditDescription}}" bindinput="__e" class="data-v-99ce4dec"></textarea></view><view class="bottom_btn data-v-99ce4dec"><view data-event-opts="{{[['tap',[['refuseThis',['$event']]]]]}}" class="pass_no_btn data-v-99ce4dec" bindtap="__e">审核不通过</view><view data-event-opts="{{[['tap',[['passThis',['$event']]]]]}}" class="pass_btn data-v-99ce4dec" bindtap="__e">审核通过</view></view></view></block></view>