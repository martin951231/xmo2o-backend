<view class="container" style="height:100vh;"><view class="main-box"><block wx:if="{{true}}"><view class="list-item"><view class="title">快递名称</view><view class="text">{{listdata.name}}</view></view></block><view data-event-opts="{{[['tap',[['gogarage',['$event']]]]]}}" class="list-item" bindtap="__e"><view class="title">快递单号</view><view class="text">{{listdata.express_no}}</view></view><view data-event-opts="{{[['tap',[['gogarage',['$event']]]]]}}" class="list-item" bindtap="__e"><view class="title">收件人手机号码</view><view class="text">{{listdata.phone}}</view></view><view data-event-opts="{{[['tap',[['gogarage',['$event']]]]]}}" class="list-item" bindtap="__e"><view class="title">快递状态</view><view class="text">{{listdata.status}}</view></view><block wx:if="{{true}}"><view class="list-item"><view class="title">{{status==0?'添加时间':'取件时间'}}</view><view class="text">{{status==0?listdata.add_time:listdata.delivery_time}}</view></view></block><block wx:if="{{true}}"><view class="list-item"><view class="title">备注</view><view class="text">{{listdata.memo}}</view></view></block></view></view>