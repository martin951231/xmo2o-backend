<view class="container" style="height:100vh;"><view class="main-box"><block wx:if="{{true}}"><view class="list-item"><view class="title">访客姓名</view><view class="flex-box"><input class="ipt" type="text" value="{{visitor_name}}" placeholder="请填写访客姓名" placeholder-class="pla-text" data-event-opts="{{[['input',[['__set_model',['','visitor_name','$event',[]]]]]]}}" bindinput="__e"/></view></view></block><block wx:if="{{true}}"><view class="list-item"><view class="title">访客手机</view><view class="flex-box"><input class="ipt" type="number" value="{{visitor_phone}}" placeholder="请填写访客手机" placeholder-class="pla-text" data-event-opts="{{[['input',[['__set_model',['','visitor_phone','$event',[]]]]]]}}" bindinput="__e"/></view></view></block><block wx:if="{{true}}"><view class="list-item"><view class="title">业主手机</view><view class="flex-box"><input class="ipt" type="number" value="{{owner_phone}}" placeholder="请填写业主手机" placeholder-class="pla-text" data-event-opts="{{[['input',[['__set_model',['','owner_phone','$event',[]]],['inputphone',['$event']]]]]}}" bindinput="__e"/></view></view></block><view data-event-opts="{{[['tap',[['gogarage',['$event']]]]]}}" class="list-item" bindtap="__e"><view class="title">业主地址</view><view class="flex-box"><view class="text">{{selecttext}}</view><image class="close-img1" src="../../../static/images/right.png" mode></image></view></view><block wx:if="{{true}}"><view class="myrole"><view class="my-text">访客类型</view><view class="role-box1"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><view data-event-opts="{{[['tap',[['selectattribute',[index,'$0'],[[['listdata','',index,'type']]]]]]]}}" class="{{['chose-btn1',num2===index?'active':'']}}" bindtap="__e">{{''+item.name+''}}</view></block></view></view></block><view class="list-item1"><view class="title">填写备注</view><view class="textarea-back"><textarea class="textarea-box" maxlength="300" value="{{remark}}" placeholder="请填写" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" bindinput="__e"></textarea></view></view></view><view data-event-opts="{{[['tap',[['confirms',['$event']]]]]}}" class="btn" bindtap="__e"><text class="btn-text">保存</text></view></view>