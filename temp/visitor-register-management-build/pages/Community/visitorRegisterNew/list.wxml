<view class="visitor-page data-v-77243f0c"><view class="date-filter data-v-77243f0c"><text class="data-v-77243f0c">登记日期</text><picker mode="date" value="{{selectedDate}}" data-event-opts="{{[['change',[['dateChanged',['$event']]]]]}}" bindchange="__e" class="data-v-77243f0c"><view class="date-value data-v-77243f0c">{{selectedDate||'选择日期'}}</view></picker><text data-event-opts="{{[['tap',[['clearDate',['$event']]]]]}}" class="date-clear data-v-77243f0c" bindtap="__e">全部</text></view><block wx:for="{{records}}" wx:for-item="item" wx:for-index="__i0__" wx:key="registration_no"><view data-event-opts="{{[['tap',[['goDetail',['$0'],[[['records','registration_no',item.registration_no]]]]]]]}}" class="record-card data-v-77243f0c" bindtap="__e"><view class="record-row data-v-77243f0c"><text class="label data-v-77243f0c">访客姓名</text><text class="value nickname data-v-77243f0c">{{item.nickname}}</text></view><view class="record-row data-v-77243f0c"><text class="label data-v-77243f0c">手机号</text><text class="value data-v-77243f0c">{{item.phone}}</text></view><view class="record-row data-v-77243f0c"><text class="label data-v-77243f0c">登记时间</text><text class="value data-v-77243f0c">{{item.registration_time}}</text></view></view></block><block wx:if="{{error}}"><view class="state data-v-77243f0c"><view class="data-v-77243f0c">{{error}}</view><button class="retry data-v-77243f0c" size="mini" data-event-opts="{{[['tap',[['fetchRecords',[$root.g0===0]]]]]}}" bindtap="__e">重新加载</button></view></block><block wx:else><block wx:if="{{$root.g1}}"><view class="state data-v-77243f0c"><image class="empty-image data-v-77243f0c" src="/static/images/no_data.png" mode="widthFix"></image><view class="data-v-77243f0c">暂无访客登记记录</view></view></block></block><block wx:if="{{loading}}"><view class="state data-v-77243f0c">加载中…</view></block><block wx:else><block wx:if="{{$root.g2}}"><view class="state data-v-77243f0c">没有更多了</view></block></block></view>