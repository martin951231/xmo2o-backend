page{background:#f5f5f5}.container{margin:0;padding:0}.card{background:#fff;margin:30rpx 30rpx 0rpx 30rpx;padding:0rpx 20rpx 20rpx 20rpx;border-radius:20rpx}.top-box{display:flex;flex-direction:row;align-items:center;border-bottom:1rpx solid #f1f1f1;margin-bottom:10rpx}.head-img{width:46rpx;height:46rpx;display:flex;margin-right:15rpx}.top-title{font-size:30rpx;font-weight:700;line-height:90rpx;display:flex;flex-direction:row;align-items:center}.mini-flex{display:flex;flex-direction:row;justify-content:space-between;align-items:center}.text_over{font-size:26rpx;font-family:PingFang SC;font-weight:500;color:#828282;display:flex;flex-wrap:nowrap;max-width:80%;overflow:scroll}.item{flex-shrink:0;margin-left:3rpx}.item::after{content:","}.item:nth-last-child(1)::after{content:""}.text{font-size:28rpx;color:#828282;line-height:60rpx}.btn-box{display:flex;flex-direction:row;justify-content:space-between;margin:100rpx 30rpx 80rpx 30rpx}.btn{background:#157ff6;width:325rpx;box-shadow:0rpx 0rpx 17rpx 1rpx hsla(0,0%,84.7%,.68);border-radius:50rpx;font-size:30rpx;line-height:90rpx;text-align:center;color:#fff}.independent_payment{position:fixed;bottom:165rpx;right:24rpx;width:102rpx;height:102rpx;border-radius:102rpx}.independent-img{width:100%;height:100%;border-radius:102rpx}uni-button:after{border:0rpx}