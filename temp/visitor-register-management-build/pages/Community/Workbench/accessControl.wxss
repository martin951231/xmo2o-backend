page{background:#f5f5f5}.container{margin:0;padding:0}.head_tip{padding:0rpx 30rpx;display:flex;flex-direction:row;align-items:center;background-image:linear-gradient(-90deg,#4e54c8,#5a7fde 0,#65aaf4 0,#99c8f8 0,#cde5fc 0,#e6f1ff)}.laba{width:35rpx;height:35rpx;display:block}.tip-text{font-size:22rpx;font-weight:400;font-stretch:normal;line-height:70rpx;letter-spacing:0rpx;color:#1a2738;margin-left:15rpx}.scroll-box{height:100vh}.card{margin:30rpx;padding:30rpx;background-color:#fff;border-radius:20rpx;display:flex;justify-content:space-between;align-items:center}.card-left{display:flex;flex-direction:row;align-items:center}.user-img{width:82rpx;height:82rpx;display:block}.right-box{display:flex;flex-direction:column;justify-content:space-between;margin-left:15rpx}.card-right{display:flex;flex-direction:row;align-items:center}.nopass{width:80rpx;height:80rpx;box-shadow:0 2px 10px 0 rgba(255,115,91,.19);border-radius:80rpx;margin-right:30rpx}.pass{width:80rpx;height:80rpx;box-shadow:0 2px 10px 0 rgba(70,148,255,.19);border-radius:80rpx}.info-box{display:flex;flex-direction:row;justify-content:space-between}.name{font-size:28rpx;font-weight:700;font-stretch:normal;line-height:45rpx;letter-spacing:0rpx;color:#333}.address{margin-top:8rpx;font-size:24rpx;font-weight:400;font-stretch:normal;line-height:1.5;letter-spacing:0rpx;color:#666}.independent_payment{position:fixed;bottom:165rpx;right:24rpx;width:102rpx;height:102rpx;border-radius:102rpx}.independent-img{width:100%;height:100%;border-radius:102rpx}.tip_box_no_data{padding-top:calc((100vh - 80rpx - 288rpx - 300rpx)/2);font-size:28rpx;text-align:center}.no_data_img{width:374rpx;height:288rpx}