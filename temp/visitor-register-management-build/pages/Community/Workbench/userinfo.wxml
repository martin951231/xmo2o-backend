<view class="container"><view class="card"><view class="top-box"><image class="head-img" src="../static/images/user_head.png" mode></image><view class="top-title">基本信息</view></view><view class="mini-flex"><view class="text">姓名</view><block wx:if="{{now_bind_info.name==''}}"><view class="text">无</view></block><block wx:if="{{now_bind_info.name!=''}}"><view class="text">{{now_bind_info.name}}</view></block></view><view class="mini-flex"><view class="text">手机号</view><block wx:if="{{now_bind_info.phone==''}}"><view class="text">无</view></block><block wx:if="{{now_bind_info.phone!=''}}"><view class="text">{{now_bind_info.phone}}</view></block></view><view class="mini-flex"><view class="text">身份证卡号</view><block wx:if="{{now_bind_info.id_card==''}}"><view class="text">无</view></block><block wx:if="{{now_bind_info.id_card!=''}}"><view class="text">{{now_bind_info.id_card}}</view></block></view><view class="mini-flex"><view class="text">IC卡号</view><block wx:if="{{now_bind_info.ic_card==''}}"><view class="text">无</view></block><block wx:if="{{now_bind_info.ic_card!=''}}"><view class="text">{{now_bind_info.ic_card}}</view></block></view><view class="mini-flex"><view class="text">车位信息</view><block wx:if="{{$root.g0=='[]'}}"><view class="text">无</view></block><block wx:if="{{$root.g1!='[]'}}"><view class="text_over"><block wx:for="{{now_bind_info.position_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="item">{{item.garage_num+item.position_num}}</view></block></view></block></view><view class="mini-flex"><view class="text">车辆信息</view><block wx:if="{{$root.g2=='[]'}}"><view class="text">无</view></block><block wx:if="{{$root.g3!='[]'}}"><view class="text_over"><block wx:for="{{now_bind_info.car_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="item">{{item.garage_num+item.car_number}}</view></block></view></block></view></view><block wx:if="{{no_data}}"><view class="card"><view class="top-box"><image class="head-img" src="../static/images/user_head.png" mode></image><view class="top-title">业主资料</view></view><block wx:for="{{dataList}}" wx:for-item="items" wx:for-index="indexs"><view class="mini-flex"><view class="text">{{items.title}}</view><block wx:if="{{items.value==''}}"><view class="text">无</view></block><block wx:if="{{items.value!=''}}"><view class="text">{{items.value}}</view></block></view></block></view></block><view class="btn-box"><block wx:if="{{is_del}}"><view data-event-opts="{{[['tap',[['goinspection',['$event']]]]]}}" class="btn" style="{{(is_edit?'':'background-color: #a0a5ba;width:100%')}}" bindtap="__e">删除</view></block><block wx:if="{{is_edit}}"><view data-event-opts="{{[['tap',[['gofailure',['$0'],['now_bind_info.room_id']]]]]}}" class="btn" style="{{(is_del?'':'width:100%')}}" bindtap="__e">编辑</view></block></view><block wx:if="{{manage_resident_faces_switch}}"><view data-event-opts="{{[['tap',[['goindependent',['$event']]]]]}}" class="independent_payment" bindtap="__e"><image class="independent-img" src="../static/images/add_fece.png"></image></view></block></view>