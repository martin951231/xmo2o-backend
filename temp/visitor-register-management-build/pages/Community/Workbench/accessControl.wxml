<view class="container" style="height:100vh;"><scroll-view class="scroll-box" scroll-y="true"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view class="card"><view class="card-left"><image class="user-img" src="../static/images/door_key.png" mode></image><view class="right-box"><view class="info-box"><view class="name">{{item.door_name}}</view></view><view class="address">{{"位置："+item.address_name}}</view></view></view><view class="card-right"><image class="nopass" src="../static/images/door_edit.png" mode data-event-opts="{{[['tap',[['goedit',['$0','$1'],[[['listdata','',index,'door_name']],[['listdata','',index,'door_id']]]]]]]}}" bindtap="__e"></image><image class="pass" src="../static/images/door_delect.png" mode data-event-opts="{{[['tap',[['godelect',['$0'],[[['listdata','',index,'door_id']]]]]]]}}" bindtap="__e"></image></view></view></block></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="../../../static/images/no_data.png"></image><view class="no_tip_content">暂无搜素结果</view></view></block></scroll-view><view data-event-opts="{{[['tap',[['goindependent',['$event']]]]]}}" class="independent_payment" bindtap="__e"><image class="independent-img" src="../static/images/add_door.png"></image></view></view>