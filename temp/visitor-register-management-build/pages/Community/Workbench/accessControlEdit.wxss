page{background:#f5f5f5}.container{margin:0;padding:0}.head_tip{padding:0rpx 30rpx;display:flex;flex-direction:row;align-items:center;background-image:linear-gradient(-90deg,#4e54c8,#5a7fde 0,#65aaf4 0,#99c8f8 0,#cde5fc 0,#e6f1ff)}.laba{width:35rpx;height:35rpx;display:block}.tip-text{font-size:22rpx;font-weight:400;font-stretch:normal;line-height:70rpx;letter-spacing:0rpx;color:#1a2738;margin-left:15rpx}.scroll-box{height:calc(100vh - 100rpx - 140rpx)}.card{margin:30rpx;padding:30rpx;background-color:#fff;border-radius:15rpx;display:flex;justify-content:space-between;align-items:center}.card-left{display:flex;flex-direction:row;align-items:center}.user-img{width:100rpx;height:100rpx;display:block}.right-box{display:flex;flex-direction:column;justify-content:space-between;margin-left:15rpx}.card-right{display:flex;flex-direction:row;align-items:center}.nopass{font-size:24rpx;font-weight:400;font-stretch:normal;line-height:60rpx;letter-spacing:0rpx;color:#acacac;margin-right:10rpx}.pass{width:30rpx;height:30rpx;display:block}.name{font-size:32rpx;font-weight:700;font-stretch:normal;line-height:45rpx;letter-spacing:0rpx;color:#333}.tips{background-color:#2681f3;border-radius:8rpx;font-size:20rpx;font-weight:400;font-stretch:normal;line-height:45rpx;letter-spacing:0rpx;color:#fff;padding:2rpx 10rpx;margin-left:15rpx}.right-img{width:35rpx;height:35rpx;display:inline-block;flex-shrink:0}.tip_box_no_data{padding-top:calc((100vh - 80rpx - 288rpx - 300rpx)/2);font-size:28rpx;text-align:center}.no_data_img{width:374rpx;height:288rpx}