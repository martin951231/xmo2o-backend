<view class="container" style="height:100vh;"><view class="head-box"><view class="search-box"><image class="search-img" src="../../../static/images/search.png" mode></image><input class="ipt" type="text" value="{{searchwords}}" placeholder="姓名/手机号" placeholder-class="pla-text" data-event-opts="{{[['focus',[['focusbox',['$event']]]],['blur',[['blurbox',['$event']]]],['confirm',[['confirmbox',['$event']]]],['input',[['__set_model',['','searchwords','$event',[]]]]]]}}" bindfocus="__e" bindblur="__e" bindconfirm="__e" bindinput="__e"/></view><block wx:if="{{hidesearch}}"><view data-event-opts="{{[['tap',[['searchbtn',['$event']]]]]}}" class="search-text" bindtap="__e">搜索</view></block></view><scroll-view class="scroll-box" scroll-y="true"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view data-event-opts="{{[['tap',[['godetails',['$0'],[[['listdata','',index,'pigcms_id']]]]]]]}}" class="card" bindtap="__e"><view class="card-left"><image class="user-img" src="{{item.avatar}}" mode></image><view class="right-box"><view class="info-box"><view class="name">{{item.name}}<text class="tips" style="{{('background-color: '+item.tag_color.backgroundColor+';'+'color:'+item.tag_color.color)}}">{{item.identity_tag}}</text><block wx:if="{{item.status==0}}"><text class="text">业主</text></block></view></view><view class="address">{{"手机号:"+item.phone}}</view></view></view><image class="right-img" src="../../../static/images/right.png" mode></image></view></block></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="../../../static/images/no_data.png"></image><view class="no_tip_content">暂无成员</view></view></block></scroll-view><view data-event-opts="{{[['tap',[['goindependent',['$event']]]]]}}" class="independent_payment" bindtap="__e"><image class="independent-img" src="../static/images/add_user.png"></image></view></view>