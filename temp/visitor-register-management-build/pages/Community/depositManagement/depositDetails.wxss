page{background:#f5f5f5}.container{margin:0;padding:0}.head-box{padding:30rpx 40rpx;background-color:#2681f3}.top-box{display:flex;flex-direction:row;justify-content:space-between;align-items:center}.right-box{display:flex;flex-direction:row;align-items:center}.nopass{width:80rpx;height:80rpx;box-shadow:0 2px 10px 0 rgba(255,115,91,.19);border-radius:80rpx;margin-right:30rpx}.pass{width:80rpx;height:80rpx;box-shadow:0 2px 10px 0 rgba(70,148,255,.19);border-radius:80rpx}.head-img{width:82rpx;height:82rpx;display:flex;margin-right:15rpx;border-radius:82rpx}.top-title{font-size:40rpx;font-weight:700;line-height:90rpx;display:flex;flex-direction:row;color:#fff}.info-box{display:flex;flex-direction:row;justify-content:space-between}.tips{display:inline-block;font-size:20rpx}.center-box{display:flex;flex-direction:row;justify-content:space-between;align-items:center}.mini-flex{display:flex;flex-direction:column}.text{font-size:24rpx;color:#fff;line-height:55rpx}.btn-flex{display:flex;flex-direction:row;justify-content:flex-end;align-items:center}.btn1{width:90rpx;height:60rpx;padding:0rpx 45.2rpx;font-size:28rpx;line-height:60rpx;border-radius:30rpx;color:#fff;text-align-last:justify}.btn2{width:90rpx;height:60rpx;padding:0rpx 45.2rpx;font-size:28rpx;line-height:60rpx;border-radius:30rpx;background-color:hsla(0,0%,100%,.3);color:#fff;text-align-last:justify;margin-left:20rpx}.scroll-box{height:calc(100vh - 140rpx)}.card{margin:30rpx;padding:15rpx 40rpx;background-color:#fff;border-radius:20rpx;display:flex;justify-content:space-between;align-items:center}.card-list{width:100%;border-bottom:2rpx solid #f1f1f1}.card-list:last-of-type{border-bottom:0rpx solid #f1f1f1}.card-left{width:100%;display:flex;flex-direction:row;justify-content:space-between;align-items:center;overflow-wrap:anywhere}.right-img{width:35rpx;height:35rpx;display:inline-block;flex-shrink:0}.card-text{line-height:70rpx;text-overflow:ellipsis;font-size:26rpx}.left-text{display:inline-block;height:100%;min-width:120rpx;text-align:justify;text-align-last:justify;line-height:50rpx}.tip_box_no_data{padding-top:calc((100vh - 80rpx - 288rpx - 300rpx)/2);font-size:28rpx;text-align:center}.no_data_img{width:374rpx;height:288rpx}