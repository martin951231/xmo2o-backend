<view class="container" style="height:100vh;"><view class="main-box"><view data-event-opts="{{[['tap',[['selectroom',['$event']]]]]}}" class="list-item" bindtap="__e"><view class="title">{{''+(publicData.config&&publicData.config.room_name?publicData.config.room_name:'房间')+"名"}}</view><view class="flex-box"><view class="text">{{address}}</view><image class="close-img1" src="../../../static/images/right.png" mode></image></view></view><view data-event-opts="{{[['tap',[['opens',['$event']]]]]}}" class="list-item" bindtap="__e"><view class="title">业主</view><view class="flex-box"><view class="text">{{name}}</view><image class="close-img1" src="../../../static/images/right.png" mode></image></view></view><view data-event-opts="{{[['tap',[['openPay',['$event']]]]]}}" class="list-item" bindtap="__e"><view class="title">支付方式</view><view class="flex-box"><view class="text">{{paytext}}</view><image class="close-img1" src="../../../static/images/right.png" mode></image></view></view><view class="list-item"><view class="title">收费项目</view><view class="flex-box"><input class="ipt" type="text" value="{{deposit_name}}" placeholder="请输入收费项目" placeholder-class="pla-text" data-event-opts="{{[['input',[['__set_model',['','deposit_name','$event',[]]]]]]}}" bindinput="__e"/></view></view><view class="list-item"><view class="title">应收金额</view><view class="flex-box"><input class="ipt" type="digit" value="{{payment_money}}" placeholder="请输入应收金额" placeholder-class="pla-text" data-event-opts="{{[['input',[['__set_model',['','payment_money','$event',[]]]]]]}}" bindinput="__e"/></view></view><view class="list-item"><view class="title">实收金额</view><view class="flex-box"><input class="ipt" type="digit" value="{{actual_money}}" placeholder="请输入实收金额" placeholder-class="pla-text" data-event-opts="{{[['input',[['__set_model',['','actual_money','$event',[]]]]]]}}" bindinput="__e"/></view></view><view class="list-item1"><view class="title">填写备注</view><view class="textarea-back"><textarea class="textarea-box" maxlength="300" value="{{remark}}" placeholder="请填写" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" bindinput="__e"></textarea></view></view></view><view data-event-opts="{{[['tap',[['confirms',['$event']]]]]}}" class="btn" bindtap="__e"><text class="btn-text">保存</text></view><view><uni-popups class="vue-ref" style="width:100%;" vue-id="a5e9a300-1" type="bottom" maskClick="{{false}}" data-ref="popupr" bind:__l="__l" vue-slots="{{['default']}}"><view class="active-box"><view data-event-opts="{{[['tap',[['closePopup',['$event']]]]]}}" class="cancel-text" bindtap="__e">取消</view><view class="active-title">支付方式</view><view data-event-opts="{{[['tap',[['confirmtext',['$event']]]]]}}" class="detail-icon" bindtap="__e">确定</view></view><view class="popups-list"><scroll-view class="scroll-box" scroll-y="true" scroll-top="0" show-scrollbar="true"><block wx:for="{{payTypeList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selectPay',['$0',index,'$1'],[[['payTypeList','',index,'name']],[['payTypeList','',index,'id']]]]]]]}}" class="{{['list-box',num1===index?'active':'']}}" bindtap="__e"><view class="text1"></view><view class="text2">{{item.name}}</view></view></block></scroll-view></view></uni-popups></view></view>