<view class="container" style="height:100vh;"><view class="head-box"><view class="search-box"><image class="search-img" src="../../../static/images/search.png" mode></image><input class="ipt" type="text" value="{{searchwords}}" placeholder="业主姓名/手机号" placeholder-class="pla-text" data-event-opts="{{[['focus',[['focusbox',['$event']]]],['blur',[['blurbox',['$event']]]],['confirm',[['confirmbox',['$event']]]],['input',[['__set_model',['','searchwords','$event',[]]]]]]}}" bindfocus="__e" bindblur="__e" bindconfirm="__e" bindinput="__e"/></view><block wx:if="{{hidesearch}}"><view data-event-opts="{{[['tap',[['searchbtn',['$event']]]]]}}" class="search-text" bindtap="__e">搜索</view></block></view><block wx:if="{{hidetip}}"><view class="head_tip"><image class="laba" src="../../../static/images/laba.png" mode></image><text class="tip-text">可搜索房主姓名/手机号码</text></view></block><scroll-view class="scroll-box" scroll-y="true"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{listdata[0]&&!no_data}}"><view data-event-opts="{{[['tap',[['godetails',['$0'],[[['listdata','',index]]]]]]]}}" class="card" bindtap="__e"><view class="card-left"><view class="card-text"><text class="left-text">姓名</text>{{"："+item.name}}</view><view class="card-text"><text class="left-text">电话</text>{{"："+item.phone}}</view><view class="card-text"><text class="left-text">地址</text>{{"："+item.address}}</view></view></view></block></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="1564d782-1" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="1564d782-2" keywords="没有更多记录" bind:__l="__l"></lang></view></block><block wx:if="{{!listdata[0]&&no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="../../../static/images/no_data.png"></image><view class="no_tip_content">暂无搜素结果</view></view></block></scroll-view></view>