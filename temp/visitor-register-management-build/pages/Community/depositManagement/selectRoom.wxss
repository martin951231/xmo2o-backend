page{background:#f5f5f5}.container{margin:0;padding:0}.head-box{padding:30rpx;display:flex;flex-direction:row;align-items:center;background-color:#2681f3}.search-box{display:flex;flex-direction:row;align-items:center;padding:20rpx 40rpx;background-color:#fff;border-radius:60rpx;width:100%}.search-img{width:35rpx;height:35rpx;display:block}.ipt{margin-left:30rpx;width:400rpx}.pla-text{font-size:28rpx;color:#5a5a5a}.search-text{flex-shrink:0;margin-left:30rpx;color:#fff}.head_tip{padding:0rpx 30rpx;display:flex;flex-direction:row;align-items:center;background-image:linear-gradient(-90deg,#4e54c8,#5a7fde 0,#65aaf4 0,#99c8f8 0,#cde5fc 0,#e6f1ff)}.laba{width:35rpx;height:35rpx;display:block}.tip-text{font-size:22rpx;font-weight:400;font-stretch:normal;line-height:70rpx;letter-spacing:0rpx;color:#1a2738;margin-left:15rpx}.scroll-box{height:calc(100vh - 140rpx)}.card{margin:30rpx;padding:30rpx;background-color:#fff;border-radius:20rpx;display:flex;justify-content:space-between;align-items:center}.right-img{width:35rpx;height:35rpx;display:inline-block;flex-shrink:0}.card-text{text-overflow:ellipsis;font-size:26rpx}.left-text{display:inline-block;height:100%;min-width:120rpx;text-align:justify;text-align-last:justify;line-height:50rpx}.tip_box_no_data{padding-top:calc((100vh - 80rpx - 288rpx - 300rpx)/2);font-size:28rpx;text-align:center}.no_data_img{width:374rpx;height:288rpx}