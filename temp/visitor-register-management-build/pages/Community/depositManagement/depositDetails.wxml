<view class="container" style="height:100vh;"><view class="head-box"><view class="top-box"><view class="top-title">{{''+(listdata.name!=''?listdata.name:'暂无')+''}}</view><view class="left-box"><block wx:if="{{true}}"><view class="info-box"><view class="top-title"><text class="tips">¥</text>{{listdata.deposit_balance}}</view></view></block><view class="top-title"></view></view></view><view class="center-box"><view class="mini-flex"><view class="text">{{listdata.address}}</view><view class="text">{{listdata.is_refund==1?listdata.pay_time:listdata.refund_time}}</view></view><view class="btn-flex"><block wx:if="{{listdata.is_refund==1}}"><view class="btn2">未退款</view></block><block wx:else><view class="btn2">已退款</view></block></view></view></view><scroll-view class="scroll-box" scroll-y="true"><block wx:if="{{true}}"><view class="card"><view class="card-list"><view class="card-left"><view class="card-text">应收金额：</view><view class="card-text">{{listdata.payment_money!=''?listdata.payment_money:'暂无'}}</view></view><view class="card-left"><view class="card-text">实缴金额：</view><view class="card-text">{{listdata.actual_money!=''?listdata.actual_money:'暂无'}}</view></view><view class="card-left"><view class="card-text">押金金额：</view><view class="card-text">{{listdata.deposit_balance!=''?listdata.deposit_balance:'暂无'}}</view></view><block wx:if="{{listdata.is_refund==2}}"><view class="card-left"><view class="card-text">退款金额：</view><view class="card-text">{{listdata.refund_money!=''?listdata.refund_money:'暂无'}}</view></view></block><view class="card-left"><view class="card-text">付款方式：</view><view class="card-text">{{listdata.name!=''?listdata.name:'暂无'}}</view></view><view class="card-left"><view class="card-text">押金类型：</view><view class="card-text">{{listdata.deposit_name!=''?listdata.deposit_name:'暂无'}}</view></view><view class="card-left"><view class="card-text">收费员：</view><view class="card-text">{{listdata.toll_collector!=''?listdata.toll_collector:'暂无'}}</view></view><block wx:if="{{listdata.is_refund==2}}"><view class="card-left"><view class="card-text">退款日期：</view><view class="card-text">{{listdata.refund_time!=''?listdata.refund_time:'暂无'}}</view></view></block></view></view></block><view class="card"><view class="card-list"><view class="card-left"><view class="card-text" style="flex-shrink:0;">备注：</view><block wx:if="{{listdata.is_refund==2}}"><view class="card-text">{{listdata.refund_note!=''?listdata.refund_note:'暂无'}}</view></block><block wx:else><view class="card-text">{{listdata.deposit_note!=''?listdata.deposit_note:'暂无'}}</view></block></view></view></view><block wx:if="{{false}}"><view class="tip_box_no_data"><image class="no_data_img" src="../../../static/images/no_data.png"></image><view class="no_tip_content">暂无搜素结果</view></view></block></scroll-view></view>