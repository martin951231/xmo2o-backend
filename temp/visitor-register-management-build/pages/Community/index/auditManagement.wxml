<view class="container"><scroll-view class="nav-bar" id="nav-bar" scroll-x="{{true}}" scroll-with-animation="{{true}}" scroll-left="{{scrollLeft}}"><block wx:for="{{tabBars}}" wx:for-item="item" wx:for-index="index"><view class="{{['nav-item',(index===tabCurrentIndex)?'current':'']}}" id="{{'tab'+index}}" data-index="{{index}}" data-event-opts="{{[['tap',[['changeTabs',['$event',index,'$0'],[[['tabBars','',index,'type']]]]]]]}}" bindtap="__e">{{item.title}}</view></block></scroll-view><swiper class="paid_swiper" id="swiper" duration="{{300}}" current="{{tabCurrentIndex}}" data-event-opts="{{[['change',[['changeTab',['$event']]]]]}}" bindchange="__e"><block wx:for="{{tabBars}}" wx:for-item="item" wx:for-index="index"><swiper-item><scroll-view class="panel-scroll-box" scroll-y="{{enableScroll}}"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view class="card"><view class="top-box"><view class="left-box"><image class="head-img" src="{{item.avatar}}" mode></image><block wx:if="{{item.name||item.identity_tag}}"><view class="info-box"><view class="top-title">{{item.name}}<text class="tips" style="{{('backgroundColor:'+item.backgroundColor+';'+'color'+item.color)}}">{{item.identity_tag}}</text></view></view></block><view class="top-title"></view></view><view class="right-box"><image class="nopass" src="../static/images/nopass.png" mode data-event-opts="{{[['tap',[['nopass',['$0','$1','$2'],[[['listdata','',index,'pigcms_id']],[['listdata','',index,'itemid']],[['listdata','',index,'bind_id']]]]]]]}}" bindtap="__e"></image><image class="pass" src="../static/images/pass.png" mode data-event-opts="{{[['tap',[['pass',['$0','$1','$2'],[[['listdata','',index,'pigcms_id']],[['listdata','',index,'itemid']],[['listdata','',index,'bind_id']]]]]]]}}" bindtap="__e"></image></view></view><block wx:for="{{item.content}}" wx:for-item="items" wx:for-index="indexs"><view data-event-opts="{{[['tap',[['gouserinfo',['$0','$1','$2'],[[['listdata','',index,'itemid']],[['listdata','',index,'pigcms_id']],[['listdata','',index,'bind_id']]]]]]]}}" class="mini-flex" bindtap="__e"><view class="text">{{items.title+":"}}</view><view class="text">{{items.info}}</view></view></block></view></block></block><block wx:if="{{pageLoading==true}}"><view class="tip"><lang vue-id="{{'6d2e7cb4-1-'+index}}" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="../../../static/images/no_data.png"></image><view class="no_tip_content">暂无待审核数据</view></view></block></scroll-view></swiper-item></block></swiper><view><uni-popups class="vue-ref" vue-id="6d2e7cb4-2" type="center" maskClick="{{false}}" data-ref="popups" bind:__l="__l" vue-slots="{{['default']}}"><textarea class="area" value="{{unbindtext}}" placeholder-style="text5" placeholder="请输入不通过的原因" data-event-opts="{{[['input',[['__set_model',['','unbindtext','$event',[]]]]]]}}" bindinput="__e"></textarea><view class="btn-box1"><button class="btn1" type="primary" data-event-opts="{{[['tap',[['closePopup',['$event']]]]]}}" bindtap="__e">关闭</button><button class="btn2" type="primary" data-event-opts="{{[['tap',[['applyUnbinds',['$event']]]]]}}" bindtap="__e">提交</button></view></uni-popups></view></view>