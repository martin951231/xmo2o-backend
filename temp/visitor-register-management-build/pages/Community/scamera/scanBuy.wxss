page{height:100%;position:relative}.content{position:fixed;top:0;left:0;right:0;bottom:182rpx}.bg{width:100%;height:calc(100vw * 1814 / 750);position:fixed;bottom:182rpx}.wrapper{position:fixed;top:0;left:0;right:0;bottom:0;z-index:3}.tap{width:100%;color:#fff;font-size:20px;display:flex;justify-content:center;position:absolute;top:0;left:0;right:0;z-index:3}.tap .tap-item{width:100%;text-align:center;margin:0 30px;margin-top:17px}.tip{color:#fff;font-size:12px;text-align:center;position:absolute;top:45px;left:0;right:0;z-index:3}.footer{position:fixed;left:0;bottom:0;right:0;display:flex;flex-direction:row;justify-content:space-around;align-items:center;color:#fff;font-size:28rpx;padding:36rpx 0;background:#000;z-index:3}.footer .item{text-align:center;flex:1;align-items:center}.footer cover-image{display:inline-block}.footer .shopcart cover-image{width:110rpx;height:110rpx}.footer .order cover-image{width:60rpx;height:50rpx}.setting{position:absolute;top:50%;left:50%;-webkit-transform:translate(-50%,-50%);transform:translate(-50%,-50%);background:#ccc;padding:5px 10px}