<view class="container" style="height:100vh;"><view class="head-box"><view class="search-box"><image class="search-img" src="../../../static/images/search.png" mode></image><input class="ipt" type="text" value="{{searchwords}}" placeholder="输入车辆名称" placeholder-class="pla-text" data-event-opts="{{[['focus',[['focusbox',['$event']]]],['blur',[['blurbox',['$event']]]],['confirm',[['confirmbox',['$event']]]],['input',[['__set_model',['','searchwords','$event',[]]]]]]}}" bindfocus="__e" bindblur="__e" bindconfirm="__e" bindinput="__e"/></view><block wx:if="{{hidesearch}}"><view data-event-opts="{{[['tap',[['searchbtn',['$event']]]]]}}" class="search-text" bindtap="__e">搜索</view></block></view><scroll-view class="scroll-box" scroll-y="true"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view class="card"><view data-event-opts="{{[['tap',[['godetails',['$0'],[[['listdata','',index,'car_id']]]]]]]}}" class="card-left" bindtap="__e"><view class="right-box"><view class="info-box"><view class="name">{{item.car_number}}<text class="card-text"></text></view></view><view class="address">{{"业主姓名："+item.car_user_name}}</view><view class="address">{{"业主电话："+item.car_user_phone}}</view><view class="address">{{"停车卡号："+item.car_stop_num}}</view><view class="address">{{"停车到期时间："+item.end_time}}</view></view></view><view class="card-right"><block wx:if="{{roleOptPermissionInfo.role_edit_car==1}}"><image class="nopass" src="../static/images/door_edit.png" mode data-event-opts="{{[['tap',[['goedit',['$0'],[[['listdata','',index,'car_id']]]]]]]}}" bindtap="__e"></image></block><block wx:if="{{roleOptPermissionInfo.role_del_car==1}}"><image class="pass" src="../static/images/door_delect.png" mode data-event-opts="{{[['tap',[['godelect',['$0'],[[['listdata','',index,'car_id']]]]]]]}}" bindtap="__e"></image></block></view></view></block></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="2b53c13e-1" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="2b53c13e-2" keywords="没有更多记录" bind:__l="__l"></lang></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="../../../static/images/no_data.png"></image><view class="no_tip_content">暂无搜素结果</view></view></block></scroll-view><block wx:if="{{roleOptPermissionInfo.role_add_car==1}}"><view data-event-opts="{{[['tap',[['goindependent',['$event']]]]]}}" class="independent_payment" bindtap="__e"><image class="independent-img" src="../static/images/add_user.png"></image></view></block></view>