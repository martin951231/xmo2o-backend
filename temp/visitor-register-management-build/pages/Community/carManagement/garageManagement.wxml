<view class="container" style="height:100vh;"><view class="head-box"><view class="search-box"><image class="search-img" src="../../../static/images/search.png" mode></image><input class="ipt" type="text" value="{{searchwords}}" placeholder="输入车库名称" placeholder-class="pla-text" data-event-opts="{{[['focus',[['focusbox',['$event']]]],['blur',[['blurbox',['$event']]]],['confirm',[['confirmbox',['$event']]]],['input',[['__set_model',['','searchwords','$event',[]]]]]]}}" bindfocus="__e" bindblur="__e" bindconfirm="__e" bindinput="__e"/></view><block wx:if="{{hidesearch}}"><view data-event-opts="{{[['tap',[['searchbtn',['$event']]]]]}}" class="search-text" bindtap="__e">搜索</view></block></view><scroll-view class="scroll-box" scroll-y="true"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view class="card"><view data-event-opts="{{[['tap',[['godetails',['$0'],[[['listdata','',index,'garage_id']]]]]]]}}" class="card-left" bindtap="__e"><view class="right-box"><view class="info-box"><view class="name">{{item.garage_num}}<text class="card-text"></text></view></view><view class="address">{{"地址："+(item.garage_position?item.garage_position:'暂无')}}</view><view class="address">{{"备注："+(item.garage_remark?item.garage_remark:'暂无')}}</view></view></view><view class="card-right"><image class="nopass" src="../static/images/door_edit.png" mode data-event-opts="{{[['tap',[['goedit',['$0'],[[['listdata','',index,'garage_id']]]]]]]}}" bindtap="__e"></image><image class="pass" src="../static/images/door_delect.png" mode data-event-opts="{{[['tap',[['godelect',['$0'],[[['listdata','',index,'garage_id']]]]]]]}}" bindtap="__e"></image></view></view></block></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="75d04e05-1" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="75d04e05-2" keywords="没有更多记录" bind:__l="__l"></lang></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="../../../static/images/no_data.png"></image><view class="no_tip_content">暂无搜素结果</view></view></block></scroll-view><view data-event-opts="{{[['tap',[['goindependent',['$event']]]]]}}" class="independent_payment" bindtap="__e"><image class="independent-img" src="../static/images/add_user.png"></image></view></view>