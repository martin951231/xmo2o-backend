<view class="container"><view class="top-icon"><image class="top-img" src="{{listdata.image_path}}" mode></image></view><block wx:for="{{numlist}}" wx:for-item="item" wx:for-index="index"><view class="card"><view class="top-box"><view class="top-title">{{''+item.field_name+''}}</view></view><block wx:for="{{item.field_cate_test}}" wx:for-item="items" wx:for-index="indexs"><view><block wx:if="{{items.type==1}}"><view><view class="text">{{items.title+"："+items.value_test}}</view></view></block><block wx:if="{{items.type==2}}"><view><view class="text">{{items.title+'：'}}<image class="card-img" src="{{items.value_test}}" mode data-event-opts="{{[['tap',[['previewimage',['$0'],[[['numlist','',index],['field_cate_test','',indexs,'value_test']]]]]]]}}" bindtap="__e"></image></view></view></block><block wx:if="{{items.type==3}}"><view><view class="text">{{items.title+"："+items.value_test}}</view></view></block></view></block></view></block><view class="btn-box"><button class="btn" type="primary" data-event-opts="{{[['tap',[['goinspection',['$event']]]]]}}" bindtap="__e">查看巡检记录</button><block wx:if="{{map_type==1}}"><button class="btn" style="background:rgb(255, 138, 74) !important;" type="primary" data-event-opts="{{[['tap',[['gofailure',['$event']]]]]}}" bindtap="__e">添加巡检记录</button></block></view></view>