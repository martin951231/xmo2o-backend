page{background-color:#fff}.container{margin:0;padding:0;display:flex;width:100%;flex-direction:column;overflow:hidden;background:#fff}.leftcell{width:100%;margin-left:50rpx;border-left:4rpx solid #f8fafc}.loading_status{height:90vh;width:100%;display:flex;align-items:center;justify-content:center;flex-direction:column}.loding_txt{margin:10rpx;font-size:30rpx;color:#666}.bigbox{display:flex;flex-direction:row;justify-content:space-between;width:100%;margin-top:30rpx}.dot{width:10rpx;height:10rpx;border:10rpx solid #12c592;border-radius:15rpx;margin-left:-18rpx;flex-shrink:0;margin-top:17rpx}.dots{width:10rpx;height:10rpx;border:10rpx solid #f00101;border-radius:15rpx;margin-left:-18rpx;flex-shrink:0;margin-top:17rpx}.minibox{display:flex;flex-direction:column;width:100%;height:100%;justify-content:space-between}.topbox{width:100%;display:flex;flex-direction:row;justify-content:space-between;align-items:center;border-radius:20rpx 20rpx 0rpx 0rpx;background:#f8fafc}.text{font-size:36rpx;font-weight:400;font-stretch:normal;line-height:60rpx;letter-spacing:0rpx;color:#333;margin-left:20rpx}.time{font-size:24rpx;font-weight:400;font-stretch:normal;line-height:100rpx;letter-spacing:0rpx;color:#aeaeae;margin-right:20rpx}.not_more{width:100%;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:500;color:#999;padding:20rpx 0}