<view class="container" style="padding-bottom:20rpx;"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><view class="big-box"><view class="card"><view class="title">{{item.record_name}}</view><block wx:for="{{item.record_cate_field_config}}" wx:for-item="items" wx:for-index="indexs"><view><block wx:if="{{items.type==1}}"><view><view class="top-title">{{''+items.title+''}}</view><view class="input-box"><textarea class="input-btn" maxlength="1000" value="{{listdata[index]['record_cate_field_config'][indexs]['aricle_title']}}" placeholder="如有问题,请填写情况说明" data-event-opts="{{[['input',[['__set_model',['$0','aricle_title','$event',[]],['listdata.'+index+'.record_cate_field_config.'+indexs+'']],['iptText',['$event',index,indexs]]]]]}}" bindinput="__e"></textarea></view></view></block><block wx:if="{{items.type==2}}"><view><view class="top-title">{{''+items.title+''}}</view><view class="image-box"><sunui-upimg class="vue-ref-in-for" vue-id="{{'431784a2-1-'+index+'-'+indexs}}" upImgConfig="{{upImgBasic}}" data-ref="uImage" data-event-opts="{{[['^onUpImg',[['upBasicData',['$event',index,indexs]]]],['^onImgDel',[['delImgInfo',['$event',index]]]]]}}" bind:onUpImg="__e" bind:onImgDel="__e" bind:__l="__l"></sunui-upimg></view></view></block><block wx:if="{{items.type==3}}"><view><view class="top-title">{{''+items.title+''}}</view><block wx:for="{{items.use_field}}" wx:for-item="itm" wx:for-index="idx"><view data-event-opts="{{[['tap',[['switchBtn',[index,indexs,idx,'$0'],[[['listdata','',index],['record_cate_field_config','',indexs],['use_field','',idx]]]]]]]}}" class="switch-box" bindtap="__e"><view class="{{['switch',(type=='radio'&&items['num']==idx)?'switch1':'']}}"><view class="{{['switch-mini',(type=='radio'&&items['num']==idx)?'switch-mini1':'']}}"></view></view><view class="switch-text">{{itm}}</view></view></block></view></block></view></block></view></view></block><view><button class="btn" style="{{(btn_style)}}" type="primary" data-event-opts="{{[['tap',[['uPublishTap',[1]]]]]}}" bindtap="__e"> 提交 </button></view><block wx:if="{{to_repair_btn}}"><button class="btn" style="background-color:orange;margin-top:20rpx;transform:translateY(-20rpx);" type="primary" data-event-opts="{{[['tap',[['uPublishTap',[2]]]]]}}" bindtap="__e"> 提交巡检工单 </button></block><view><u-modal bind:input="__e" vue-id="431784a2-2" content="{{errormsg}}" value="{{isshow}}" data-event-opts="{{[['^input',[['__set_model',['','isshow','$event',[]]]]]]}}" bind:__l="__l"></u-modal></view></view>