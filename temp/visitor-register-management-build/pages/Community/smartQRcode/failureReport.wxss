page{background:#f5f5f5}.container{margin:0;padding:0}.big-box{box-shadow:0 0 30px 0 rgba(0,0,0,.08);background:#fff;overflow:hidden;border-radius:20rpx;margin:30rpx 20rpx 0rpx 20rpx}.card{padding:0rpx 30rpx 30rpx 30rpx;display:flex;flex-direction:column}.title{font-size:46rpx;font-weight:700;font-stretch:normal;line-height:90rpx;letter-spacing:0rpx;color:#100f3e;border-bottom:1rpx solid #f1f1f1}.top-title{font-size:42rpx;font-weight:700;line-height:90rpx;display:flex;flex-direction:row;align-items:center}.top-title:before{content:"";background:#fff;display:block;width:8rpx;height:8rpx;border:4rpx solid #4a97f8;border-radius:8rpx;margin-right:15rpx}.switch-box{display:flex;flex-direction:row;align-items:center;margin-left:20rpx}.switch{width:22rpx;height:22rpx;border-radius:22rpx;background:#fff;border:2rpx solid #e1e1e1;display:flex;justify-content:center;align-items:center}.switch-mini{width:15rpx;height:15rpx;border-radius:15rpx;background:#e1e1e1}.switch1{width:22rpx;height:22rpx;border-radius:22rpx;background:#fff;border:2rpx solid #1d7ef7;display:flex;justify-content:center;align-items:center}.switch-mini1{width:15rpx;height:15rpx;border-radius:15rpx;background:#1d7ef7}.switch-text{margin-left:15rpx;font-size:50rpx;padding:10rpx 0;font-weight:400;font-stretch:normal;line-height:50rpx;letter-spacing:0rpx;color:#606060}.btn{margin:50rpx;border-radius:50rpx}.input-btn{height:200rpx;width:100%;background-color:#f9f9f9;border-radius:20rpx;padding:15rpx 0rpx 0rpx 15rpx}.switch-img{width:100rpx;height:100rpx}.uni-textarea-textarea{padding:15rpx}.error_content{margin:40rpx;border-radius:20rpx}