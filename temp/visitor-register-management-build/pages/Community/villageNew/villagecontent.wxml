<view class="container"><block wx:if="{{true}}"><view class="container-box"><view class="title">{{now_news.title}}</view><view class="content-box"><rich-text nodes="{{htmlStr}}" loading="{{loading}}" data-event-opts="{{[['preview',[['preview',['$event']]]],['navigate',[['navigate',['$event']]]]]}}" bindpreview="__e" bindnavigate="__e"></rich-text></view><view class="read-box"><view class="read-num">{{now_news.add_time}}</view></view></view></block><view class="comment"><view data-event-opts="{{[['tap',[['writecomment',['$event']]]]]}}" class="Selected-commernt" bindtap="__e">留言</view></view><view class="bg-box"><block wx:for="{{reply_lists}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{true}}"><view class="comment-box"><image class="comment-img" src="{{item.avatar}}"></image><view class="comment-info"><view class="comment-name">{{item.nickname}}</view><view class="comment-text">{{item.content}}</view><view class="bottom-box"><view class="time-text">{{item.add_time}}</view><view class="edit-box"><image class="edit-icon" src="../static/images/site.png" mode data-event-opts="{{[['tap',[['openedit',['$0','$1'],[[['reply_lists','',index,'pigcms_id']],[['reply_lists','',index,'status']]]]]]]}}" bindtap="__e"></image><image class="delect-icon" src="../static/images/delect.png" mode data-event-opts="{{[['tap',[['delectComment',['$0'],[[['reply_lists','',index,'pigcms_id']]]]]]]}}" bindtap="__e"></image></view></view></view></view></block></block></view><view><uni-popups class="vue-ref" vue-id="4c2e7726-1" type="center" data-ref="popup" bind:__l="__l" vue-slots="{{['default']}}"><view class="prpup-box"><view>前台是否显示</view><view><switch checked="{{status==1?true:false}}" data-event-opts="{{[['change',[['changeShow',['$event']]]]]}}" bindchange="__e"></switch></view></view><image class="close-img" src="../static/images/close.png" mode data-event-opts="{{[['tap',[['close',['$event']]]]]}}" bindtap="__e"></image></uni-popups></view></view>