<view class="container"><scroll-view class="nav-bar" id="nav-bar" scroll-x="{{true}}" scroll-with-animation="{{true}}" scroll-left="{{scrollLeft}}"><block wx:for="{{tabBars}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="{{['nav-item',(index===tabCurrentIndex)?'current':'']}}" id="{{'tab'+index}}" data-index="{{index}}" data-event-opts="{{[['tap',[['changeTabs',[index,'$0'],[[['tabBars','',index,'cat_id']]]]]]]}}" bindtap="__e">{{item.cat_name}}</view></block></scroll-view><view style="height:90rpx;"></view><swiper class="paid_swiper" id="swiper" duration="{{300}}" current="{{tabCurrentIndex}}" data-event-opts="{{[['change',[['changeTab',['$event']]]]]}}" bindchange="__e"><block wx:for="{{tabBars}}" wx:for-item="item" wx:for-index="index" wx:key="index"><swiper-item><scroll-view class="panel-scroll-box" scroll-y="{{enableScroll}}"><block wx:for="{{news_list}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view data-event-opts="{{[['tap',[['godetails',['$0'],[[['news_list','',index,'news_id']]]]]]]}}" class="card" bindtap="__e"><view class="left-box"><view class="title">{{item.title}}</view><view class="time-text">{{item.add_time}}</view></view><view class="right-box"><view class="text">查看留言</view><image class="right-icon" src="../../../static/images/right.png" mode></image></view></view></block></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="{{'5659e0b0-1-'+index}}" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="{{'5659e0b0-2-'+index}}" keywords="没有更多记录" bind:__l="__l"></lang></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="../../../static/images/no_data.png"></image><view class="no_tip_content">暂无待审核数据</view></view></block></scroll-view></swiper-item></block></swiper></view>