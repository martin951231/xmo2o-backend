<view class="container" style="height:100vh;"><scroll-view class="scroll-box" scroll-y="true"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{true}}"><view class="card"><view class="card-left"><image class="user-img" src="../../../static/images/face_icon_2.png" mode></image><view class="right-box"><view class="info-box"><view class="name">{{item.device_name}}</view></view><view class="address">{{"位置："+item.position[0]}}<image class="face_icon_3" src="../static/images/face_icon_3.png" mode data-event-opts="{{[['tap',[['open',[index]]]]]}}" bindtap="__e"></image></view></view></view><view class="card-right"><image class="nopass" src="../../../static/images/face_icon_1.png" mode data-event-opts="{{[['tap',[['goedit',['$0'],[[['listdata','',index,'device_id']]]]]]]}}" bindtap="__e"></image><image class="nopass" src="../static/images/sync.png" mode data-event-opts="{{[['tap',[['godelect',['$0'],[[['listdata','',index,'device_id']]]]]]]}}" bindtap="__e"></image></view></view></block></block><block wx:if="{{false}}"><view class="tip_box_no_data"><image class="no_data_img" src="../../../static/images/no_data.png"></image><view class="no_tip_content">暂无搜素结果</view></view></block></scroll-view><view><uni-popups class="vue-ref" vue-id="b41d67e8-1" type="center" data-ref="popup" bind:__l="__l" vue-slots="{{['default']}}"><view class="prpup-box"><view class="popup-title">位置</view><view class="prpup-box_mini"><block wx:for="{{position}}" wx:for-item="item" wx:for-index="index"><view class="popup-text">{{item}}</view></block></view><image class="close-img" src="../../../static/images/guanbi.png" mode data-event-opts="{{[['tap',[['close',['$event']]]]]}}" bindtap="__e"></image></view></uni-popups></view></view>