<view><view class="container"><view class="fixed-top"><view class="head-box"><view class="search-box"><image class="search-img" src="../../../static/images/search.png" mode></image><input class="ipt" type="text" value="{{searchwords}}" placeholder="输入业主姓名或手机号" placeholder-class="pla-text" data-event-opts="{{[['focus',[['focusbox',['$event']]]],['blur',[['blurbox',['$event']]]],['confirm',[['confirmbox',['$event']]]],['input',[['__set_model',['','searchwords','$event',[]]]]]]}}" bindfocus="__e" bindblur="__e" bindconfirm="__e" bindinput="__e"/></view><block wx:if="{{hidesearch}}"><view data-event-opts="{{[['tap',[['searchbtn',['$event']]]]]}}" class="search-text" bindtap="__e">搜索</view></block></view></view><view class="content"><view hidden="{{!(current===0)}}"><scroll-view class="gopay_view" scroll-y="true"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view class="card"><view class="top-box"><view class="left-box"><view class="title">{{item.log_time}}</view></view><view class="right-box1" style="item.log_status ==1?'background-color:RGBA(34, 172, 56, 1);':'background-color: RGBA(230, 0, 18, 1);">{{''+(item.log_status==1?'成功':'失败')+''}}</view></view><view class="top-title">{{item.name}}</view><view class="bottom-box"><view><view class="mini-flex"><view class="text">开门位置：</view><view class="text">{{item.address}}</view></view></view></view><view class="bottom-box"><view><view class="mini-flex"><view class="text">手机号码：</view><view class="text">{{item.phone}}</view></view></view></view><view class="bottom-box"><view><view class="mini-flex"><view class="text">住址：</view><view class="text">{{item.address}}</view></view></view></view></view></block></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="0de950ab-1" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="0de950ab-2" keywords="没有更多记录" bind:__l="__l"></lang></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data _div"><image class="no_data_img" src="https://hf.pigcms.com/static/images/house/no_data.png"></image><view class="no_tip_content _div"><lang vue-id="0de950ab-3" keywords="暂无搜素结果~" bind:__l="__l"></lang></view></view></block></scroll-view></view><view hidden="{{!(current===1)}}"><scroll-view class="gopay_view1" scroll-y="true"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view class="card"><view class="top-box"><view class="left-box"><view class="title">{{item.log_time}}</view></view><block wx:if="{{item.log_status==1}}"><view class="right-box1" style="background-color:#07D69D;"> 成功 </view></block><block wx:else><view class="right-box1" style="background-color:#07D69D;"> 失败 </view></block></view><view class="top-title">{{item.name}}</view><view class="bottom-box"><view><view class="mini-flex"><view class="text">开门位置：</view><view class="text">{{item.address}}</view></view><view class="mini-flex"><view class="text">手机号码：</view><view class="text">{{item.phone}}</view></view><view class="mini-flex"><view class="text">住址：</view><view class="text">{{item.address}}</view></view></view></view></view></block></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="0de950ab-4" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="0de950ab-5" keywords="没有更多记录" bind:__l="__l"></lang></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data _div"><image class="no_data_img" src="https://hf.pigcms.com/static/images/house/no_data.png"></image><view class="no_tip_content _div"><lang vue-id="0de950ab-6" keywords="暂无内容~" bind:__l="__l"></lang></view></view></block></scroll-view></view></view></view></view>