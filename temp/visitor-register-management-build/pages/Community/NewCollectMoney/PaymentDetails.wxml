<view class="container data-v-a6e2a65e"><view class="head_box data-v-a6e2a65e"></view><view class="card_box data-v-a6e2a65e"><view class="flex_box_1 data-v-a6e2a65e"><view class="flex_left_box data-v-a6e2a65e"><text class="text_1 data-v-a6e2a65e">合计收款(元)</text><text class="text_2 data-v-a6e2a65e">{{datainfo.sum_money}}</text></view><view data-event-opts="{{[['tap',[['clickshow',['$event']]]]]}}" class="flex_right_box data-v-a6e2a65e" bindtap="__e"><text class="text_1 data-v-a6e2a65e">账单详情</text><image class="drop_down data-v-a6e2a65e" style="{{(show_drop?'transform: rotateX(180deg);':'')}}" src="../static/images/drop_down.png" mode></image></view></view><block wx:if="{{show_drop}}"><view class="flex_box_2 data-v-a6e2a65e"><block wx:for="{{datainfo.data}}" wx:for-item="item" wx:for-index="index"><view class="item_box data-v-a6e2a65e"><text class="text_1 data-v-a6e2a65e">{{item.title}}</text><text class="text_1 data-v-a6e2a65e">{{item.val?item.val:'无'}}</text></view></block></view></block></view><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><view data-event-opts="{{[['tap',[['godetails',['$0'],[[['listdata','',index,'order_id']]]]]]]}}" class="card data-v-a6e2a65e" catchtap="__e"><image class="img_1 data-v-a6e2a65e" src="{{item.img}}" mode></image><view class="flex_box_1 data-v-a6e2a65e"><view class="flex_mini_1 data-v-a6e2a65e"><text class="text_title data-v-a6e2a65e">{{item.order_name}}</text><block wx:if="{{item.refund_status!=''}}"><view class="btn data-v-a6e2a65e">{{item.refund_status}}</view></block></view><view class="text_box data-v-a6e2a65e"><text class="text_1 data-v-a6e2a65e">￥<text style="font-size:36rpx;" class="data-v-a6e2a65e">{{item.pay_money}}</text></text><image class="right_icon data-v-a6e2a65e" src="../static/images/right.png" mode></image></view></view></view></block></view>