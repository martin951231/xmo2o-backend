<view class="container data-v-1ebb33db"><block wx:for="{{datalist}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view class="card data-v-1ebb33db"><view class="flex_box_1 data-v-1ebb33db"><text class="title data-v-1ebb33db">{{item.project_name}}</text><view class="flex_1 data-v-1ebb33db"><block wx:if="{{item.manual_btn==1}}"><view data-event-opts="{{[['tap',[['goGenerateBillManually',['$0'],[[['datalist','',index]]]]]]]}}" class="btn data-v-1ebb33db" catchtap="__e"> 手动生成账单</view></block><block wx:if="{{item.prepaid_btn==1}}"><view data-event-opts="{{[['tap',[['goGeneratePrepaymentBill',['$0','$1'],[[['datalist','',index,'project_id']],[['datalist','',index,'charge_rule_id']]]]]]]}}" class="btn data-v-1ebb33db" catchtap="__e">生成预缴账单</view></block><view data-event-opts="{{[['tap',[['deleteBill',['$0'],[[['datalist','',index,'id']]]]]]]}}" class="btn_1 data-v-1ebb33db" catchtap="__e">移除</view></view></view><text class="text_1 data-v-1ebb33db">{{item.charge_name+"："+item.charge_valid_time_txt}}</text></view></block></block><block wx:if="{{pageLoading}}"><view class="tip data-v-1ebb33db"><lang vue-id="608a47be-1" keywords="加载中" class="data-v-1ebb33db" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip data-v-1ebb33db"><lang vue-id="608a47be-2" keywords="没有更多记录" class="data-v-1ebb33db" bind:__l="__l"></lang></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data _div data-v-1ebb33db"><image class="no_data_img data-v-1ebb33db" src="https://hf.pigcms.com/static/images/house/no_data.png"></image><view class="no_tip_content _div data-v-1ebb33db"><lang vue-id="608a47be-3" keywords="暂无内容~" class="data-v-1ebb33db" bind:__l="__l"></lang></view></view></block><image class="suspension_img data-v-1ebb33db" src="../static/images/add_money.png" data-event-opts="{{[['tap',[['goCollectionCate',['$event']]]]]}}" catchtap="__e"></image></view>