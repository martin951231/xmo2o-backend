<view data-event-opts="{{[['tap',[['handleClick',['$event']]]]]}}" class="activity-item data-v-c5692aaa" bindtap="__e"><view class="item-left data-v-c5692aaa"><image class="activity-image data-v-c5692aaa" src="{{item.poster}}" mode="aspectFill"></image></view><view class="item-right data-v-c5692aaa"><view class="item-header data-v-c5692aaa"><text class="activity-title u-m-r-10 data-v-c5692aaa">{{item.name}}</text><view class="activity-status data-v-c5692aaa"><block wx:if="{{type=='activity'}}"><u-tag vue-id="31ae55a5-1" text="{{item.activity_status_text}}" size="mini" class="data-v-c5692aaa" bind:__l="__l"></u-tag></block><block wx:else><u-tag vue-id="31ae55a5-2" type="{{statusType}}" text="{{item.status_text}}" size="mini" class="data-v-c5692aaa" bind:__l="__l"></u-tag></block></view></view><view class="item-footer data-v-c5692aaa"><u-icon vue-id="31ae55a5-3" name="clock" color="#999" size="26" class="data-v-c5692aaa" bind:__l="__l"></u-icon><text class="activity-location data-v-c5692aaa">{{item.start_time+" - "+item.end_time}}</text></view></view></view>