<view class="page-container"><view class="header"><view class="user-info"><image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill"></image><view class="user-text"><text class="username">{{userInfo.login_name}}</text><text class="user-id">{{userInfo.role_name}}</text></view></view><u-icon vue-id="1639acee-1" name="man-delete" color="#fff" size="36" data-event-opts="{{[['^click',[['logout']]]]}}" bind:click="__e" bind:__l="__l"></u-icon></view><view class="tabs-container"><block wx:for="{{tabs}}" wx:for-item="tab" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['jumpToPage',[index]]]]]}}" class="tab-item" bindtap="__e"><u-icon vue-id="{{'1639acee-2-'+index}}" name="{{tabIcons[index]}}" color="#2d85f3" size="{{56}}" bind:__l="__l"></u-icon><text class="tab-name">{{tab}}</text></view></block></view><view class="header-title">活动数据</view><view class="stats-grid"><block wx:for="{{statsData1}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="stat-card"><text class="stat-label">{{item.label}}</text><text class="stat-value">{{item.value}}</text><block wx:if="{{item.tip}}"><view data-event-opts="{{[['tap',[['showQuestion',['$0'],[[['statsData1','',index,'tip']]]]]]]}}" class="question-btn" bindtap="__e"><u-icon vue-id="{{'1639acee-3-'+index}}" name="question" color="#999" size="24" bind:__l="__l"></u-icon></view></block></view></block></view><view class="header-title">活动人次数据</view><view class="stats-grid"><block wx:for="{{statsData2}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="stat-card"><text class="stat-label">{{item.label}}</text><text class="stat-value">{{item.value}}</text><block wx:if="{{item.tip}}"><view data-event-opts="{{[['tap',[['showQuestion',['$0'],[[['statsData2','',index,'tip']]]]]]]}}" class="question-btn" bindtap="__e"><u-icon vue-id="{{'1639acee-4-'+index}}" name="question" color="#999" size="24" bind:__l="__l"></u-icon></view></block></view></block></view><view class="header-title">活动效果数据</view><view class="stats-grid"><block wx:for="{{statsData3}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="stat-card"><text class="stat-label">{{item.label}}</text><text class="stat-value">{{item.value}}</text><block wx:if="{{item.tip}}"><view data-event-opts="{{[['tap',[['showQuestion',['$0'],[[['statsData3','',index,'tip']]]]]]]}}" class="question-btn" bindtap="__e"><u-icon vue-id="{{'1639acee-5-'+index}}" name="question" color="#999" size="24" bind:__l="__l"></u-icon></view></block></view></block></view></view>