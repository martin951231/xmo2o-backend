.page-container{min-height:100vh;box-sizing:border-box;background:linear-gradient(180deg,#f5f7fa,#e4e8ec)}.header{background:linear-gradient(135deg,#2d85f3,#1a5db5);padding:30rpx 30rpx 60rpx;display:flex;justify-content:space-between;align-items:center}.user-info{display:flex;align-items:center}.avatar{width:100rpx;height:100rpx;border-radius:50%;border:4rpx solid hsla(0,0%,100%,.5)}.user-text{margin-left:24rpx;display:flex;flex-direction:column}.username{font-size:32rpx;color:#fff;font-weight:600}.user-id{font-size:24rpx;color:hsla(0,0%,100%,.8);margin-top:8rpx}.tabs-container{background:#fff;margin:-30rpx 20rpx 20rpx;border-radius:20rpx;box-shadow:0 4rpx 20rpx rgba(0,0,0,.08);padding:20rpx;display:flex;justify-content:space-around}.tab-item{display:flex;flex-direction:column;align-items:center;padding:20rpx 40rpx;position:relative;border-radius:16rpx}.tab-name{font-size:24rpx;color:#666;margin-top:8rpx}.stats-grid{padding:0 20rpx;display:grid;grid-template-columns:repeat(3,1fr);grid-gap:16rpx}.stat-card{background:#fff;border-radius:16rpx;padding:24rpx;box-shadow:0 2rpx 12rpx rgba(0,0,0,.04);position:relative}.stat-label{font-size:24rpx;color:#999;display:block;margin-bottom:12rpx}.stat-value{font-size:44rpx;font-weight:700;color:#333;display:block}.question-btn{position:absolute;top:24rpx;right:24rpx;width:36rpx;height:36rpx;background:#f5f5f5;border-radius:50%;display:flex;justify-content:center;align-items:center}.header-title{font-size:28rpx;font-weight:600;color:#1890ff;margin:30rpx 20rpx;padding-left:15rpx;border-left:6rpx solid #1890ff;display:flex;align-items:center}.header-title::before{content:"";margin-right:8rpx}