l" vue-slots="{{['default']}}"><view class="popup-container data-v-4fb459ee"><view class="popup-header data-v-4fb459ee"><text class="popup-title data-v-4fb459ee">报名表单</text><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="popup-close data-v-4fb459ee" bindtap="__e"><u-icon vue-id="{{('400ee97e-8')+','+('400ee97e-7')}}" name="close" size="28" color="#999" class="data-v-4fb459ee" bind:__l="__l"></u-icon></view></view><scroll-view class="popup-scroll data-v-4fb459ee" scroll-y="{{true}}"><view class="survey-detail data-v-4fb459ee"><block wx:for="{{surveyData}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="detail-row data-v-4fb459ee"><view class="detail-label data-v-4fb459ee">{{item.title}}</view><block wx:if="{{item.type=='image'}}"><view class="detail-value data-v-4fb459ee"><block wx:for="{{item.answer}}" wx:for-item="img" wx:for-index="idx" wx:key="idx"><image class="detail-img data-v-4fb459ee" src="{{img}}" mode="widthFix"></image></block></view></block><block wx:else><block wx:if="{{item.type=='file'}}"><view class="detail-value data-v-4fb459ee"><block wx:for="{{item.answer}}" wx:for-item="file" wx:for-index="idx" wx:key="idx"><view data-event-opts="{{[['tap',[['openFile',['$0'],[[['surveyData','',index],['answer','',idx]]]]]]]}}" class="detail-file data-v-4fb459ee" bindtap="__e"><text class="data-v-4fb459ee">{{"附件"+(idx+1)+": "+file}}</text></view></block></view></block><block wx:else><view class="detail-value data-v-4fb459ee">{{item.answer}}</view></block></block></view></block></view></scroll-view></view></u-popup></view>