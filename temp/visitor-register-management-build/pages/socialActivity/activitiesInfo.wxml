<view class="page-container data-v-4fb459ee"><view class="stats-header data-v-4fb459ee"><view class="stat-card data-v-4fb459ee"><view class="stat-icon data-v-4fb459ee" style="{{'background-color:'+('#e8f4fd')+';'}}"><u-icon vue-id="400ee97e-1" name="account" color="#2d85f3" size="38" class="data-v-4fb459ee" bind:__l="__l"></u-icon></view><view class="stat-content data-v-4fb459ee"><text class="stat-value data-v-4fb459ee">{{signUpNum}}</text><text class="stat-label data-v-4fb459ee">报名数</text></view></view><view class="stat-card data-v-4fb459ee"><view class="stat-icon data-v-4fb459ee" style="{{'background-color:'+('#e8f9e8')+';'}}"><u-icon vue-id="400ee97e-2" name="order" color="#52c41a" size="38" class="data-v-4fb459ee" bind:__l="__l"></u-icon></view><view class="stat-content data-v-4fb459ee"><text class="stat-value data-v-4fb459ee">{{checkInNum}}</text><text class="stat-label data-v-4fb459ee">签到数</text></view></view></view><view class="search-box data-v-4fb459ee"><u-tabs vue-id="400ee97e-3" list="{{tabList}}" is-scroll="{{false}}" current="{{current}}" data-event-opts="{{[['^change',[['change']]]]}}" bind:change="__e" class="data-v-4fb459ee" bind:__l="__l"></u-tabs></view><view class="list-content data-v-4fb459ee"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['handleItemClick',['$0'],[[['list','',index]]]]]]]}}" class="list-item u-flex-col data-v-4fb459ee" bindtap="__e"><view class="item-right data-v-4fb459ee"><view class="u-flex u-m-b-10 data-v-4fb459ee"><image class="avatar u-m-r-20 data-v-4fb459ee" src="{{item.$orig.avatar}}" mode="aspectFill"></image><view class="u-flex u-flex-1 data-v-4fb459ee"><text class="nickname u-flex-1 data-v-4fb459ee">{{item.$orig.nickname}}</text><u-tag vue-id="{{'400ee97e-4-'+index}}" type="{{item.m0}}" text="{{item.$orig.sign_text}}" size="mini" class="data-v-4fb459ee" bind:__l="__l"></u-tag></view></view><view class="info-row data-v-4fb459ee"><text class="info-la