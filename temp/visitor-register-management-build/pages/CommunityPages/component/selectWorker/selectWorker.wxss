page{background:#f5f5f5}.container{height:100vh;margin:0;padding:0;position:fixed;top:0;right:0;bottom:0;left:0;background-color:#f5f5f5}.head_box{display:flex;flex-direction:row;align-items:center;margin-top:15rpx}.head_box .left_img{width:50px;height:50px;display:flex;align-items:center;justify-content:center;-webkit-transform:rotate(180deg);transform:rotate(180deg)}.head_box .left_img .back_img{width:20px;height:20px}.head_box .head-box{width:100%;margin:0rpx 30rpx 0rpx 10rpx;display:flex;flex-direction:row;align-items:center;background-color:#fff;border-radius:60rpx;overflow:hidden}.head_box .head-box .search-box{display:flex;flex-direction:row;align-items:center;padding:20rpx 40rpx;background-color:#fff;width:100%}.head_box .head-box .search-box .search-img{width:35rpx;height:35rpx;display:block}.head_box .head-box .search-box .ipt{margin-left:30rpx;width:400rpx}.head_box .head-box .search-box .pla-text{font-size:28rpx;color:#5a5a5a}.title{margin:30rpx 0 20rpx 30rpx;font-size:24rpx;font-family:PingFang SC;font-weight:500;color:#81858d}.flex_box{display:flex;flex-direction:row;align-items:center;background-color:#fff;padding-right:30rpx}.flex_box .avatar{width:60rpx;height:60rpx;border-radius:4rpx;display:inline-block;margin:20rpx 20rpx 20rpx 30rpx;flex-shrink:0}.flex_box .name{font-size:28rpx;font-family:PingFang SC;font-weight:500;color:#333;display:flex;line-height:100rpx;width:100%;border-bottom:1px solid #f1f1f1}.flex_box:last-of-type .name{border-bottom:0 solid #f1f1f1}