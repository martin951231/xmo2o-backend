<block wx:if="{{showWorker}}"><view class="container" style="{{('z-index:'+Zindex)}}"><view class="head_box"><view data-event-opts="{{[['tap',[['close',['$event']]]]]}}" class="left_img" bindtap="__e"><image class="back_img" src="../../../../static/images/right.png" mode></image></view><view class="head-box"><view class="search-box"><image class="search-img" src="../../../../static/images/search.png" mode></image><input class="ipt" type="text" value="{{searchwords}}" placeholder="搜索" placeholder-class="pla-text" data-event-opts="{{[['focus',[['focusbox',['$event']]]],['blur',[['blurbox',['$event']]]],['confirm',[['confirmbox',['$event']]]],['input',[['__set_model',['','searchwords','$event',[]]]]]]}}" bindfocus="__e" bindblur="__e" bindconfirm="__e" bindinput="__e"/></view></view></view><block wx:for="{{upworkerList}}" wx:for-item="item" wx:for-index="index"><block><view class="title">{{item.title}}</view><block wx:for="{{item.children}}" wx:for-item="ite" wx:for-index="idx"><view data-event-opts="{{[['tap',[['selectWorkers',['$0'],[[['upworkerList','',index],['children','',idx]]]]]]]}}" class="flex_box" bindtap="__e"><image class="avatar" src="{{ite.avatar}}" mode></image><view class="name">{{ite.name}}</view></view></block></block></block></view></block>