<view class="container"><view class="headerBar">{{"以下"+$root.g0+"店通用"}}</view><view class="storeBox bw mt20"><block wx:for="{{store_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block><view class="item" data-lat="{{item.lat}}" data-lng="{{item.lng}}" data-type="baidu" data-name="{{item.name}}" data-address="{{item.area_name+''+item.adress}}" data-event-opts="{{[['tap',[['openMap',['$event']]]]]}}" bindtap="__e"><view class="name">{{item.name}}</view><view class="address">{{item.area_name+item.adress}}</view><view class="phone" data-phone="{{item.phone}}" data-event-opts="{{[['tap',[['callPhone',['$event']]]]]}}" catchtap="__e"></view></view></block></block></view></view>