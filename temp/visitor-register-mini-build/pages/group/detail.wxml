<view><scroll-view class="container" style="{{('height:'+containerHeight+'px;')}}" scroll-y="true" bindscroll="container_scroll"><view data-event-opts="{{[['tap',[['groupImgPreview',['$event']]]]]}}" class="imgBox" style="{{('height:'+groupImgHeight+'px')}}" bindtap="__e"><image src="{{group_detail.now_group.image}}"></image><view class="imgCon"><view class="title">{{group_detail.now_group.group_name}}</view><view class="desc">{{group_detail.now_group.s_name}}</view></view></view><view class="buyBox bw mb20"><view class="priceDiv"><text class="price"><text>￥</text><text class="fw">{{group_detail.now_group.price}}</text><text class="old"><text>￥</text><text class="tdlh">{{group_detail.now_group.old_price}}</text></text></text><button data-event-opts="{{[['tap',[['buyEvent',['$event']]]]]}}" class="buy-btn" bindtap="__e">立即购买</button></view><block wx:if="{{group_detail.now_group.score_money!=0}}"><view class="cheapDiv">积分抵现 <text class="tag">{{"本单最高可用"+group_detail.now_group.score+"积分抵"+group_detail.now_group.score_money+"元"}}</text></view></block><view class="saleDiv"><block wx:if="{{group_detail.now_group.no_refund==1}}"><block><text class="span">抢购商品，支付后不可退款</text></block></block><block wx:else><block><text class="span"><text class="yesLightIcon"></text>随时退</text><text class="span"><text class="yesLightIcon"></text>过期退</text></block></block><block wx:if="{{group_detail.now_group.sale_count!=0}}"><text class="span sale"><text class="yesIcon"></text>{{"已售"+group_detail.now_group.sale_count}}</text></block></view></view><view class="storeBox mb20 bw"><view class="storeList"><block wx:for="{{group_detail.store_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block><block wx:if="{{index<2}}"><view class="item" data-lat="{{item.lat}}" data-lng="{{item.lng}}" data-type="baidu" data-name="{{item.name}}" data-address="{{item.area_name+''+item.adress}}" data-event-opts="{{[['tap',[['openMap',['$event']]]]]}}" bindtap="__e"><view class="name">{{item.name}}</view><view class="address">{{item.area_name+item.adress}}</view><view class="phoneBox" data-phone="{{item.phone}}" data-event-opts="{{[['tap',[['callPhone',['$event']]]]]}}" catchtap="__e"><view class="phone"></view></view></view></block></block></block></view><block wx:if="{{$root.g0>2}}"><view data-event-opts="{{[['tap',[['goStoreList',['$event']]]]]}}" class="more" bindtap="__e">{{"全部"+$root.g1+"家分店"}}</view></block></view><block wx:if="{{$root.g2>1}}"><view class="introList term"><view class="titleDiv"><view class="title">购买须知</view></view><view class="content"><block wx:for="{{group_detail.cue_arr}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block><view class="item"><text class="fw">{{item.key+"："}}</text><text>{{item.value}}</text></view></block></block></view></view></block><view class="introList"><view class="titleDiv"><view class="title">本单详情</view></view><view class="content detailCon"><rich-text nodes="{{group_detail.now_group.content_rich}}"></rich-text></view></view><block wx:if="{{$root.g3>0}}"><view class="group_list bw mb20"><view class="titleDiv"><view class="title">商家其他团购</view></view><block wx:for="{{group_detail.merchant_group_list}}" wx:for-item="item" wx:for-index="group_list" wx:key="group_list"><block><block wx:if="{{item.pin_num==0}}"><view class="menulink" data-group_id="{{item.group_id}}" data-event-opts="{{[['tap',[['goGroup',['$event']]]]]}}" bindtap="__e"><view class="fl ml_left"><image src="{{item.list_pic}}"></image><view class="{{['pos '+(item.pin_num==0?'group':'fight')]}}"></view></view><view class="ml_menu"><view class="tit">{{item.group_name}}</view><view class="cf bot"><view class="fl cf"><view class="fl val"><text class="mall">￥</text><text class="price">{{item.price}}</text></view><view class="fl rackrate">{{item.old_price}}</view></view><block wx:if="{{item.sale_count!=0}}"><view class="fr sold">{{"已售 "+item.sale_count}}</view></block></view></view></view></block></block></block></view></block><view style="height:100rpx;"></view><view class="positionDiv" style="{{('display:'+(bottomBuyShow?'block':'none'))}}"><view class="fl"><view data-event-opts="{{[['tap',[['backPrevPage',['$event']]]]]}}" class="back" catchtap="__e"></view></view><view class="center"><block wx:if="{{group_detail.now_group.tuan_type!=2}}"><text>{{group_detail.now_group.merchant_name}}</text></block><block wx:else><text>{{group_detail.now_group.s_name}}</text></block></view><view class="fr"><button data-event-opts="{{[['tap',[['buyEvent',['$event']]]]]}}" class="buy-btn" bindtap="__e">购买</button></view></view></scroll-view></view>