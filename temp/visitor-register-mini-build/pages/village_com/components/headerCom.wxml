<view class="header_com data-v-46c3b7ab" style="{{(headStyle)}}"><view class="top_content data-v-46c3b7ab"><view data-event-opts="{{[['tap',[['chooseVillage',['$event']]]]]}}" class="village_location data-v-46c3b7ab" bindtap="__e"><view class="location_icon data-v-46c3b7ab"><image src="https://hz.huizhisq.com/static/wxapp/villageindex/header_location_icon.png" mode class="data-v-46c3b7ab"></image></view><view class="village_name data-v-46c3b7ab" style="{{'color:'+(switch_village_color)+';'}}">{{village_name}}</view><view class="choose_icon data-v-46c3b7ab" style="{{'color:'+(switch_village_color)+';'}}"><view class="choose_arrow data-v-46c3b7ab"></view></view></view><view class="weather_car_msg data-v-46c3b7ab"><view class="weather_con data-v-46c3b7ab"><view class="today_weather data-v-46c3b7ab">{{topWeather.weather}}</view><view class="temperature data-v-46c3b7ab">{{topWeather.temperature}}</view></view><block wx:if="{{topTraffic.limit_number}}"><view class="car_msg data-v-46c3b7ab"><view class="car_status data-v-46c3b7ab">{{topTraffic.title}}</view><view class="view_icon data-v-46c3b7ab">{{topTraffic.limit_number}}</view></view></block></view></view><view class="bottom_search data-v-46c3b7ab"><view class="search_con data-v-46c3b7ab"><view data-event-opts="{{[['tap',[['scanThis']]]]}}" class="left_scan_icon data-v-46c3b7ab" bindtap="__e"><image src="https://hz.huizhisq.com/static/wxapp/villageindex/search_scan_icon.png" mode class="data-v-46c3b7ab"></image></view><input class="search_input data-v-46c3b7ab" type="text" data-event-opts="{{[['focus',[['goToSearch',['$event']]]],['input',[['__set_model',['','searchValue','$event',[]]]]]]}}" value="{{searchValue}}" bindfocus="__e" bindinput="__e"/><view class="camera_search_btn data-v-46c3b7ab"><view data-event-opts="{{[['tap',[['cameraThis']]]]}}" class="camera_icon data-v-46c3b7ab" bindtap="__e"><image src="https://hz.huizhisq.com/static/wxapp/villageindex/search_camera_icon.png" mode class="data-v-46c3b7ab"></image></view><view data-event-opts="{{[['tap',[['goToSearch',['$event']]]]]}}" class="search_btn data-v-46c3b7ab" style="{{'background-color:'+(top_search_btn.bg_color)+';'+('color:'+(top_search_btn.color)+';')}}" bindtap="__e">{{top_search_btn.title}}</view></view></view></view></view>