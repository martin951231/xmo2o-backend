<view class="container"><view class="topbox"><block wx:if="{{infoData}}"><view class="text">{{'服务日期：  '+listData.start_time+"至"+listData.end_time+"（"+listData.cycle_sum+'周期）'}}</view></block><view class="text">{{"您已缴纳的周期个数为：  "+listData.paid_cycle+"个"}}</view></view><view class="paycard1"><view class="infolist"><view class="text4">计算公式：</view><view class="text4">{{listData.pay_type_desc}}</view></view><view class="infolist"><view class="text4">收费金额：</view><view class="text4">{{pay_money}}</view></view><view class="infolist"><view class="text4">收费周期：</view><view class="text4">{{listData.fee_cycle}}</view></view><view class="infolist"><view class="text4">请选择缴纳周期费</view></view><view class="infolist2"><uni-number-box vue-id="826a6754-1" min="{{listData.min_sum}}" max="{{listData.max_sum}}" value="{{changevalue}}" data-event-opts="{{[['^change',[['change']]]]}}" bind:change="__e" bind:__l="__l"></uni-number-box></view><view class="infolist1"><view class="text4">缴费总额：</view><view class="text5">{{"￥"+price}}</view></view></view><view class="text2">{{'本次最大只可缴费'+listData.max_sum+'个周期'}}</view><button class="btn" style="{{(btn_style)}}" type="primary" data-event-opts="{{[['tap',[['btnpay',['$event']]]]]}}" bindtap="__e">去支付</button></view>