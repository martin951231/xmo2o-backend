page{background:#fff}.container{margin:0;padding:0;background:#f5f5f5;padding-top:15rpx}.container-box{background:#fff;padding:50rpx 30rpx}.top-text{margin:30rpx 30rpx 0rpx 30rpx;font-size:24rpx;font-weight:400;font-stretch:normal;line-height:44rpx;letter-spacing:0rpx;color:#ababab}.card-box{margin:0rpx 30rpx 30rpx 30rpx;display:flex;flex-direction:row;justify-content:space-between;flex-wrap:wrap}.card{display:flex;flex-direction:row;justify-content:space-between;align-items:center;width:245rpx;margin-top:30rpx;background:#f5f5f5;border-radius:15rpx;padding:30rpx 15rpx 30rpx 30rpx}.name{font-size:28rpx;font-weight:700;font-stretch:normal;line-height:60rpx;letter-spacing:0rpx;color:#000}.bottom-box{position:fixed;left:0rpx;bottom:50rpx;display:flex;flex-direction:row;justify-content:space-between;align-items:center;background-color:#bbd8ff;margin:0rpx 30rpx;padding:15rpx 15rpx 15rpx 30rpx;width:634rpx;border-radius:45rpx}.all-btn{font-size:28rpx;font-weight:400;font-stretch:normal;line-height:60rpx;letter-spacing:0rpx;color:#fff}.tip_box_no_data{padding-top:calc((100vh - 80rpx - 288rpx - 21rpx)/2);font-size:28rpx;text-align:center}.tip_box_no_data .tip_title{width:100%;text-align:center}.no_data_img{width:374rpx;height:288rpx}