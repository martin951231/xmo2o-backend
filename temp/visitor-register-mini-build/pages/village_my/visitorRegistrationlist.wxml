<view class="container"><view class="background-color" style="{{('background:'+mobile_head_color)}}"><view class="topbox"><view style="display:flex;flex-direction:row;align-items:center;justify-content:space-between;"><view class="info-box"><view class="name">{{listdata.owner_name}}</view><view class="tips">业主</view></view><view data-event-opts="{{[['tap',[['govisitor',['$event']]]]]}}" class="lookRegistration" bindtap="__e">访客自主申请码</view></view><view class="phone">{{listdata.owner_phone}}</view><view class="address-box"><view class="address-icon"><image class="address-img" src="https://cloud.mrsqfw.com/static/wxapp/images/address.png"></image></view><block wx:if="{{listdata.address}}"><view class="address-text">{{listdata.address}}</view></block></view></view></view><block wx:for="{{dataList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{dataList[0]}}"><view class="card"><view class="relative-top"><view data-event-opts="{{[['tap',[['goTo',['$0'],[[['dataList','',index,'detail_url']]]]]]]}}" class="relative-box" bindtap="__e"><view class="relative">{{item.visitor_name}}</view></view><block wx:if="{{item.statusImg}}"><view data-event-opts="{{[['tap',[['goTo',['$0'],[[['dataList','',index,'detail_url']]]]]]]}}" style="height:20px;max-width:160rpx;" bindtap="__e"><image style="height:20px;" src="{{item.statusImg}}" alt="{{item.statusDesc}}" mode="heightFix"></image></view></block><block wx:else><view data-event-opts="{{[['tap',[['goTo',['$0'],[[['dataList','',index,'detail_url']]]]]]]}}" class="relative-tips" bindtap="__e">{{item.statusDesc}}</view></block><block wx:if="{{item.pass_url}}"><button class="btn" style="{{('background-color:'+actcolor+';-webkit-box-shadow:0rpx 4rpx 16rpx #b1b1b1;box-shadow:0rpx 4rpx 16rpx #b1b1b1;')}}" type="primary" data-event-opts="{{[['tap',[['goTo',['$0'],[[['dataList','',index,'pass_url']]]]]]]}}" bindtap="__e">通行记录</button></block></view><view class="{{['top-box',item.car_id?'':'top-box1']}}"><block wx:if="{{item.car_id}}"><view data-event-opts="{{[['tap',[['goTo',['$0'],[[['dataList','',index,'detail_url']]]]]]]}}" class="top-text" bindtap="__e">{{item.car_id}}</view></block><block wx:if="{{status==5}}"><view data-event-opts="{{[['tap',[['repeatInvitation',['$event']]]]]}}" class="zaiciyaoqing" bindtap="__e">再次邀请</view></block></view><view data-event-opts="{{[['tap',[['goTo',['$0'],[[['dataList','',index,'detail_url']]]]]]]}}" class="center-phone" bindtap="__e">{{item.visitor_phone}}</view><block wx:if="{{item.time_txt}}"><view data-event-opts="{{[['tap',[['goTo',['$0'],[[['dataList','',index,'detail_url']]]]]]]}}" class="center-phone" bindtap="__e">{{"添加时间："+item.time_txt}}</view></block><view data-event-opts="{{[['tap',[['goTo',['$0'],[[['dataList','',index,'detail_url']]]]]]]}}" class="center-phone" bindtap="__e">{{"来访时间："+item.add_time}}</view><block wx:if="{{item.pass_time}}"><view data-event-opts="{{[['tap',[['goTo',['$0'],[[['dataList','',index,'detail_url']]]]]]]}}" class="center-phone" bindtap="__e">{{"放行时间："+item.pass_time}}</view></block></view></block></block><block wx:if="{{!dataList[0]}}"><view class="tip_box_no_data _div"><image class="no_data_img" src="https://cloud.mrsqfw.com/static/images/house/no_data.png"></image><view class="no_tip_content _div"><lang vue-id="f3cd74d0-1" keywords="暂无内容~" bind:__l="__l"></lang></view></view></block><view data-event-opts="{{[['tap',[['goaddRegistration',['$event']]]]]}}" class="independent_payment" bindtap="__e"><image class="independent-img" src="https://cloud.mrsqfw.com/static/wxapp/images/addexpress.png"></image></view></view>