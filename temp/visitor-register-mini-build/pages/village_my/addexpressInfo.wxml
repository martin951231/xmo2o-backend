<view><view class="container"><view class="title">姓名</view><input class="inp-box" type="text" value="{{name}}" placeholder-style="font-size: 28rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="请输入您的姓名" data-event-opts="{{[['input',[['__set_model',['','name','$event',[]]]]]]}}" bindinput="__e"/><view class="title">联系方式</view><input class="inp-box" type="number" value="{{phone}}" placeholder-style="font-size: 28rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="请输入手机号" data-event-opts="{{[['input',[['__set_model',['','phone','$event',[]]]]]]}}" bindinput="__e"/><view class="title">省/市/区</view><input class="inp-box" disabled="true" type="text" placeholder-style="font-size: 28rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="请选择省市区县" data-event-opts="{{[['tap',[['selecteaddress',['$event']]]]]}}" value="{{address}}" bindtap="__e"/><w-picker class="vue-ref" vue-id="3fff917c-1" mode="region" defaultVal="{{['安徽省','合肥市','蜀山区']}}" areaCode="{{['34','3304','340104']}}" hideArea="{{false}}" timeout="{{true}}" data-ref="region" data-event-opts="{{[['^confirm',[['onConfirm']]]]}}" bind:confirm="__e" bind:__l="__l"></w-picker><view class="title">详细地址</view><input class="inp-box" type="text" value="{{text}}" placeholder-style="font-size: 28rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="请输入详细地址" data-event-opts="{{[['input',[['__set_model',['','text','$event',[]]]]]]}}" bindinput="__e"/><view class="btn"><button class="btn-pry" style="{{(btn_style)}}" type="primary" data-event-opts="{{[['tap',[['uPublishTap',['$event']]]]]}}" bindtap="__e">提交</button></view></view></view>