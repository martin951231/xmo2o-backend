<view><view class="container"><view class="top-head" style="{{('background:'+actcolor)}}"><view class="address-icon"><image class="address-img" src="https://cloud.mrsqfw.com/static/wxapp/images/addressicon.png"></image></view><view class="address-text">{{address}}</view></view><view class="title">缴费事项</view><input class="inp-box" type="text" value="{{pay_name}}" placeholder-style="font-size: 28rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="请填写缴费的事项" data-event-opts="{{[['input',[['__set_model',['','pay_name','$event',[]]]]]]}}" bindinput="__e"/><view class="title">缴费金额</view><input class="inp-box" type="digit" value="{{money}}" placeholder-style="font-size: 28rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="请输入缴纳的费用（元）" data-event-opts="{{[['input',[['__set_model',['','money','$event',[]]]]]]}}" bindinput="__e"/><view class="btn"><button class="btn-pry" style="{{(btn_style)}}" type="primary" data-event-opts="{{[['tap',[['uPublishTap',['$event']]]]]}}" bindtap="__e">去缴费</button></view></view></view>