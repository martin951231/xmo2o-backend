<view><block wx:if="{{listdata}}"><view class="container"><view class="topbox"></view><view class="strip"></view><view class="paycard"><view class="moneybox"><view class="moneynum"><view class="num">{{listdata.money_num}}</view><view class="text">缴费金额(元）</view></view><view class="mini-icon"><image class="icon-img" src="{{listdata.image}}"></image></view></view></view><view class="paycard1"><block wx:for="{{listdata.order}}" wx:for-item="item" wx:for-index="index"><view class="infolist"><view class="text4">{{item.name}}</view><block wx:if="{{item.type!=1}}"><view class="text4">{{item.value}}</view></block><block wx:if="{{item.type==1}}"><view class="text5"><block wx:for="{{item.value}}" wx:for-item="items" wx:for-index="indexs"><view class="mini-text1">{{items}}</view></block></view></block></view></block></view></view></block><block wx:if="{{!listdata}}"><view class="bgbox"><view class="no_data_tip"><image class="no_data_img" style="width:400rpx;height:400rpx;margin:0 100rpx;" src="https://cloud.mrsqfw.com/static/images/house/no_data.png" mode="widthFix"></image><view class="no_tip_content">暂无账单</view></view></view></block><block wx:if="{{is_show==1}}"><view data-event-opts="{{[['tap',[['goEinvoicelist',['$event']]]]]}}" class="btn" style="{{(btn_style)}}" bindtap="__e">去开发票</view></block></view>