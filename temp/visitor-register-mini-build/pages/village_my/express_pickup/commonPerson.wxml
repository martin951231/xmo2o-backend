<view class="container"><view class="content-box"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{!no_data}}"><view class="card"><view class="card-bottom"><view class="title">{{"收件人："+item.recipient_name}}</view><view class="text">{{"收件电话："+item.recipient_phone}}</view><view class="text">{{"取件地址："+item.location}}</view><view hidden="{{!(!!item.remark)}}" class="text">{{"备 注："+item.remark}}</view></view><view class="btn-box"><button class="btn-edit" style="{{('-webkit-box-shadow:0rpx 4rpx 16rpx #b1b1b1;box-shadow:0rpx 4rpx 16rpx #b1b1b1;')}}" type="primary" data-event-opts="{{[['tap',[['editPerson',['edit','$0'],[[['listdata','',index]]]]]]]}}" bindtap="__e">编辑</button><button class="btn-del" style="{{('-webkit-box-shadow:0rpx 4rpx 16rpx #b1b1b1;box-shadow:0rpx 4rpx 16rpx #b1b1b1;')}}" type="primary" data-event-opts="{{[['tap',[['delPerson',['$0'],[[['listdata','',index,'id']]]]]]]}}" bindtap="__e">删除</button></view></view></block></block><view data-event-opts="{{[['tap',[['editPerson',['add']]]]]}}" class="independent_payment" bindtap="__e"><image class="independent-img" src="https://cloud.mrsqfw.com/static/wxapp/images/addexpress.png"></image></view><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="10425859-1" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{!listdata[0]}}"><view class="tip_box_no_data _div"><image class="no_data_img" src="https://cloud.mrsqfw.com/static/images/house/no_data.png"></image><view class="no_tip_content _div"><lang vue-id="10425859-2" keywords="列表是空的~" bind:__l="__l"></lang></view></view></block></view></view>