<view style="background:rgb(245, 245, 245);padding-top:15rpx;"><view class="container"><view class="center-card"><view class="card-list"><view class="card-name"><text style="color:red;">* </text>收件人</view><view class="card-text" style="width:100%;"><input style="padding-right:20rpx;width:100%;" type="text" maxlength="20" value="{{post.recipient_name}}" placeholder-style="font-size: 24rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="请填写收件人" data-event-opts="{{[['input',[['__set_model',['$0','recipient_name','$event',[]],['post']]]]]}}" bindinput="__e"/></view></view><view class="card-list"><view class="card-name"><text style="color:red;">* </text>收件电话</view><view class="card-text" style="width:100%;"><input style="padding-right:20rpx;width:100%;" type="text" maxlength="20" value="{{post.recipient_phone}}" placeholder-style="font-size: 24rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="请填写收件电话" data-event-opts="{{[['input',[['__set_model',['$0','recipient_phone','$event',[]],['post']]]]]}}" bindinput="__e"/></view></view><view data-event-opts="{{[['tap',[['chosePickupLocation',['$event']]]]]}}" class="card-list" bindtap="__e"><view class="card-name"><text style="color:red;">* </text>取件地址</view><view class="card-right" style="width:100%;"><view class="{{['card-text',post.location?'':'placeholder-css']}}" style="width:100%;">{{post.location||'请选择取件地址'}}</view><view class="right-icon"><image class="right-img" src="https://cloud.mrsqfw.com/static/wxapp/images/right.png"></image></view></view></view><view class="card-list" style="align-items:start;"><view class="card-name">备注</view><view class="card-text" style="width:calc(100% - 150rpx);position:relative;"><textarea style="padding:35rpx 0;width:100%;" placeholder-style="font-size: 24rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="请输入备注,限150字以内" maxlength="150" data-event-opts="{{[['input',[['__set_model',['$0','remark','$event',[]],['post']],['remarkInput',['$event']]]]]}}" value="{{post.remark}}" bindinput="__e"></textarea><text style="color:#ccc;width:100%;text-align:right;position:absolute;bottom:0;">{{''+(post.remark?$root.g0:0)+" / "+150+''}}</text></view></view><view class="card-list" style="border-bottom:0;"><view class="card-name">是否默认</view><switch checked="{{post.is_default==1?true:false}}" disabled="{{is_disabled}}" color="#2681f3" data-event-opts="{{[['change',[['isDefaultChange2',['$event']]]]]}}" bindchange="__e"></switch></view><button class="btn" type="primary" data-event-opts="{{[['tap',[['save']]]]}}" bindtap="__e">保存</button></view><view class="popups-box"><uni-popups class="vue-ref" style="width:100%;" vue-id="6b9aa5c2-1" type="bottom" data-ref="locationPopup" bind:__l="__l" vue-slots="{{['default']}}"><view class="active-box expressCompanyTitle"><view class="active-title">取件地址选择</view><view data-event-opts="{{[['tap',[['closeLocationPopup',['$event']]]]]}}" class="detail-icon" bindtap="__e"><image class="detail-img" src="https://cloud.mrsqfw.com/static/wxapp/images/guanbi.png"></image></view></view><view class="popups-list expressCompanyList"><block wx:for="{{pickupLocation}}" wx:for-item="items" wx:for-index="indexs" wx:key="indexs"><view data-event-opts="{{[['tap',[['selectPickupLocation',['$0','$1'],[[['pickupLocation','',indexs,'id']],[['pickupLocation','',indexs,'location']]]]]]]}}" class="text" bindtap="__e">{{items.location}}</view></block></view></uni-popups></view></view></view>