<view class="container"><view class="topbox"></view><view class="strip"></view><view class="paycard"><view class="moneybox"><view class="moneynum"><view class="num">{{listdata.money}}</view><view class="text">缴费金额(元）</view></view><view class="mini-icon"><image class="icon-img" src="{{listdata.image}}"></image></view></view></view><block wx:for="{{listdata.dataList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="paycard1"><block wx:for="{{item}}" wx:for-item="items" wx:for-index="indexs" wx:key="indexs"><view class="infolist"><view class="text4">{{items.name}}</view><block wx:if="{{items.type!=1}}"><view class="text4">{{items.value}}</view></block><block wx:if="{{items.type==1}}"><view class="text5"><block wx:for="{{items.value}}" wx:for-item="ite" wx:for-index="idx"><view class="mini-text1">{{ite}}</view></block></view></block></view></block></view></block><block wx:if="{{type=='property'||type=='custom_payment'}}"><button class="btn" style="{{(btn_style)}}" type="primary" data-event-opts="{{[['tap',[['btnpay',['$event']]]]]}}" bindtap="__e">{{btntext}}</button></block></view>