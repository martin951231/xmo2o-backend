<view class="container"><view class="container-box"><view class="title">请选择人员</view><view class="text">为了方便没有手机的家属也可正常使用人脸门禁，业主可以为家属上传照片</view><view class="select-box"><view data-event-opts="{{[['tap',[['gobindface',['$0'],['numlist.pigcms_id']]]]]}}" class="left-box" bindtap="__e"><view class="left"><view class="name">{{numlist.name}}</view><view class="left-icon"><image class="left-img" src="https://cloud.mrsqfw.com/static/wxapp/images/right.png"></image></view></view><block wx:if="{{numlist.is_bind_face==true}}"><view class="text1">已上传</view></block><block wx:if="{{numlist.is_bind_face==false}}"><view class="text1">未上传</view></block></view><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><view data-event-opts="{{[['tap',[['gobindface',['$0'],[[['listdata','',index,'pigcms_id']]]]]]]}}" class="left-box" bindtap="__e"><view class="left"><view class="name">{{item.name}}</view><view class="left-icon"><image class="left-img" src="https://cloud.mrsqfw.com/static/wxapp/images/right.png"></image></view></view><block wx:if="{{item.is_bind_face==true}}"><view class="text1">已上传</view></block><block wx:if="{{item.is_bind_face==false}}"><view class="text1">未上传</view></block></view></block></view></view></view>