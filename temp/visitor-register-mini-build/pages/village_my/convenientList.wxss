page{background-color:#fff}.container{margin:0;padding:0}.bgbox{position:fixed;top:0;left:0;bottom:0;right:0;display:flex;align-items:center;justify-content:center}.card{background:#f5f5f5;margin:30rpx;padding:30rpx;display:flex;border-radius:20rpx;flex-direction:row;justify-content:space-between;align-items:center}.no_tip_content{padding:30rpx 18%;color:#919191;font-size:24rpx;text-align:center}.left-icon{width:90rpx;height:90rpx;flex-shrink:0}.left-img{width:100%;height:100%;display:block}.right-card{display:flex;flex-direction:row;justify-content:space-between;align-items:center;width:100%;margin-left:15rpx}.text-box{display:flex;flex-direction:column;justify-content:center}.text-phone{display:flex;flex-direction:row;justify-content:flex-start;align-items:center}.right-text{display:flex;flex-direction:row;justify-content:flex-start}.phone-icon{width:30rpx;height:30rpx}.phone-img{display:block;width:100%;height:100%}.right-icon{width:30rpx;height:30rpx;margin-top:30rpx;margin-left:6rpx}.right-img{display:block;width:100%;height:100%}.title{font-size:30rpx;font-weight:700;font-stretch:normal;line-height:60rpx;letter-spacing:0}.text-left{font-size:24rpx;font-weight:400;font-stretch:normal;line-height:40rpx;letter-spacing:0;color:#999}.tips{font-size:20rpx;font-weight:400;font-stretch:normal;letter-spacing:0rpx;color:#fff;padding:0rpx 10rpx;background:#2182f3;border-radius:5rpx;margin-left:15rpx}.text{font-size:24rpx;font-weight:400;font-stretch:normal;line-height:90rpx;letter-spacing:0;color:#ccc;padding-left:100rpx}.tip_box_no_data{padding-top:calc((100vh - 288rpx - 21rpx)/2);font-size:28rpx;text-align:center}.tip_box_no_data .tip_title{width:100%;text-align:center}.no_data_img{width:374rpx;height:288rpx}