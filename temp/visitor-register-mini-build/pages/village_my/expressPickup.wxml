<view style="background:rgb(245, 245, 245);padding-top:15rpx;"><view class="container"><view class="top-card"><view class="top-left"><view class="top-tips">寄</view><view class="cell"></view><view class="bottom-tips">收</view></view><view class="top-right"><block wx:if="{{name&&phone&&address}}"><view data-event-opts="{{[['tap',[['goaddexpressinfo',['$event']]]]]}}" bindtap="__e"><view class="right-name">{{name+" "+phone}}</view><view class="right-adress">{{address}}</view></view></block><block wx:if="{{!name&&!phone&&!address}}"><input class="ipt-box" type="text" disabled="true" value="" placeholder-style="font-size: 28rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="请输入寄件人信息" data-event-opts="{{[['tap',[['goaddexpressinfo',['$event']]]]]}}" bindtap="__e"/></block><block wx:if="{{receivename&&receivephone&&receiveaddress}}"><view data-event-opts="{{[['tap',[['goaddexpressinfos',['$event']]]]]}}" bindtap="__e"><view class="right-name1">{{receivename+" "+receivephone}}</view><view class="right-adress1">{{receiveaddress}}</view></view></block><block wx:if="{{!receivename&&!receivephone&&!receiveaddress}}"><input class="ipt-box1" type="text" disabled="true" value="" placeholder-style="font-size: 28rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="请输入收件人信息" data-event-opts="{{[['tap',[['goaddexpressinfos',['$event']]]]]}}" bindtap="__e"/></block></view></view><view class="center-card"><view class="card-list"><view class="card-name">物件重量（kg）</view><view class="card-text"><uni-number-box vue-id="42884411-1" min="{{1}}" value="{{changevalue}}" data-event-opts="{{[['^change',[['change']]]]}}" bind:change="__e" bind:__l="__l"></uni-number-box></view></view><view data-event-opts="{{[['tap',[['chosetype',['$event']]]]]}}" class="card-list" bindtap="__e"><view class="card-name">物件类型</view><view class="card-right"><view class="card-text">{{goodstype}}</view><view class="right-icon"><image class="right-img" src="https://cloud.mrsqfw.com/static/wxapp/images/right.png"></image></view></view></view><view data-event-opts="{{[['tap',[['choseexpress',['$event']]]]]}}" class="card-list" bindtap="__e"><view class="card-name">快递公司</view><view class="card-right"><view class="card-text">{{expresstype}}</view><view class="right-icon"><image class="right-img" src="https://cloud.mrsqfw.com/static/wxapp/images/right.png"></image></view></view></view><view class="card-list"><view class="card-name">备注</view><view class="card-text" style="width:100%;"><input style="padding-right:20rpx;width:100%;text-align:right;" type="text" maxlength="20" value="{{remarks}}" placeholder-style="font-size: 24rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;" placeholder="填写备注，20字以内" data-event-opts="{{[['input',[['__set_model',['','remarks','$event',[]]]]]]}}" bindinput="__e"/></view></view><view class="card-list" style="border-bottom:0;"><view class="card-name">代发费用</view><view class="card-text" style="padding-right:20rpx;"><text style="color:#fa0101;">{{send_price}}</text>元</view></view></view><view class="bottom-text">{{"提交信息后，\n\t\t"+(config.config&&config.config.set_house_alias&&config.config.house_name?config.config.house_name:'小区')+"\n\t\t将及时通知相关快递公司上门取件收发快递。"}}</view><button class="btn" style="{{(btn_style)}}" type="primary" data-event-opts="{{[['tap',[['btnpay',['$event']]]]]}}" bindtap="__e">{{"提交（￥"+send_price+"）"}}</button><view><uni-popups class="vue-ref" style="width:100%;" vue-id="42884411-2" type="bottom" data-ref="popup" bind:__l="__l" vue-slots="{{['default']}}"><view class="active-box"><view class="active-title">物件类型</view><view data-event-opts="{{[['tap',[['closePopup',['$event']]]]]}}" class="detail-icon" bindtap="__e"><image class="detail-img" src="https://cloud.mrsqfw.com/static/wxapp/images/guanbi.png"></image></view></view><view class="popups-box"><block wx:for="{{express.goods_type}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selecttype',[index,'$0'],[[['express.goods_type','',index]]]]]]]}}" class="{{['chose-btn',num===index?'active':'']}}" bindtap="__e">{{item}}</view></block></view></uni-popups></view><view><uni-popups class="vue-ref" style="width:100%;" vue-id="42884411-3" type="bottom" data-ref="popups" bind:__l="__l" vue-slots="{{['default']}}"><view class="active-box expressCompanyTitle"><view class="active-title">快递公司选择</view><view data-event-opts="{{[['tap',[['closePopup',['$event']]]]]}}" class="detail-icon" bindtap="__e"><image class="detail-img" src="https://cloud.mrsqfw.com/static/wxapp/images/guanbi.png"></image></view></view><view class="popups-list expressCompanyList"><block wx:for="{{express.express_list}}" wx:for-item="items" wx:for-index="indexs" wx:key="indexs"><view data-event-opts="{{[['tap',[['selectexpress',['$0','$1'],[[['express.express_list','',indexs,'value']],[['express.express_list','',indexs,'name']]]]]]]}}" class="text" bindtap="__e">{{items.value}}</view></block></view></uni-popups></view></view></view>