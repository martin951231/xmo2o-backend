<view class="parking_lot data-v-12bd13f4"><view class="search_bar data-v-12bd13f4"><view class="search_view data-v-12bd13f4"><image src="../static/images/icon-search.png" mode="widthFix" class="data-v-12bd13f4"></image><input class="search_input data-v-12bd13f4" type="text" placeholder="请搜索停车场" data-event-opts="{{[['input',[['__set_model',['$0','park_name','$event',[]],['pageInfo']]]]]}}" value="{{pageInfo.park_name}}" bindinput="__e"/></view><view data-event-opts="{{[['tap',[['queryPark']]]]}}" class="search_btn data-v-12bd13f4" bindtap="__e">搜索</view></view><view class="map_container data-v-12bd13f4"><map style="width:100%;height:100%;" id="myMap" show-location="{{true}}" latitude="{{map.latitude}}" longitude="{{map.longitude}}" scale="{{map.scale}}" markers="{{markers}}" class="data-v-12bd13f4"></map></view><view class="parking_container data-v-12bd13f4"><block wx:if="{{tips}}"><view data-event-opts="{{[['tap',[['showList',['$event']]]]]}}" class="tips_box data-v-12bd13f4" bindtap="__e"><block wx:if="{{!isShowList}}"><image class="tip_img data-v-12bd13f4" src="{{tips.icon}}" mode></image></block><view class="flex_1 data-v-12bd13f4"><view class="top_box data-v-12bd13f4"><text class="text_1 data-v-12bd13f4">{{tips.title}}</text><image class="icon_box data-v-12bd13f4" style="{{(isShowList?'transform: rotate(180deg);':'')}}" src="../static/images/right_arr_black.png" mode></image></view><block wx:if="{{!isShowList}}"><text class="tips data-v-12bd13f4">{{tips.info}}</text></block></view></view></block><scroll-view style="padding-bottom:240rpx;height:500rpx;" scroll-y="true" class="data-v-12bd13f4"><block wx:for="{{parkingList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['chooseParking',['$0'],[[['parkingList','',index]]]]]]]}}" class="parking_list data-v-12bd13f4" catchtap="__e"><view data-event-opts="{{[['tap',[['goLinshi',['$event']]]]]}}" class="list_left data-v-12bd13f4" catchtap="__e"><image class="title_icon data-v-12bd13f4" src="../static/images/car_icon.png" mode></image><view class="flex_box_1 data-v-12bd13f4"><view class="top_title data-v-12bd13f4"><view class="title_txt data-v-12bd13f4">{{item.name}}</view></view><view class="address data-v-12bd13f4">{{''+item.address+''}}</view></view></view><view data-event-opts="{{[['tap',[['navigateToMap',['$0'],[[['parkingList','',index]]]]]]]}}" class="list_right data-v-12bd13f4" catchtap="__e"><image class="distance_icon data-v-12bd13f4" src="../static/images/distance_icon.png" mode="widthFix"></image><view class="distance_txt data-v-12bd13f4">{{item.distance}}</view></view></view></block></scroll-view></view></view>