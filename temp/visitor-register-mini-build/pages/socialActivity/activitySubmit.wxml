<view class="container data-v-6b5cf188"><block wx:if="{{info.session_id}}"><block class="data-v-6b5cf188"><view class="activity-card data-v-6b5cf188"><image class="activity-thumb data-v-6b5cf188" src="{{info.poster}}"></image><view class="activity-info data-v-6b5cf188"><text class="activity-title u-font-32 u-font-bold u-line-1 data-v-6b5cf188">{{info.name}}</text><view class="info-item u-flex u-row-start u-m-t-8 data-v-6b5cf188"><u-icon vue-id="f4cc6e16-1" name="clock" size="24" color="#999999" class="data-v-6b5cf188" bind:__l="__l"></u-icon><text class="u-font-24 u-m-l-8 u-gray data-v-6b5cf188">{{info.date_text}}</text></view><view class="info-item u-flex u-row-start u-m-t-4 data-v-6b5cf188"><u-icon vue-id="f4cc6e16-2" name="map" size="24" color="#999999" class="data-v-6b5cf188" bind:__l="__l"></u-icon><text class="u-font-24 u-m-l-8 u-gray data-v-6b5cf188">{{info.location}}</text></view></view></view><view class="ticket-card data-v-6b5cf188"><view class="ticket-row u-flex u-row-between u-row-center u-p-20 data-v-6b5cf188"><text class="u-font-28 u-font-bold data-v-6b5cf188">{{info.session_name+"（剩余"+info.num+"张）"}}</text><text class="u-font-28 data-v-6b5cf188">{{quantity+"人 / "+quantity+"张"}}</text></view><view class="amount-row u-flex u-row-between u-row-center u-p-20 data-v-6b5cf188"><text class="u-font-28 u-font-bold data-v-6b5cf188">单价</text><text class="amount-value u-font-36 u-font-bold data-v-6b5cf188">{{info.price}}</text></view></view><block wx:for="{{participants}}" wx:for-item="person" wx:for-index="index" wx:key="participant_key"><view class="notice-card data-v-6b5cf188"><view class="card-header u-flex u-row-center u-p-20 data-v-6b5cf188"><text class="u-font-28 u-font-bold data-v-6b5cf188">{{"参加人"+(index+1)+" · "+person.role}}</text></view><view class="user-form-box data-v-6b5cf188" style="font-size:30rpx;"><view class="u-flex item data-v-6b5cf188"><text class="u-flex-1 required data-v-6b5cf188">姓名</text><input disabled="{{person.name_locked}}" placeholder="请输入参加人姓名" data-event-opts="{{[['input',[['__set_model',['$0','user_name','$event',[]],[[['participants','participant_key',person.participant_key]]]]]]]}}" value="{{person.user_name}}" bindinput="__e" class="data-v-6b5cf188"/></view><block wx:if="{{person.is_external}}"><view class="u-flex item data-v-6b5cf188"><text class="u-flex-1 required data-v-6b5cf188">电话</text><text class="data-v-6b5cf188">{{person.phone}}</text></view></block><view class="u-flex item data-v-6b5cf188"><text class="u-flex-1 required data-v-6b5cf188">身份证号</text><input disabled="{{person.id_number_locked}}" maxlength="18" placeholder="请输入参加人身份证号" data-event-opts="{{[['input',[['__set_model',['$0','id_number','$event',[]],[[['participants','participant_key',person.participant_key]]]]]]]}}" value="{{person.id_number}}" bindinput="__e" class="data-v-6b5cf188"/></view><view class="u-flex item data-v-6b5cf188"><text class="u-flex-1 data-v-6b5cf188">来源</text><text class="data-v-6b5cf188">{{person.user_source}}</text></view></view></view></block><view class="u-p-20 u-font-24 u-gray data-v-6b5cf188">由您统一支付，每位参加人登录后均可查看自己的报名。需退款时由您申请整单退款。</view><block wx:if="{{info.form_question}}"><view class="notice-card data-v-6b5cf188"><view class="card-header u-flex u-row-center u-p-20 data-v-6b5cf188"><text class="u-font-28 u-font-bold data-v-6b5cf188">{{info.form_question.title}}</text></view><form-box vue-id="f4cc6e16-3" data-ref="formBox" class="data-v-6b5cf188 vue-ref" bind:__l="__l"></form-box></view></block><view class="notice-card data-v-6b5cf188"><view class="card-header u-flex u-row-center u-p-20 data-v-6b5cf188"><text class="u-font-28 u-font-bold data-v-6b5cf188">报名须知</text></view><view class="notice-content u-p-t-20 u-p-l-20 u-p-r-20 u-p-b-20 data-v-6b5cf188">{{info.notice}}</view></view><view class="submit-bar data-v-6b5cf188"><view data-event-opts="{{[['tap',[['handleSubmit',['$event']]]]]}}" class="submit-btn data-v-6b5cf188" style="{{'background-color:'+(mainColor)+';'}}" bindtap="__e"><text class="u-font-32 u-font-bold cr-fff data-v-6b5cf188">{{submitting?'提交中…':isFree?'确认报名':'确认支付'+totalAmount}}</text></view></view></block></block></view>