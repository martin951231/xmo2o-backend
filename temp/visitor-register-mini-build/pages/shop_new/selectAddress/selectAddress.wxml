<view><block wx:if="{{config}}"><view class="wrapper" style="{{('padding-top: '+header_rect.height+'px')}}"><view class="header" id="header"><view class="search-box border-b bg"><view hidden="{{config.many_city==0||config.config.map_config=='google'}}" data-event-opts="{{[['tap',[['selectCity',['$event']]]]]}}" bindtap="__e"><text class="iconfont icon-dingwei1 mr5"></text><text class="mr5">{{city_name}}</text><text class="iconfont icon-xiala mr5"></text></view><view class="search-input"><text class="iconfont icon-sousuo"></text><input placeholder="{{placeholder}}" placeholder-style="color:#999;" data-event-opts="{{[['focus',[['getFocus',['$event']]]],['input',[['inputAddress',['$event']]]]]}}" value="{{inputValue}}" bindfocus="__e" bindinput="__e"/><text class="iconfont icon-cha1" hidden="{{inputValue==''}}" data-event-opts="{{[['tap',[['clearInputValue',['$event']]]]]}}" bindtap="__e"></text></view></view><view class="current-adress bg"><view class="title"></view><view class="adress-box"><view data-name="current" data-event-opts="{{[['tap',[['selectAddress',['$event']]]]]}}" bindtap="__e"><block wx:if="{{current_address.address_name}}"><text>{{current_address.address_name}}</text></block><block wx:else><block><lang vue-id="a7a397b8-1" keywords="定位中" bind:__l="__l"></lang></block></block></view><button class="locate-btn" style="{{('color:'+mobile_head_color)}}" hover-class="locate-hover" open-type="{{openType}}" bindopensetting="relocation" data-event-opts="{{[['tap',[['relocation',['$event']]]]]}}" bindtap="__e"><text class="iconfont icon-locate mr5"></text><lang vue-id="a7a397b8-2" keywords="重新定位" bind:__l="__l"></lang></button></view></view></view><view class="adress-list bg"><block wx:if="{{$root.g0>0}}"><view class="title"><text class="iconfont icon-shouye mr5"></text><lang vue-id="a7a397b8-3" keywords="我的收货地址" bind:__l="__l"></lang><navigator class="add-address" style="{{('color:'+mobile_head_color)}}" url="/pages/my/address_add" hover-class="add-hover"><text class="iconfont icon-jia1"></text><lang vue-id="a7a397b8-4" keywords="新增地址" bind:__l="__l"></lang></navigator></view></block><block wx:for="{{myAddress}}" wx:for-item="item" wx:for-index="index" wx:key="adress_id"><view class="adress border-b" data-name="myAddress" data-index="{{index}}" data-event-opts="{{[['tap',[['selectAddress',['$event']]]]]}}" bindtap="__e"><view class="desc">{{item.show_address}}</view><view class="info"><text>{{item.name}}</text><block wx:if="{{item.sex==1}}"><block><lang vue-id="{{'a7a397b8-5-'+index}}" keywords="先生" bind:__l="__l"></lang></block></block><block wx:if="{{item.sex==2}}"><block><lang vue-id="{{'a7a397b8-6-'+index}}" keywords="女士" bind:__l="__l"></lang></block></block><text>{{item.phone_show}}</text></view></view></block><block wx:if="{{$root.g1}}"><view class="title"><text class="iconfont icon-dingwei1 mr5"></text><lang vue-id="a7a397b8-7" keywords="附近地址推荐" bind:__l="__l"></lang></view></block><block wx:for="{{nearbyAddress.pois}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="adress near border-b" data-name="nearbyAddress" data-tag="pois" data-index="{{index}}" data-event-opts="{{[['tap',[['selectAddress',['$event']]]]]}}" bindtap="__e"><text class="desc">{{item.name}}</text></view></block></view></view></block><view class="mask" hidden="{{!showMask}}" data-event-opts="{{[['tap',[['closeMask',['$event']]]]]}}" bindtap="__e"><view class="adress-list"><scroll-view style="height:100%;" scroll-y="true"><view><block wx:for="{{searchAddressList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="adress" data-name="searchAddressList" data-index="{{index}}" data-event-opts="{{[['tap',[['selectAddress',['$event']]]]]}}" bindtap="__e"><view class="desc"><block wx:for="{{item.name_arr}}" wx:for-item="i" wx:for-index="index2" wx:key="index2"><text class="{{[i.is_high?'active':'']}}">{{i.value}}</text></block><block wx:if="{{item.distance}}"><text class="distance">{{item.distance+"km"}}</text></block></view><view class="info"><text>{{item.address}}</text></view></view></block></view></scroll-view></view></view></view>