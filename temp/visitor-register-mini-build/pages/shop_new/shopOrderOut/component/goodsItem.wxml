<view class="goods-box data-v-833bca3a"><view class="title-box data-v-833bca3a"><view class="title u-text-wrap u-m-r-20 data-v-833bca3a"><text class="data-v-833bca3a">{{detailItem.name}}</text></view><view class="condition data-v-833bca3a" style="{{(detailItem.is_ready==0?'color:#FF4403':'color:#58BE6B')}}">{{''+detailItem.ready_name+''}}</view></view><view class="line data-v-833bca3a"><u-line vue-id="3d97400e-1" color="#F0F0F0" class="data-v-833bca3a" bind:__l="__l"></u-line></view><view class="information data-v-833bca3a"><view class="user-information data-v-833bca3a"><view class="name-left data-v-833bca3a">用户名称：</view><view class="name-right data-v-833bca3a"><text class="data-v-833bca3a">{{detailItem.username}}</text></view></view><view class="goods-information data-v-833bca3a"><view class="good-left data-v-833bca3a">商品名称：</view><view class="good-right data-v-833bca3a"><block wx:for="{{detailItem.goods_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="good-content data-v-833bca3a"><view class="name data-v-833bca3a"><text class="data-v-833bca3a">{{item.goods_name}}</text></view><view class="price data-v-833bca3a">{{''+detailItem.currency+item.goods_total_price+''}}</view></view></block></view></view></view><view class="line data-v-833bca3a"><u-line vue-id="3d97400e-2" color="#F0F0F0" class="data-v-833bca3a" bind:__l="__l"></u-line></view><block wx:if="{{detailItem.isMore}}"><view class="order-information data-v-833bca3a"><view class="order-dispaly data-v-833bca3a"><block wx:if="{{detailItem.dateline}}"><view class="order-box data-v-833bca3a"><view class="title data-v-833bca3a">出餐时间：</view><view class="num data-v-833bca3a">{{detailItem.dateline}}</view></view></block><view class="order-box data-v-833bca3a"><view class="title data-v-833bca3a">订单号：</view><view class="num data-v-833bca3a">{{detailItem.real_orderid}}</view></view><view class="order-box data-v-833bca3a"><view class="title data-v-833bca3a">下单时间：</view><view class="num data-v-833bca3a">{{detailItem.create_time}}</view></view></view><view class="predict-price u-m-t-60 data-v-833bca3a"><text class="text data-v-833bca3a">预计收入：</text><text class="price-text-predict data-v-833bca3a">{{detailItem.currency+detailItem.expect_settlement_money}}</text></view><view class="predict-price u-m-t-20 data-v-833bca3a"><text class="text data-v-833bca3a">客户实际支付：</text><text class="price-text-practical data-v-833bca3a">{{detailItem.currency+detailItem.go_pay_price}}</text></view></view></block><view data-event-opts="{{[['tap',[['onMore',['$event']]]]]}}" class="more data-v-833bca3a" style="{{(detailItem.is_ready==0?'':'border-radius:0 0 20rpx 20rpx;')}}" bindtap="__e"><text class="{{['iconfont','icon-xiangxia','open','data-v-833bca3a',!detailItem.isMore?'':'open_active']}}"></text></view><block wx:if="{{detailItem.is_ready==0}}"><view class="data-v-833bca3a"><view class="line data-v-833bca3a"><u-line vue-id="3d97400e-3" color="#F0F0F0" class="data-v-833bca3a" bind:__l="__l"></u-line></view><view class="btn data-v-833bca3a"><button type="default" data-event-opts="{{[['tap',[['onConfirm',['$event']]]]]}}" bindtap="__e" class="data-v-833bca3a">确认出餐</button></view></view></block></view>