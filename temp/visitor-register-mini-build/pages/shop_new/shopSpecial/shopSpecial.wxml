<block wx:if="{{pageInfo}}"><view class="special-content" style="{{('background:'+pageInfo.bgcolor)}}"><view class="top-img"><image class="img" src="{{pageInfo.image}}" mode="widthFix"></image></view><view class="coupon-list"><block wx:for="{{pageInfo.couponArr}}" wx:for-item="item" wx:for-index="index" wx:key="id"><view data-event-opts="{{[['tap',[['getCoupon',[index]]]]]}}" class="coupon-item" bindtap="__e"><view class="name-box"><image class="img" src="{{item.img}}" mode="aspectFill"></image><text class="name">{{item.name}}</text></view><view class="discount-box"><view class="discont"><block wx:if="{{item.is_discount==1}}"><block><view class="red"><text class="num">{{item.discount_value}}</text>折</view></block></block><block wx:if="{{item.discount!=0}}"><block><view class="red">{{currency}}<text class="num">{{item.discount}}</text></view></block></block><view class="btn-box"><block wx:if="{{item.can}}"><view class="btn receive">立即领取</view></block><block wx:if="{{!item.can&&item.is_had}}"><view class="btn use">去使用</view></block><block wx:if="{{!item.can&&!item.is_had}}"><view class="btn end">已抢完</view></block></view></view><view class="gray"><lang vue-id="{{'1833248e-1-'+index}}" keywords="满X1可用" X1="{{item.order_money}}" unit="yuanSymbol" chineseTxt="{{'满'+(currency+item.order_money)+'可用'}}" bind:__l="__l"></lang></view></view></view></block></view><block wx:if="{{$root.g0>1}}"><view class="tab-title-wrapper"><view class="{{['tab-title '+(isTitleFixed?'fixed':'')]}}"><block wx:for="{{pageInfo.product_list}}" wx:for-item="item" wx:for-index="index" wx:key="name"><view data-event-opts="{{[['tap',[['clickTitle',[index]]]]]}}" class="item" style="{{('color:'+(activeIndex==index?tabTitleColor:''))}}" bindtap="__e"><block wx:if="{{activeIndex==index}}"><text class="iconfont icon-dingwei1"></text></block><text>{{item.name}}</text></view></block></view></view></block><view class="shop-list"><block wx:for="{{pageInfo.product_list}}" wx:for-item="typeList" wx:for-index="index" wx:key="index"><view class="type-content"><view class="title"><text class="txt">{{typeList.name}}</text></view><block wx:for="{{typeList.store_list.store_list}}" wx:for-item="shop" wx:for-index="__i0__" wx:key="store_id"><shop-item class="item" vue-id="{{'1833248e-2-'+index+'-'+__i0__}}" shop="{{shop}}" showRange="{{true}}" showTime="{{lng==0?false:true}}" bind:__l="__l"></shop-item></block><view class="loading-txt"><block wx:if="{{typeList.store_list.has_more&&!typeList.store_list.is_loading}}"><text data-event-opts="{{[['tap',[['getMoreShop',[index]]]]]}}" class="txt" bindtap="__e">点击加载更多</text></block><block wx:if="{{typeList.store_list.has_more&&typeList.store_list.is_loading}}"><text class="txt">正在加载...</text></block><block wx:if="{{!typeList.store_list.has_more}}"><text class="txt">没有更多了哦~</text></block></view></view></block></view><userinfo vue-id="1833248e-3" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo></view></block>