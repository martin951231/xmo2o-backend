<view class="count-wrapper"><block wx:if="{{(soldOut||isClose)&&!hasSpec}}"><block><block wx:if="{{isClose}}"><text data-event-opts="{{[['tap',[['shopCloseToast']]]]}}" class="sold-out iconfont icon-jia" catchtap="__e"></text></block><block wx:if="{{!isClose&&soldOut}}"><text data-event-opts="{{[['tap',[['shopSoldOutToast']]]]}}" class="sold-out iconfont icon-jia" style="{{'color:'+(mainColor)+';'}}" catchtap="__e"></text></block></block></block><block wx:else><block><block wx:if="{{hasFormat&&!isGoodsPage}}"><block><block wx:if="{{goodsType!='recommend'}}"><view data-event-opts="{{[['tap',[['clickSpec',['$event']]]]]}}" class="spec-add" style="{{'background:'+(isClose?'#999':mainColor)+';'}}" catchtap="__e"><block wx:if="{{goodsToalNum>0}}"><text class="num">{{goodsToalNum}}</text></block><lang vue-id="793e3470-1" keywords="选规格" bind:__l="__l"></lang></view></block><block wx:else><view data-event-opts="{{[['tap',[['clickSpec',['$event']]]]]}}" class="count-btn" catchtap="__e"><text class="iconfont icon-jia" style="{{'color:'+(isClose?'#999':mainColor)+';'}}"></text></view></block></block></block><block wx:if="{{isGoodsPage&&goodsNum==0}}"><view data-event-opts="{{[['tap',[['add',['$event']]]]]}}" class="{{['add-cart',[(addCartStyle==1)?'add-cart-1':'']]}}" style="{{'background:'+(isClose?'#999':mainColor)+';'}}" catchtap="__e"><text class="iconfont icon-jia2"></text><lang vue-id="793e3470-2" keywords="加入购物车" bind:__l="__l"></lang></view></block><block wx:if="{{goodsNum>0&&isGoodsPage}}"><view class="count-btn"><block wx:if="{{goodsNum>0&&goodsType!='recommend'}}"><text data-event-opts="{{[['tap',[['sub',['$event']]]]]}}" class="iconfont icon-jian" style="{{('color:'+mainColor)}}" catchtap="__e"></text></block><block wx:if="{{goodsNum>0&&goodsType!='recommend'}}"><text class="num">{{goodsNum}}</text></block><text data-event-opts="{{[['tap',[['add',['$event']]]]]}}" class="{{['iconfont icon-jia '+(soldOut||isClose?'active':'')]}}" style="{{('color:'+mainColor)}}" catchtap="__e"></text></view></block><block wx:if="{{!isGoodsPage&&!hasFormat}}"><view class="count-btn"><block wx:if="{{goodsNum>0&&goodsType!='recommend'}}"><text data-event-opts="{{[['tap',[['sub',['$event']]]]]}}" class="iconfont icon-jian" style="{{('color:'+mainColor)}}" catchtap="__e"></text></block><block wx:if="{{goodsNum>0&&goodsType!='recommend'}}"><text class="num">{{goodsNum}}</text></block><text data-event-opts="{{[['tap',[['add',['$event']]]]]}}" class="{{['iconfont icon-jia '+(soldOut||isClose?'active':'')]}}" style="{{('color:'+mainColor)}}" catchtap="__e"></text></view></block></block></block></view>