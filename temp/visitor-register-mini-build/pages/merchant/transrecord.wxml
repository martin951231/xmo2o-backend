<view class="container"><block wx:if="{{$root.g0>0}}"><block><block wx:for="{{record_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block><view class="jy_xq_box" data-index="{{index}}" data-event-opts="{{[['tap',[['showDetail',['$event']]]]]}}" bindtap="__e"><view class="jy jy_zong"><view class="left">{{item.time_txt}}</view><view class="right margin_r">{{item.desc}}</view></view><view class="{{['jy_xq '+(showIndex!=index?'hide':'')]}}"><block wx:if="{{item.money_add>0}}"><view class="jy_jl"><view class="left"><lang vue-id="{{'7390903b-1-'+index}}" keywords="余额增加" bind:__l="__l"></lang>：</view><view class="right margin_r">{{currency+item.money_add}}</view></view></block><block wx:if="{{item.money_use>0}}"><view class="jy_jl"><view class="left"><lang vue-id="{{'7390903b-2-'+index}}" keywords="余额减少" bind:__l="__l"></lang>：</view><view class="right margin_r">{{currency+item.money_use}}</view></view></block><block wx:if="{{item.score_add>0}}"><view class="jy_jl"><view class="left"><lang vue-id="{{'7390903b-3-'+index}}" keywords="积分增加" bind:__l="__l"></lang>：</view><view class="right margin_r">{{item.score_add+"分"}}</view></view></block><block wx:if="{{item.score_use>0}}"><view class="jy_jl"><view class="left"><lang vue-id="{{'7390903b-4-'+index}}" keywords="积分减少" bind:__l="__l"></lang>：</view><view class="right margin_r">{{item.score_use+"分"}}</view></view></block><block wx:if="{{item.coupon_add>0}}"><view class="jy_jl"><view class="left"><lang vue-id="{{'7390903b-5-'+index}}" keywords="优惠券增加" bind:__l="__l"></lang>：</view><view class="right margin_r">{{currency+item.coupon_add}}</view></view></block><block wx:if="{{item.coupon_use>0}}"><view class="jy_jl"><view class="left"><lang vue-id="{{'7390903b-6-'+index}}" keywords="优惠券减少" bind:__l="__l"></lang>：</view><view class="right margin_r">{{currency+item.coupon_use}}</view></view></block></view></view></block></block></block></block><block wx:else><block wx:if="{{isLoading==false}}"><block><view class="noneList"><lang vue-id="7390903b-7" keywords="暂无交易记录" bind:__l="__l"></lang></view></block></block></block></view>