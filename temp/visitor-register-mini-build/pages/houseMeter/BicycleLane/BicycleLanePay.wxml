<view class="container data-v-5fe2e7d0"><view class="top_box data-v-5fe2e7d0" style="{{('background-color:'+actcolor)}}"></view><view class="card_box data-v-5fe2e7d0"><text class="village_name data-v-5fe2e7d0">{{villageInfo.village_name}}</text><text class="address_name data-v-5fe2e7d0">{{villageInfo.roomName}}</text><view class="flex_text data-v-5fe2e7d0"><text class="text_1 data-v-5fe2e7d0">{{"非机动车卡："+cardInfo.nmv_card}}</text><text class="text_1 data-v-5fe2e7d0">{{"到期时间："+cardInfo.expiration_time}}</text></view><view class="line data-v-5fe2e7d0"></view><text class="text_2 data-v-5fe2e7d0">请选择您要缴纳的停车费周期</text><view class="flex_box data-v-5fe2e7d0"><block wx:for="{{chargeInfo}}" wx:for-item="item" wx:for-index="index"><view data-event-opts="{{[['tap',[['selectTime',['$0',index],[[['chargeInfo','',index]]]]]]]}}" class="{{['item_box','data-v-5fe2e7d0',num==index?'item_box_active':'']}}" bindtap="__e">{{item.nmv_charge_name}}</view></block></view><view class="flex_row data-v-5fe2e7d0"><text class="text_3 data-v-5fe2e7d0">预计到期时间</text><text class="text_3 data-v-5fe2e7d0">{{selectInfo.expect_expiration_time}}</text></view><view class="flex_row data-v-5fe2e7d0"><text class="text_3 data-v-5fe2e7d0">缴费总额</text><text class="text_4 data-v-5fe2e7d0">{{"￥"+selectInfo.price}}</text></view><view data-event-opts="{{[['tap',[['gopay',['$event']]]]]}}" class="btn data-v-5fe2e7d0" bindtap="__e">去支付</view><view class="tips data-v-5fe2e7d0"><text class="tips_text data-v-5fe2e7d0">＊</text><text class="data-v-5fe2e7d0">提示：关注微信公众号，了解缴费信息</text></view></view></view>