<view class="venue_detail data-v-53f6f114"><userinfo vue-id="869afca4-1" id="user" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" class="data-v-53f6f114" bind:__l="__l"></userinfo><view class="top_img data-v-53f6f114"><block wx:if="{{$root.g0}}"><swiper class="swiper data-v-53f6f114" indicator-dots="{{true}}" autoplay="{{true}}" interval="{{3000}}" duration="{{1000}}"><block wx:for="{{VenueDetail.img}}" wx:for-item="item" wx:for-index="index" wx:key="index"><swiper-item class="swiper_item data-v-53f6f114"><image src="{{item}}" mode="widthFix" class="data-v-53f6f114"></image></swiper-item></block></swiper></block><block wx:else><image src="{{VenueDetail.img[0]}}" mode="widthFix" class="data-v-53f6f114"></image></block></view><block wx:if="{{VenueDetail.status*1==0}}"><view class="goods_tip data-v-53f6f114"><view class="tip_title data-v-53f6f114">温馨提示</view><view class="tip_content data-v-53f6f114">{{VenueDetail.close_msg}}</view></view></block><block wx:if="{{VenueDetail.status*1==0}}"><view class="goods_tip_padding data-v-53f6f114"></view></block><view class="venue_con data-v-53f6f114"><view class="con_title data-v-53f6f114">{{VenueDetail.title?VenueDetail.title:'暂无'}}</view><view class="con_type data-v-53f6f114">{{VenueDetail.classify_name?VenueDetail.classify_name:'暂无'}}</view><view class="con_time data-v-53f6f114">{{"营业时间： "+(VenueDetail.work_txt?VenueDetail.work_txt:'暂无')}}</view></view><view class="venue_contact data-v-53f6f114"><view class="contact_left data-v-53f6f114"><view class="left_title data-v-53f6f114">{{VenueDetail.adress?VenueDetail.adress:'暂无'}}</view><view class="left_content data-v-53f6f114"><view class="content_name data-v-53f6f114">{{VenueDetail.contacts?VenueDetail.contacts:'暂无'}}</view><view class="content_phone data-v-53f6f114">{{VenueDetail.phone?VenueDetail.phone:'暂无'}}</view></view></view><view class="contact_right data-v-53f6f114"><view class="car_icon data-v-53f6f114"><image src="../static/images/venue_car.png" mode="aspectFill" data-event-opts="{{[['tap',[['goChargeAddress',['$0','$1'],['VenueDetail.lat','VenueDetail.long']]]]]}}" bindtap="__e" class="data-v-53f6f114"></image></view><view class="phone_icon data-v-53f6f114"><image src="../static/images/venue_phone.png" mode="aspectFill" data-event-opts="{{[['tap',[['phoneTo',['$0'],['VenueDetail.phone']]]]]}}" bindtap="__e" class="data-v-53f6f114"></image></view></view></view><view class="venue_desc data-v-53f6f114"><view class="desc_title data-v-53f6f114">场馆介绍</view><view class="desc_content data-v-53f6f114"><rich-text nodes="{{newHtmlStr}}" class="data-v-53f6f114"></rich-text></view></view><view class="venue_bottom data-v-53f6f114"><view class="bottom_collect data-v-53f6f114"><view data-event-opts="{{[['tap',[['switchCollect',['$event']]]]]}}" class="collect_icon data-v-53f6f114" bindtap="__e"><image src="{{VenueDetail.is_user_collect*1==1?collect:nocollect}}" mode="aspectFit" class="data-v-53f6f114"></image></view><view class="collect_text data-v-53f6f114">收藏</view></view><view data-event-opts="{{[['tap',[['navigateTomy']]]]}}" class="bottom_right_btn data-v-53f6f114" style="{{'background:'+(VenueDetail.is_appoint*1==0?'#999999':'#2681F3')+';'}}" bindtap="__e"><view class="btn_icon data-v-53f6f114"><image src="../static/images/venue_yuyue.png" mode="aspectFit" class="data-v-53f6f114"></image></view><view class="btn_text data-v-53f6f114">预约场馆</view></view></view></view>