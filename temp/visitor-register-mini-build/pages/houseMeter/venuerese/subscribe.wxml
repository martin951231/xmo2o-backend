<view class="subscribe data-v-79fead3c"><block wx:if="{{!showState}}"><view class="yuyue_time data-v-79fead3c"><view class="time_title data-v-79fead3c"><view class="title_txt data-v-79fead3c">预约时间</view><view class="title_icon data-v-79fead3c"><image src="../static/images/icon_1.png" mode="aspectFill" class="data-v-79fead3c"></image></view></view><block wx:if="{{!showState}}"><view class="time_choose data-v-79fead3c"><picker mode="date" fields="day" start="{{subscribeParams.start_day}}" end="{{subscribeParams.end_day}}" data-event-opts="{{[['change',[['onConfirm',['$event']]]]]}}" bindchange="__e" class="data-v-79fead3c"><block wx:if="{{dateChoose==''}}"><view class="choose_txt data-v-79fead3c">请选择时间</view></block><block wx:if="{{dateChoose==''}}"><view class="choose_icon data-v-79fead3c"><image src="../static/images/right_arr.png" mode="aspectFill" class="data-v-79fead3c"></image></view></block><block wx:if="{{dateChoose!=''}}"><view class="choose_active data-v-79fead3c">{{dateChoose}}</view></block></picker></view></block></view></block><block wx:if="{{!showState}}"><view class="yuyue_date data-v-79fead3c"><view class="date_title data-v-79fead3c"><view class="date_txt data-v-79fead3c">预约时间段</view><view class="date_icon data-v-79fead3c"><image src="../static/images/icon_1.png" mode="aspectFill" class="data-v-79fead3c"></image></view></view><block wx:if="{{$root.g0==0}}"><view class="no_time_tip data-v-79fead3c"> 请选择一个合适的日期 </view></block><block wx:else><view class="time_slot data-v-79fead3c"><block wx:for="{{timeList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['chooseSlot',['$0',index],[[['timeList','',index]]]]]]]}}" class="{{['slot_list','data-v-79fead3c',index==currentIndex?'active':'']}}" bindtap="__e">{{item.time+"（已约 "+item.appoint_num+"/总数"+item.appoint_total+"）"}}</view></block></view></block></view></block><block wx:if="{{!showState}}"><view class="yuyue_remark data-v-79fead3c"><view class="remark_title data-v-79fead3c"><view class="title_txt data-v-79fead3c">备注</view></view><view class="remark_content data-v-79fead3c"><textarea placeholder="请填写备注" data-event-opts="{{[['input',[['__set_model',['','yuyue_remark','$event',[]]]]]]}}" value="{{yuyue_remark}}" bindinput="__e" class="data-v-79fead3c"></textarea></view></view></block><block wx:if="{{!showState}}"><view class="yuyue_bottom data-v-79fead3c"><view data-event-opts="{{[['tap',[['confirm',['$event']]]]]}}" class="yuyue_btn data-v-79fead3c" bindtap="__e">确定</view></view></block><block wx:if="{{showState}}"><view class="yuyue_state data-v-79fead3c"><view class="state_img data-v-79fead3c"><image src="{{statusList[status].state_img}}" mode="aspectFill" class="data-v-79fead3c"></image></view><view class="state_txt data-v-79fead3c">{{statusList[status].text}}</view><view class="state_tip data-v-79fead3c">{{statusList[status].statetip}}</view><view class="state_bottom data-v-79fead3c"><view data-event-opts="{{[['tap',[['goback',['$event']]]]]}}" class="state_btn data-v-79fead3c" bindtap="__e">{{statusList[status].btnText}}</view></view></view></block></view>