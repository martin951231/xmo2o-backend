page{background-color:#fff}.container{margin:0;padding:0;display:flex;width:100%;flex-direction:row;overflow:hidden;background:#fff}.leftcell{width:100%;padding-top:20rpx;padding-bottom:180rpx;margin-left:50rpx;border-left:4rpx solid #f8fafc}.bigbox{display:flex;flex-direction:row;justify-content:space-between;width:100%;margin-top:30rpx}.dot{width:10rpx;height:10rpx;border:10rpx solid #6ca5ff;border-radius:15rpx;margin-left:-18rpx;flex-shrink:0;margin-top:45rpx}.dots{width:10rpx;height:10rpx;border:10rpx solid #ccc;border-radius:15rpx;margin-left:-18rpx;flex-shrink:0;margin-top:45rpx}.minibox{display:flex;flex-direction:column;width:100%;height:100%;justify-content:space-between;box-shadow:0 4rpx 13rpx 0rpx rgba(108,165,255,.14);border-radius:20rpx;margin:0 30rpx}.topbox{width:100%;display:flex;flex-direction:row;justify-content:space-between;align-items:center;border-radius:20rpx 20rpx 0rpx 0rpx;background:#f8fafc}.text{font-size:36rpx;font-weight:400;font-stretch:normal;line-height:60rpx;letter-spacing:0rpx;color:#333;margin-left:20rpx}.time{font-size:24rpx;font-weight:400;font-stretch:normal;line-height:100rpx;letter-spacing:0rpx;color:#aeaeae;margin-right:20rpx}.bottombox{width:100%;display:flex;flex-direction:column;justify-content:flex-start;background:#fff;padding:20rpx 0rpx;border-radius:20rpx}.content{font-size:26rpx;font-weight:400;font-stretch:normal;line-height:50rpx;letter-spacing:0rpx;color:#999;margin-bottom:5rpx;border-radius:20rpx;margin:0rpx 20rpx;word-break:break-all;text-align:justify}.imgarr{display:flex;flex-direction:row;justify-content:flex-start;flex-wrap:wrap}.imgbox{width:170rpx;height:170rpx;margin-left:20rpx}.imgbox:nth-of-type(n+4){width:170rpx;height:170rpx;display:block;margin-top:20rpx}.img-icon{width:100%;height:100%}