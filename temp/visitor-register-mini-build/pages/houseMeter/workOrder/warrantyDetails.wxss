.warranty_details .top_con{position:fixed;width:100%;top:0;left:0;height:100rpx;display:flex;align-items:center;padding:0 30rpx;color:#fff;background-color:#4d80fd;font-size:27rpx;z-index:99}.warranty_details .warranty_list{padding-top:100rpx;width:100%;display:flex;flex-direction:column;align-items:center;padding-bottom:20rpx}.warranty_details .warranty_list .warranty_item{width:80%;padding:20rpx 60rpx;background-color:#fff;border-radius:10rpx;margin-top:20rpx;font-size:27rpx}.warranty_details .warranty_list .warranty_item .name_con{display:flex;align-items:center;-webkit-transform:translateX(-30rpx);transform:translateX(-30rpx)}.warranty_details .warranty_list .warranty_item .name_con .left_icon{width:20rpx;height:20rpx;background-color:#666;border-radius:50rpx}.warranty_details .warranty_list .warranty_item .name_con .right_name{color:#333;margin-left:10rpx}.warranty_details .warranty_list .warranty_item .props_con{color:#999}.warranty_details .no_data{width:100%;height:300rpx;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:#999}.warranty_details .not_more{width:100%;display:flex;justify-content:center;font-size:24rpx;font-weight:500;color:#999;padding:20rpx 0}