<block wx:if="{{tipsInfo.is_need_popup_tips==1}}"><view class="privacy_agreement data-v-5e1db70c"><view class="privacy_modal data-v-5e1db70c"><view class="modal_title data-v-5e1db70c">温馨提示</view><view class="line data-v-5e1db70c"></view><view class="content data-v-5e1db70c"><view class="text data-v-5e1db70c">{{tipsInfo.msg_1tips}}</view><view class="text data-v-5e1db70c">{{tipsInfo.msg_2tips}}</view><block wx:if="{{tipsInfo.phone}}"><view data-event-opts="{{[['tap',[['clickPhone',['$event']]]]]}}" class="agreement data-v-5e1db70c" bindtap="__e">{{tipsInfo.phone}}</view></block></view><view class="bottom_btn data-v-5e1db70c"><view data-event-opts="{{[['tap',[['cancel',['$event']]]]]}}" class="left_cancel data-v-5e1db70c" bindtap="__e">取消关闭</view><view data-event-opts="{{[['tap',[['confirm',['$event']]]]]}}" class="right_confirm data-v-5e1db70c" bindtap="__e">返回缴费页面</view></view></view></view></block>