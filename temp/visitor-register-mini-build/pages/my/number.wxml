<block wx:if="{{config&&config.config}}"><view class="container"><form data-event-opts="{{[['submit',[['formSubmit',['$event']]]]]}}" bindsubmit="__e"><view class="verification"><view class="clearfix list"><view class="fl">{{userInfo.showPhone}}</view><view class="fr"><block wx:if="{{judge>0}}"><view data-event-opts="{{[['tap',[['loop',['$event']]]]]}}" class="box receive" style="{{('background:'+config.config.mobile_head_color)}}" bindtap="__e"><lang vue-id="1115ba83-1" keywords="获得验证码" bind:__l="__l"></lang></view></block><block wx:else><view class="box send_out"><lang vue-id="1115ba83-2" keywords="已发送" bind:__l="__l"></lang>(<text class="second">{{time}}</text>s) </view></block></view></view><view class="list"><input type="number" name="code" placeholder="{{placeholder}}" maxlength="4" value="{{userInfo.code}}"/></view></view><view class="button"><button style="{{('background:'+config.config.mobile_head_color)}}" formType="submit"><lang vue-id="1115ba83-3" keywords="下一步 绑定新手机" bind:__l="__l"></lang></button></view></form><block wx:if="{{!config.config.international_phone&&(only_app_phone==2||only_app_phone==3)}}"><view class="wxapp-button"><button size="mini" plain="{{true}}" open-type="getPhoneNumber" data-event-opts="{{[['getphonenumber',[['getUserWxPhone',['$event']]]]]}}" bindgetphonenumber="__e"><lang vue-id="1115ba83-4" keywords="手机号快捷绑定" bind:__l="__l"></lang></button></view></block><userinfo vue-id="1115ba83-5" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo></view></block>