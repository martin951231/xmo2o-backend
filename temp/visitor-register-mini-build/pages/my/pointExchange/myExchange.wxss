.content{min-height:100vh;padding-bottom:20rpx}.content .list-box{margin:20rpx}.content .list-box .list-item{background:#fff;border-radius:10rpx;margin-bottom:20rpx;padding:25rpx 0;position:relative;overflow:hidden}.content .list-box .list-item .status-img{position:absolute;bottom:0;right:0}.content .list-box .list-item .box1{display:flex;padding:0 25rpx}.content .list-box .list-item .box1 .right{margin-left:30rpx;display:flex;flex-direction:column}.content .list-box .list-item .box1 .right .text{margin-bottom:10rpx}.content .list-box .list-item .box1 .right .title{font-size:30rpx;font-weight:500;color:#1d1d1d;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical}.content .list-box .list-item .box1 .right .num{font-size:24rpx;font-weight:500;color:#666}.content .list-box .list-item .box1 .right .addres{font-size:24rpx;font-weight:500;color:#1a86f9;overflow:hidden;text-overflow:ellipsis;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical}.content .list-box .list-item .box1 .right .time{font-size:24rpx;font-weight:400;color:#9f9f9f}.content .list-box .list-item .footer{border-top:1rpx solid #efefef;margin-top:20rpx;display:flex;justify-content:flex-end;align-items:center;padding-top:24rpx}.content .list-box .list-item .footer .btn{display:inline-block;background:linear-gradient(90deg,#128dfe,#50c7ff);border-radius:25rpx;color:#fff;font-size:24rpx;font-weight:400;margin-right:20rpx;padding:10rpx 20rpx}.content .mores{margin:30rpx 0}