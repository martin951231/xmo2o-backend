<view class="container"><form data-event-opts="{{[['submit',[['formSubmit',['$event']]]]]}}" bindsubmit="__e"><view class="verification"><view class="clearfix list"><view class="fl">{{userInfo.showPhone}}</view><view class="fr"><block wx:if="{{judge>0}}"><view data-event-opts="{{[['tap',[['loop',['$event']]]]]}}" class="box receive" style="{{('background:'+main_color)}}" bindtap="__e"><lang vue-id="f37b5f7a-1" keywords="获得验证码" bind:__l="__l"></lang></view></block><block wx:else><view class="box send_out"><lang vue-id="f37b5f7a-2" keywords="已发送" bind:__l="__l"></lang>(<text class="second">{{time}}</text>s) </view></block></view></view><view class="list"><input type="number" name="captcha" placeholder="{{placeholder}}" maxlength="4" value="{{userInfo.captcha}}"/></view><view class="list"><input type="password" name="password" placeholder="{{$root.m0}}" maxlength="6" value="{{userInfo.password}}"/></view></view><view class="button"><button style="{{('background:'+main_color)}}" formType="submit"><lang vue-id="f37b5f7a-3" keywords="确认修改" bind:__l="__l"></lang></button></view></form><userinfo vue-id="f37b5f7a-4" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo></view>