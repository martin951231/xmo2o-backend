.verification{background:#fff;margin:20rpx 0;border-bottom:#f1f1f1 2rpx solid;border-top:#f1f1f1 2rpx solid}.verification .list{border-bottom:#f1f1f1 2rpx solid;padding:24rpx 20rpx}.verification .list:last-child{border-bottom:none}.verification .box{padding:6rpx 30rpx;color:#fff}.verification .box button{margin:0;padding:0;background:#06c1ae;color:#fff;line-height:1.5;font-size:28rpx}.verification .box button:after{border:none}.verification .receive{background:#06c1ae;white-space:nowrap}.verification .send_out{background:#ccc}.button button{background:#06c1ae;color:#fff;margin:0 20rpx;font-size:32rpx;line-height:80rpx;text-align:center;border-radius:20rpx}