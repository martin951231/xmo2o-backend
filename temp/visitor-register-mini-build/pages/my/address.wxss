page{height:100%}.container{height:100%}.address_item{margin-bottom:20rpx;padding:20rpx 24rpx;background-color:#fff;position:relative}.address_item .radio{display:none}.address_item.active{padding-left:120rpx}.address_item.active .unradio{position:absolute;display:block;content:" ";width:50rpx;height:50rpx;border:2rpx solid #e1e1e1;left:35rpx;top:50%;margin-top:-25rpx;border-radius:100%;color:#fff;text-align:center;vertical-align:middle}.address_item.active .radio{background-color:#2bb2a3;border:none}.address_item.active .radio:after{content:"✓";font-size:30rpx}.address_item view{line-height:1.6}.address_item{color:#333}.address_item .title{color:#868686}.address_item view .fr{color:#06c1bb}.btn-box{padding-bottom:30rpx}.empty_box{text-align:center;height:45%;box-sizing:border-box;display:flex;align-items:center;width:100%;justify-content:center;padding-top:200rpx;padding-bottom:60rpx}.empty_box .iconfont{font-size:200rpx;color:#ccc}.empty_box .txt{font-size:14px;color:#aaa}