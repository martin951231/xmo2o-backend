.address{padding-bottom:140rpx;box-sizing:border-box}.address .address-item{border-bottom:1rpx solid #f6f6f6;background:#fff;padding:10px}.address .address-item .address-item-center{flex:1;margin-left:5rpx}.address .address-item .address-item-center .address-item-center-top{display:flex;align-items:center;flex-wrap:wrap}.address .address-item .address-item-center .address-item-center-top .name{font-size:28rpx;font-weight:bolder;margin-right:54rpx}.address .address-item .address-item-center .address-item-center-top .phone{font-size:28rpx;font-weight:bolder}.address .address-item .address-item-center .address-item-center-top .default{font-size:18rpx;width:58rpx;height:35rpx;line-height:35rpx;border-radius:4rpx;text-align:center;background:#06c2ae;margin-left:12rpx;color:#fff}.address .address-item .address-item-center .address-item-center-top .home{font-size:18rpx;margin-left:12rpx;width:58rpx;height:35rpx;line-height:35rpx;border-radius:4rpx;text-align:center;background:#5c86f7;color:#fff}.address .address-item .address-item-center .address-item-center-top .company{font-size:18rpx;margin-left:12rpx;width:58rpx;height:35rpx;line-height:35rpx;border-radius:4rpx;text-align:center;background:#00caff;color:#fff}.address .address-item .address-item-center .address-item-center-bottom{margin-top:.25rpx;color:#505050;font-size:22rpx;display:flex;align-items:center;justify-content:space-between}.address .address-item .address-item-edit{padding-left:40rpx;height:100%;display:flex;align-items:center}.address .address-item .address-item-edit image{display:flex;width:23rpx;height:23rpx}.address-btn{position:fixed;bottom:35rpx;left:0;right:0}.address-btn button{width:686rpx;height:70rpx;background:linear-gradient(90deg,#06c1ae,#02da84);border-radius:35rpx;font-size:28rpx;color:#8b5a2b;border:1px solid #d4a882}.address-btn  uni-button:after{border:none}.flex-align-items{width:100%;display:flex;align-items:center;justify-content:space-between}.out-range{font-size:22rpx;display:flex;justify-content:end;margin-top:4rpx;color:red}