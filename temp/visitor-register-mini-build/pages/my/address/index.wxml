<view class="address"><userinfo vue-id="6d5f6059-1" id="user" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo><block wx:for="{{addressList}}" wx:for-item="item" wx:for-index="__i0__" wx:key="address_id"><view data-event-opts="{{[['longpress',[['longHandle',['$0'],[[['addressList','address_id',item.address_id]]]]]],['tap',[['checkedHandle',['$0'],[[['addressList','address_id',item.address_id]]]]]]]}}" class="address-item" bindlongpress="__e" bindtap="__e"><view class="flex-align-items"><block wx:if="{{checkedFlag}}"><view class="address-item-left"><radio style="transform:scale(0.7);" disabled="{{open_mall_order_area>0&&item.is_out_range==1?true:false}}" checked="{{checkId==item.address_id}}" color="#06c1ae"></radio></view></block><view class="address-item-center"><view class="address-item-center-top"><view class="name">{{item.name}}</view><view class="phone">{{item.phone_txt}}</view><block wx:if="{{item.defaults===1}}"><view class="default">默认</view></block><block wx:if="{{item.tag}}"><view style="display:flex;"><block wx:if="{{item.tag==='家'}}"><view class="home">家</view></block><block wx:if="{{item.tag==='公司'}}"><view class="company">公司</view></block><block wx:if="{{item.tag==='学校'}}"><view class="home">学校</view></block><block wx:if="{{item.tag==='其他'}}"><view class="company">其他</view></block></view></block></view><view class="address-item-center-bottom">{{''+item.address_txt+''}}</view></view><view data-event-opts="{{[['tap',[['navTo',[true,'$0'],[[['addressList','address_id',item.address_id,'address_id']]]]]]]}}" class="address-item-edit" catchtap="__e"><text class="iconfont icon-bianji" style="font-size:24rpx;"></text></view></view><block wx:if="{{open_mall_order_area>0&&item.is_out_range==1}}"><view class="out-range">{{item.note}}</view></block></view></block><view class="address-btn"><button data-event-opts="{{[['tap',[['navTo',[false,'']]]]]}}" style="{{'background:'+(mainColor)+';'}}" bindtap="__e">新增收货地址</button></view></view>