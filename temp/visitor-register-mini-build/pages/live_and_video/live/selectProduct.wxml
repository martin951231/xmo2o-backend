<scroll-view class="selectProductBox data-v-5431d4cc" scroll-y="{{true}}"><block wx:if="{{!from_addProduct&&!store_id}}"><view class="topNav data-v-5431d4cc"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="goBack data-v-5431d4cc" catchtap="__e"></view> 选择商品 </view></block><input class="uni-input searchtop data-v-5431d4cc" confirm-type="search" placeholder="请输入商品名称" data-event-opts="{{[['confirm',[['searchPro',['$event']]]],['blur',[['searchPro',['$event']]]],['input',[['__set_model',['','keyword','$event',[]]]]]]}}" value="{{keyword}}" catchconfirm="__e" catchblur="__e" bindinput="__e"/><view class="data-v-5431d4cc"><view class="topArr data-v-5431d4cc"><block wx:for="{{topArr}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block class="data-v-5431d4cc"><text data-event-opts="{{[['tap',[['changeArr',[index,'$0'],[[['topArr','',index,'no']]]]]]]}}" class="{{['data-v-5431d4cc',curIndex==index?'active':'']}}" catchtap="__e">{{item.text}}</text></block></block></view><view class="flex secondSelect flex align-center data-v-5431d4cc" style="justify-content:space-around;"><block wx:for="{{secondSelectArr}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="{{['data-v-5431d4cc','secondSelectList  flex align-center '+(secondSelectIndex==index?'active':'')]}}"><text class="{{['data-v-5431d4cc',curentIndex==item.classify_top||curentIndex==item.classify_bottom?'cur':'']}}">{{item.name}}</text><view class="flex flex-direction align-center justify-around data-v-5431d4cc"><view data-event-opts="{{[['tap',[['tagClick',['$0'],[[['secondSelectArr','',index,'classify_top']]]]]]]}}" class="{{['data-v-5431d4cc','select_Num select_NumTop '+(curentIndex==item.classify_top?'cur':'')]}}" catchtap="__e"></view><view data-event-opts="{{[['tap',[['tagClick',['$0'],[[['secondSelectArr','',index,'classify_bottom']]]]]]]}}" class="{{['data-v-5431d4cc','select_Num select_NumBottom '+(curentIndex==item.classify_bottom?'cur':'')]}}" catchtap="__e"></view></view></view></block></view></view><block wx:if="{{$root.g0}}"><scroll-view class="proListBox data-v-5431d4cc" style="{{('height:'+proListBoxHeight+'px;')}}" scroll-y="{{true}}" data-event-opts="{{[['scroll',[['pageSroll',['$event']]]]]}}" bindscroll="__e"><block wx:for="{{proArr}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selectTag',['$0'],[[['proArr','',index]]]]]]]}}" class="flex proList data-v-5431d4cc" catchtap="__e"><view class="{{['data-v-5431d4cc','select_icon '+(item.static==true?'select_iconed':'')]}}"></view><view class="imgBox data-v-5431d4cc"><image style="width:85px;height:85px;" src="{{item.img}}" mode="aspectFill" alt="{{item.name}}" class="data-v-5431d4cc"></image></view><view class="proList_text data-v-5431d4cc"><view class="proList_textTil data-v-5431d4cc">{{item.name}}</view><view class="data-v-5431d4cc"><text class="red fontWeight data-v-5431d4cc">{{currency+item.price}}</text><text style="padding-left:20px;" class="data-v-5431d4cc">可得佣金：</text><text class="red fontWeight data-v-5431d4cc">{{currency+item.commission}}</text></view><block wx:if="{{item.stock!=-1&&item.stock!=0}}"><view class="data-v-5431d4cc">{{"剩余："+item.stock}}</view></block></view></view></block><view class="ingLoad data-v-5431d4cc">{{ingLoadss}}</view></scroll-view></block><block wx:else><view class="no_tips data-v-5431d4cc"><image src="https://cloud.mrsqfw.com/static/wxapp/live_and_video/images/no_data.png" class="data-v-5431d4cc"></image><view class="data-v-5431d4cc">暂无商品</view></view></block><view class="btFixedSum data-v-5431d4cc"><text class="data-v-5431d4cc">{{selectNum+"/"}}</text><text class="colorStyle data-v-5431d4cc">100</text><text data-event-opts="{{[['tap',[['submit_ok',['$event']]]]]}}" class="btn_ok colorStyle data-v-5431d4cc" catchtap="__e">确定</text></view></scroll-view>