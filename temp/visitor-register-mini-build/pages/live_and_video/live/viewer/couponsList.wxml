<view class="counponsListBox"><view class="counponsList_top flex"><text>{{"共"+coupon_nums+"张优惠券"}}</text><view data-event-opts="{{[['tap',[['btn_close',['$event']]]]]}}" class="close_btn" bindtap="__e"></view></view><scroll-view class="counponsListBoxCon" scroll-y="{{true}}"><block wx:if="{{$root.g0}}"><view><block wx:for="{{coupon_list}}" wx:for-item="item" wx:for-index="index" wx:key="coupon_id"><view class="counponsList flex"><view class="counponsList_fl"><text class="til"><label>{{currency}}</label>{{''+item.money+''}}</text><label class="til_sm">{{''+item.discount_title}}</label></view><view class="counponsList_fr"><view class="counponsList_frName">{{''+item.title}}</view><view class="tips">{{''+item.limit_tips}}</view><view class="btn_static"><block wx:if="{{item.status==0}}"><label data-event-opts="{{[['tap',[['get_coupon',['$0'],[[['coupon_list','coupon_id',item.coupon_id,'coupon_id']]]]]]]}}" class="btn btn2" bindtap="__e">点击领取</label></block><block wx:if="{{item.status==1}}"><label class="btn btn1">已抢光</label></block><block wx:if="{{item.status==2}}"><label class="btn btn3">已领取</label></block></view></view></view></block></view></block><view hidden="{{!(no_tips)}}" class="no_tip"><view>暂无可领的优惠券</view></view></scroll-view></view>