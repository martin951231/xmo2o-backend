<view class="coupons_bg"><view class="couponsCon"><view class="til_2">恭喜您</view><view data-event-opts="{{[['tap',[['clickCloseCounpon',['$event']]]]]}}" class="counpon_close" bindtap="__e"></view><view class="coupons_bb"><text class="price_font">{{currency}}<label>{{coupon_info.discount}}</label></text><text class="lab1">{{coupon_info.order_money+''}}</text><text class="lab1">{{coupon_info.limit_tips+''}}</text></view><view class="time_close"><label class="red">{{count}}</label>秒后自动关闭</view><view class="coupons_btn"><block wx:if="{{coupon_info.get==0}}"><label data-event-opts="{{[['tap',[['get_counpon',['$0'],['coupon_info.coupon_id']]]]]}}" class="btn1" bindtap="__e">立即领取</label></block><block wx:if="{{coupon_info.get==1}}"><label class="btn2">已领取</label></block><block wx:if="{{take_out}}"><label class="btn3">已抢光</label></block></view></view></view>