yle="width:335rpx;height:211rpx;" src="https://cloud.mrsqfw.com/static/wxapp/live_and_video/images/no_video.png"></image><view>暂无直播内容</view></view></block></view><view hidden="{{!(curIndex==1)}}" class="tabCon"><block wx:for="{{$root.l0}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goVideoUrl',['$0'],[[['videoList','',index,'video_id']]]]]]]}}" class="video_block flex video_blockComlum" bindtap="__e"><view class="video_block_left"><image class="video_sm" src="https://cloud.mrsqfw.com/static/wxapp/live_and_video/img/video_sm.png"></image><image class="video_smBg" src="{{item.$orig.img}}" mode="aspectFill"></image><block wx:if="{{item.g4}}"><view class="flex product_txt"><image class="productImg" src="{{item.$orig.goods_list[0].img}}"></image><view class="product_txtfr"><view class="name">{{item.$orig.goods_list[0].name}}</view><view class="price">{{currency+item.$orig.goods_list[0].price}}</view></view></view></block><view class="spsp"></view></view><view class="video_block_right"><view class="flex video_block_rightTop"><image class="avatar" style="width:40rpx;height:40rpx;" src="{{item.$orig.avatar}}"></image><view class="video_block_rightTopTil">{{item.$orig.nickname}}</view></view><view class="titl">{{''+item.$orig.title+''}}</view><view class="video_block_rightTopTalk"><block wx:for="{{item.$orig.cate_list}}" wx:for-item="jtem" wx:for-index="index"><text>{{"#"+jtem.name+"#"}}</text></block></view><view class="video_block_rightBotton flex"><view class="reader">{{item.$orig.views+"阅读"}}</view><view class="love_Commentary"><text class="icon_spIndex1">{{item.$orig.zan}}</text><text class="icon_spIndex2">{{item.$orig.commonts}}</text></view></view></view></view></block><block wx:if="{{is_more}}"><view class="more_tip">{{''+is_moreTips}}</view></block></view></view></view></block>