<block wx:if="{{show_list}}"><view data-event-opts="{{[['tap',[['close_product',['$event']]]]]}}" class="wrap_box" catchtap="__e"><view class="productListBox"><view class="productListCon"><block wx:if="{{basic_info}}"><view class="flex productListTop" style="justify-content:space-between;"><view class="flex productListTopLeft"><image class="avator" src="{{basic_info.avatar}}"></image><view><label class="til">{{basic_info.nickname}}</label><view class="til_sm">{{"共 "+basic_info.goods_nums+"件商品 | 关注："+basic_info.follow_nums}}</view></view></view><view data-event-opts="{{[['tap',[['clickCare',['$0'],['basic_info.live_id']]]]]}}" class="{{['care_static care '+(careType==1?'care_no':'cared')]}}" catchtap="__e">{{careType==1?'已关注':'关注'}}</view></view></block><scroll-view class="productBox" scroll-y="{{true}}"><block wx:if="{{$root.g0}}"><view class="productListConList"><block wx:for="{{goods_list}}" wx:for-item="item" wx:for-index="index" wx:key="id"><view data-event-opts="{{[['tap',[['go_buy',['$0'],[[['goods_list','id',item.id,'id']]]]]]]}}" class="goods_list flex" catchtap="__e"><view class="goods_listImg"><label class="no">{{item.no}}</label><image src="{{item.img}}"></image></view><view class="goods_listTxt"><view class="goods_listName">{{item.name}}</view><view class="store_info"><block wx:if="{{item.business!='group'&&item.store_name}}"><view class="flex_item store_name"><text class="iconfont icon-shangdian"></text>{{''+item.store_name+''}}</view></block><block wx:if="{{item.business!='group'&&item.address}}"><view data-event-opts="{{[['tap',[['checkMap',['$0'],[[['goods_list','id',item.id]]]]]]]}}" class="flex_item store_address" catchtap="__e"><text class="iconfont icon-dingwei"></text>{{''+item.address+''}}</view></block></view><view class="flex goods_listBottom" style="justify-content:space-between;"><view class="price"><text>{{currency}}</text><text class="priceNum">{{item.price}}</text></view><view><block wx:if="{{item.recording==1}}"><text data-event-opts="{{[['tap',[['videoBack',['$0'],[[['goods_list','id',item.id,'video_url']]]]]]]}}" class="btn btn1" catchtap="__e">回放</text></block><block wx:if="{{item.recording==0&&basic_info.status==1&&!show_live_ending}}"><text data-event-opts="{{[['tap',[['wantExplain',['$0'],[[['goods_list','id',item.id,'no']]]]]]]}}" class="btn btn1" catchtap="__e">求讲解</text></block><block wx:if="{{item.recording==2&&basic_info.status==1}}"><text class="btn btn1">直播中</text></block><text data-event-opts="{{[['tap',[['go_buy',['$0'],[[['goods_list','id',item.id,'id']]]]]]]}}" class="btn btn2" catchtap="__e">去购买</text></view></view></view></view></block></view></block><view hidden="{{!(show_tips)}}" class="no_tip"><view>暂无商品</view></view></scroll-view></view></view></view></block>