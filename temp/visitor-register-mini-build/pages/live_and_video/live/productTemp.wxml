<scroll-view class="{{[store_id_cur?'productBox':'']}}" scroll-y="{{true}}"><block wx:if="{{fromStoreId&&!from_addProduct}}"><view class="topNav"><view data-event-opts="{{[['tap',[['goBack',['$event']]]]]}}" class="goBack" catchtap="__e"></view> 选择商品 </view></block><block wx:if="{{store_id_cur}}"><view class="searchtop"><input class="uni-input" confirm-type="search" placeholder="请输入商品名称" data-event-opts="{{[['confirm',[['searchPro',['$event']]]],['blur',[['searchPro',['$event']]]],['input',[['__set_model',['','keyword','$event',[]]]]]]}}" value="{{keyword}}" catchconfirm="__e" catchblur="__e" bindinput="__e"/></view></block><view><view class="topArr"><block wx:for="{{topArr}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block><text data-event-opts="{{[['tap',[['changeArr',[index,'$0'],[[['topArr','',index,'no']]]]]]]}}" class="{{[curIndex==index?'active':'']}}" catchtap="__e">{{item.text}}</text></block></block></view><view class="flex secondSelect" style="justify-content:space-around;"><block wx:for="{{secondSelectArr}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="{{['secondSelectList flex align-center '+(secondSelectIndex==index?'active':'')]}}"><text class="{{[curentIndex==item.classify_top||curentIndex==item.classify_bottom?'cur':'']}}">{{item.name}}</text><view class="flex flex-direction align-center justify-around"><view data-event-opts="{{[['tap',[['tagClick',['$0'],[[['secondSelectArr','',index,'classify_top']]]]]]]}}" class="{{['select_Num select_NumTop '+(curentIndex==item.classify_top?'cur':'')]}}" catchtap="__e"></view><view data-event-opts="{{[['tap',[['tagClick',['$0'],[[['secondSelectArr','',index,'classify_bottom']]]]]]]}}" class="{{['select_Num select_NumBottom '+(curentIndex==item.classify_bottom?'cur':'')]}}" catchtap="__e"></view></view></view></block></view></view><block wx:if="{{$root.g0}}"><scroll-view class="proListBox" style="{{('height:'+proListBoxHeight+'px;')}}" scroll-y="{{true}}" data-event-opts="{{[['scroll',[['pageSroll',['$event']]]]]}}" bindscroll="__e"><block wx:for="{{proArr}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selectTag',['$0'],[[['proArr','',index]]]]]]]}}" class="flex proList" catchtap="__e"><view class="{{['select_icon '+(item.static==true?'select_iconed':'')]}}"></view><view class="imgBox"><image style="width:85px;height:85px;" src="{{item.img}}" mode="aspectFill" alt="{{item.name}}"></image></view><view class="proList_text"><view class="proList_textTil">{{item.name}}</view><view><text class="red fontWeight">{{currency+item.price}}</text><text style="padding-left:20px;">可得佣金：</text><text class="red fontWeight">{{currency+item.commission}}</text></view><view class="stock"><block wx:if="{{item.stock==-1}}"><text>无限量库存</text></block><block wx:else><block wx:if="{{item.stock>0}}"><text>{{"剩余 "+item.stock}}</text></block></block></view></view></view></block><view class="ingLoad">{{ingLoadss}}</view></scroll-view></block><block wx:else><view class="no_tips"><image src="https://cloud.mrsqfw.com/static/wxapp/live_and_video/images/no_data.png"></image><view>暂无商品</view></view></block><view class="btFixedSum"><text>{{selectNum+"/"}}</text><text class="colorStyle">100</text><text data-event-opts="{{[['tap',[['submit_ok',['$event']]]]]}}" class="btn_ok colorStyle" catchtap="__e">确定</text></view></scroll-view>