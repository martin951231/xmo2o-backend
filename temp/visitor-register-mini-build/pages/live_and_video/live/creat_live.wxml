<view class="fromBox"><form><view class="from_row"><view class="from_til">分享卡片封面图</view><view class="from_row_con"><view data-event-opts="{{[['tap',[['uploadImg',['0']]]]]}}" class="uploadBg1" bindtap="__e"><image style="width:100px;height:100%;" src="{{loadImg1}}" mode="aspectFill"></image></view></view></view><view class="from_row"><view class="from_til">直播封面图</view><view class="from_row_con"><view data-event-opts="{{[['tap',[['uploadImg',['1']]]]]}}" class="uploadBg2" bindtap="__e"><image style="width:90px;height:160px;" src="{{loadImg2}}" mode="aspectFill"></image></view></view></view><view class="flex from_row"><view class="from_til">直播标题</view><view class="from_row_con"><input class="uni-input" placeholder="给直播取个主题名" data-event-opts="{{[['input',[['__set_model',['','title','$event',[]]]]]]}}" value="{{title}}" bindinput="__e"/></view></view><view class="flex from_row"><view class="from_til" style="align-items:flex-start;">内容简介</view><view class="from_row_con"><input class="uni-input des_con" placeholder="介绍直播内容或注意事项" data-event-opts="{{[['input',[['__set_model',['','desc','$event',[]]]]]]}}" value="{{desc}}" bindinput="__e"/></view></view><view class="flex from_row"><view class="from_til">主播昵称</view><view class="from_row_con"><input class="uni-input" placeholder="设置昵称" data-event-opts="{{[['input',[['__set_model',['','nickname','$event',[]]]]]]}}" value="{{nickname}}" bindinput="__e"/></view></view><block wx:if="{{isShowEstimateTime&&!isUpdate}}"><view class="flex from_row"><view class="from_til">预开始时间</view><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="from_row_con" style="{{'height:40rpx;'+('color:'+(estimate_time?'#000000':'grey')+';')}}" bindtap="__e">{{''+(estimate_time||'选择时间')+''}}<u-picker vue-id="74cbded7-1" mode="time" start-year="{{estimateStart}}" params="{{({year:true,month:true,day:true,hour:true,minute:true,second:false,timestamp:true})}}" value="{{estimateTimeShow}}" data-event-opts="{{[['^confirm',[['estimateTimeConfirm']]],['^input',[['__set_model',['','estimateTimeShow','$event',[]]]]]]}}" bind:confirm="__e" bind:input="__e" bind:__l="__l"></u-picker></view></view></block><view class="flex from_row"><view class="from_til">所属分类</view><view class="from_row_con"><text data-event-opts="{{[['tap',[['bindClassChange']]]]}}" class="zan_text" style="{{('color:'+(selectedType=='选择分类'?'grey':''))}}" catchtap="__e">{{selectedType}}</text><u-picker vue-id="74cbded7-2" confirm-color="#fe443a" mode="multiSelector" range-key="name" range="{{listTypeArr}}" default-selector="{{typeRange}}" value="{{showTypePicker}}" data-event-opts="{{[['^columnchange',[['handleChange']]],['^confirm',[['handleConfirmType']]],['^cancle',[['handleCancle']]],['^input',[['__set_model',['','showTypePicker','$event',[]]]]]]}}" bind:columnchange="__e" bind:confirm="__e" bind:cancle="__e" bind:input="__e" bind:__l="__l"></u-picker></view></view><view class="flex from_row"><view class="from_til">直播地点</view><view data-event-opts="{{[['tap',[['chooseLocationHandle',['$event']]]]]}}" class="from_row_con" style="flex:1;height:40px;" catchtap="__e"><text class="zan_text" style="{{('color:'+(address=='点击选择'?'grey':'#000000'))}}">{{address}}</text></view></view><block wx:if="{{!isUpdate}}"><view class="flex from_row"><view class="from_til">添加宝贝</view><view data-event-opts="{{[['tap',[['addProduct',['add_product']]]]]}}" class="from_row_con" bindtap="__e"><text style="{{'color:grey;'+('color:'+(goodTxt=='点击选择'?'grey':'#000000'))}}">{{goodTxt}}</text></view></view></block><block wx:if="{{!isUpdate}}"><button class="btn_submit" type="warn" data-event-opts="{{[['tap',[['create_live',['$event']]]]]}}" bindtap="__e">创建直播</button></block><block wx:if="{{isUpdate}}"><view class="chang_btn flex"><button type="warn" data-event-opts="{{[['tap',[['change_liveInfo',['$event']]]]]}}" bindtap="__e">确定修改</button><button type data-event-opts="{{[['tap',[['cancelChange_liveInfo',['$event']]]]]}}" bindtap="__e">取消修改</button></view></block></form></view>