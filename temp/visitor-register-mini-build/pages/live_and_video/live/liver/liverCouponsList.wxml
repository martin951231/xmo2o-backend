<view class="counponsListBox"><view class="counponsList_top flex"><text>{{"共"+coupon_nums+"张优惠券"}}</text><view data-event-opts="{{[['tap',[['btn_close',['$event']]]]]}}" class="close_btn" bindtap="__e"></view></view><scroll-view class="counponsListBoxCon" scroll-y="{{true}}"><block wx:if="{{$root.g0}}"><view><block wx:for="{{coupon_list}}" wx:for-item="item" wx:for-index="index" wx:key="coupon_id"><view class="counponsList flex"><view class="counponsList_fl"><view class="counponsList_flTil">{{item.title}}</view><text class="til"><label>{{currency}}</label>{{''+item.discount+''}}</text><label class="til_sm">{{''+item.discount_title}}</label></view><view class="counponsList_fr"><view class="btn_static"><block wx:if="{{item.send==0}}"><label data-event-opts="{{[['tap',[['sendcoupon',['$0'],[[['coupon_list','coupon_id',item.coupon_id,'coupon_id']]]]]]]}}" class="btn btn2" bindtap="__e">点击发送</label></block><block wx:if="{{item.send==1}}"><label class="btn btn3">已发送</label></block><label class="nums">{{"共"+item.nums+"张"}}</label></view></view></view></block></view></block><block wx:if="{{no_tips}}"><view class="no_tip"><view>暂无可领的优惠券</view></view></block></scroll-view></view>