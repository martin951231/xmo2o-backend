<view class="liver_box"><block wx:if="{{my_info}}"><view class="liver_pageTop"><view class="flex liver_pageBox"><image class="avatar" src="{{my_info.avatar}}"></image><view class="liver_pageTopRight"><view class="per_til">{{my_info.nickname}}</view><view class="per_sm_til"><text>{{my_info.zan+"  赞"}}</text><text>{{my_info.follow+"  关注"}}</text></view><view class="flex"><block wx:if="{{my_info.auth&&my_info.auth.live_video==1}}"><view class="icon_btnLiver1"></view></block><block wx:if="{{my_info.auth&&my_info.auth.live_show==1}}"><view class="icon_btnLiver2"></view></block></view></view></view><block wx:if="{{my_info.authen==3}}"><view class="shiming_til">实名认证后才可发布直播与视频哦！去<text data-event-opts="{{[['tap',[['go_authentication',['$event']]]]]}}" bindtap="__e">实名认证>></text></view></block></view></block><view class="flex btnTopMenu"><view data-event-opts="{{[['tap',[['click_authentication',['liveshow']]]]]}}" class="btn_liver" style="width:330rpx;height:140rpx;" bindtap="__e"><image style="width:330rpx;height:140rpx;" src="https://cloud.mrsqfw.com/static/wxapp/live_and_video/images/class1.png"></image></view><view data-event-opts="{{[['tap',[['click_authentication',['livevideo']]]]]}}" class="btn_video" style="width:330rpx;height:140rpx;" bindtap="__e"><image style="width:330rpx;height:140rpx;" src="https://cloud.mrsqfw.com/static/wxapp/live_and_video/images/class2.png"></image></view></view><view class="listBox"><view data-event-opts="{{[['tap',[['go_myList',['my_liverList']]]]]}}" class="my_til" bindtap="__e">我的直播间</view><view class="my_list"><view data-event-opts="{{[['tap',[['goUrl',['$0'],['url_link.my_commission_url']]]]]}}" class="item list_yj" bindtap="__e">我的佣金</view><view data-event-opts="{{[['tap',[['go_myList',['../../video/Author/my_videoList']]]]]}}" class="item list_video" bindtap="__e">我的短视频</view></view></view></view>