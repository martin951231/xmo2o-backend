<view data-event-opts="{{[['tap',[['',['$event']]]]]}}" class="counponsListBox" catchtap="__e"><view class="counponsList_top flex"><text>{{"共"+user_nums+"个在线用户"}}</text></view><view class="inputBox"><input class="uni-input" confirm-type="search" placeholder="搜索成员" data-event-opts="{{[['blur',[['searchUser',['$event']]]],['input',[['__set_model',['','keyword','$event',[]]]]]]}}" value="{{keyword}}" bindblur="__e" bindinput="__e"/></view><scroll-view class="counponsListBoxCon" scroll-y="{{true}}" data-event-opts="{{[['scroll',[['scrollpage',['$event']]]]]}}" bindscroll="__e"><block wx:if="{{$root.g0}}"><view><block wx:for="{{user_list}}" wx:for-item="item" wx:for-index="index"><view class="flex setBlock"><view class="setBlockFl"><image class="setlistImg" src="{{item.avatar}}"></image><view class="til">{{''+item.nickname+''}}<block wx:if="{{item.is_admin==1}}"><label class="guan"></label></block></view><view class="til_bt"><text class="red">{{item.zan}}</text>赞 <text class="red">{{item.buy}}</text> 买 </view></view><block wx:if="{{item.is_anchor==0}}"><view class="setBlockFr"><text data-event-opts="{{[['tap',[['click_manage',['$0','$1','no_speaking'],[[['user_list','',index,'uid']],[['user_list','',index,'no_speaking']]]]]]]}}" class="{{['btn '+(item.no_speaking==0?'btn1':'')]}}" catchtap="__e">{{''+(item.no_speaking==1?'已禁言':'禁言')+''}}</text><text data-event-opts="{{[['tap',[['click_manage',['$0','$1','is_admin'],[[['user_list','',index,'uid']],[['user_list','',index,'is_admin']]]]]]]}}" class="{{['btn '+(item.is_admin==0?'btn2':'')]}}" catchtap="__e">{{''+(item.is_admin==1?'已设置':'管理员')+''}}</text></view></block></view></block></view></block><block wx:if="{{no_tips}}"><view class="no_tip"><view>暂无用户</view></view></block><view class="no_tipppp">{{loadTip}}</view></scroll-view><block wx:if="{{no_speaking_show}}"><view class="end_liveBox"><view class="end_con"><view class="end_conTil">重要提示</view><block wx:if="{{manageType=='no_speaking'}}"><view class="end_conCC">{{cancel==1?'是否解除他/她禁言？':'是否设置他/她禁言？'}}</view></block><block wx:if="{{manageType=='is_admin'}}"><view class="end_conCC">{{cancel==1?'是否解除他/她管理员？':'是否设置他/她管理员？'}}</view></block><view data-event-opts="{{[['tap',[['sure_noSpeaking',['$event']]]]]}}" class="end_ok" bindtap="__e">确定</view><image class="close_show" src="https://cloud.mrsqfw.com/static/wxapp/live_and_video/img/close_show.png" data-event-opts="{{[['tap',[['close_noSpeaking',['$event']]]]]}}" bindtap="__e"></image></view></view></block></view>