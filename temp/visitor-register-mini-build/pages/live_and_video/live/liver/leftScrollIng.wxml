<view class="ScrollBoxCon"><view data-event-opts="{{[['tap',[['close_leftScroll',['$event']]]]]}}" class="alap_close" bindtap="__e"></view><block wx:if="{{dataInfo.part_1}}"><view class="leftScrollBox"><view class="flex leftScrollBoxTil" style="border-bottom:20rpx solid rgba(31,31,32,1);"><view class="leftScrollBoxTilFl">实时直播数据</view><text data-event-opts="{{[['tap',[['click_refurbish',['$event']]]]]}}" class="refurbish" bindtap="__e">刷新</text></view><view class="flex itemList" style="border:1px solid rgba(34,34,34,1);"><view class="item"><view>观看次数</view><text>{{dataInfo.part_1.watch_nums}}</text></view><view class="item"><view>实时在线人数</view><text>{{dataInfo.part_1.online_nums}}</text></view></view><view class="flex itemList"><view class="item"><view>新增关注数</view><text>{{dataInfo.part_1.new_follow}}</text></view><view class="item"><view>观看峰值数</view><text>{{dataInfo.part_1.top_watch}}</text></view></view><view class="flex leftScrollBoxTil" style="border-top:20rpx solid rgba(31,31,32,1);"><view class="leftScrollBoxTilFl leftScrollBoxTilFlXG">商品效果</view></view><view class="buyBoxWrap"><view class="flex tab_list tab_listTop"><view class="tab_td1">商品</view><view class="tab_td2"><text data-event-opts="{{[['tap',[['reverseArr']]]]}}" bindtap="__e">购买数</text><view class="{{['select_Num select_NumTop '+(curIndex==1?'cur':'')]}}"></view><view class="{{['select_Num select_NumBottom '+(curIndex==2?'cur':'')]}}"></view></view></view><view class="buyBox"><scroll-view scroll-y="{{true}}"><block wx:for="{{goods_list}}" wx:for-item="item" wx:for-index="index" wx:key="goods_id"><view class="flex tab_list"><view class="tab_td1 p_txt">{{item.no+"-"+item.name}}</view><view class="tab_td2">{{item.buy}}</view></view></block></scroll-view></view></view></view></block></view>