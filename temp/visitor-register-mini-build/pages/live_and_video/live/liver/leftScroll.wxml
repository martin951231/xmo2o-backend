<view class="leftScrollBox leftScrollBoxAll"><view data-event-opts="{{[['tap',[['goBackList',['$event']]]]]}}" class="close_back" bindtap="__e"></view><view><view class="leftScrollBoxAllTop"><view class="til">直播已结束</view><view class="sm_til">{{"— 直播时长 "+time+" —"}}</view></view><block wx:if="{{init_live_online_userInfo.count}}"><view class="flex itemList" style="border-bottom:1px solid rgba(34,34,34,1);"><view class="item"><view>{{init_live_online_userInfo.count.watch}}</view><text>观看人数</text></view><view class="item"><view>{{init_live_online_userInfo.count.buy+''}}</view><text>商品售出</text></view></view></block><block wx:if="{{init_live_online_userInfo.count}}"><view class="flex itemList"><view class="item"><view>{{init_live_online_userInfo.count.share}}</view><text>分享</text></view><view class="item"><view>{{init_live_online_userInfo.count.comment}}</view><text>评论</text></view><view class="item"><view>{{init_live_online_userInfo.count.zan}}</view><text> 赞</text></view></view></block><view class="leftScrollBoxTil" style="border-top:20rpx solid rgba(31,31,32,1);"> 直播商品 </view><view class="buycon"><view class="flex tab_list tab_listTop"><view class="tab_td1">商品</view><view class="tab_td2"><text data-event-opts="{{[['tap',[['reverseArr']]]]}}" bindtap="__e">购买数</text><view class="{{['select_Num select_NumTop '+(curIndex==1?'cur':'')]}}"></view><view class="{{['select_Num select_NumBottom '+(curIndex==2?'cur':'')]}}"></view></view></view><view class="buyBox"><block wx:for="{{goods_list}}" wx:for-item="item" wx:for-index="index" wx:key="goods_id"><view class="flex tab_list"><view class="tab_td1 p_txt">{{item.no+"-"+item.name}}</view><view class="tab_td2">{{item.buy}}</view></view></block></view></view></view></view>