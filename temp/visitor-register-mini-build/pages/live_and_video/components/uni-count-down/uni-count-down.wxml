<view class="{{['uni-countdown '+(styleChange?'fontStyle':'')]}}"><block wx:if="{{showDay}}"><view class="{{['uni-countdown__number  '+(styleChange?'yellow':'')]}}">{{d}}</view></block><block wx:if="{{showDay}}"><view class="uni-countdown__splitor" style="{{'color:'+(splitorColor)+';'}}">天</view></block><view class="{{['uni-countdown__number  '+(styleChange?'yellow':'')]}}">{{h}}</view><view class="uni-countdown__splitor" style="{{'color:'+(splitorColor)+';'}}">{{showColon?':':'时'}}</view><view class="{{['uni-countdown__number  '+(styleChange?'yellow':'')]}}">{{i}}</view><view class="uni-countdown__splitor" style="{{'color:'+(splitorColor)+';'}}">{{showColon?':':'分'}}</view><block wx:if="{{showSecond}}"><view class="{{['uni-countdown__number',styleChange?'yellow':'']}}">{{s}}</view></block><block wx:if="{{!showColon&&showSecond}}"><view class="uni-countdown__splitor" style="{{'color:'+(splitorColor)+';'}}">秒</view></block></view>