<block wx:if="{{basic_info}}"><view class="flex top_nav" style="{{('justify-content:space-between;'+topNavStyle)}}"><view class="flex" style="justify-content:flex-start;"><view data-event-opts="{{[['tap',[['goback',['$event']]]]]}}" class="goback" bindtap="__e"></view><view class="flex viwerInfo"><image class="viwerInfo_Avator" src="{{basic_info.avatar}}" data-event-opts="{{[['tap',[['back_liverPage',['$event']]]]]}}" bindtap="__e"></image><view data-event-opts="{{[['tap',[['back_liverPage',['$event']]]]]}}" class="viwerInfoMid" bindtap="__e"><view class="viwerInfoMidName">{{basic_info.nickname}}</view><view class="viwerInfoMidTxt"><label class="{{['g_look '+(basic_info.area?'g_look1':'')]}}">{{watch_nums+" 观看"}}</label><block wx:if="{{basic_info.area}}"><label>{{''+basic_info.area}}</label></block></view></view><view class="viwerInfoRight"><label data-event-opts="{{[['tap',[['clickCare',['$0'],['basic_info.live_id']]]]]}}" class="{{['care '+(careType==1?'care_no':'cared')]}}" catchtap="__e">{{careType==1?'已关注':'关注'}}</label></view></view></view></view></block>