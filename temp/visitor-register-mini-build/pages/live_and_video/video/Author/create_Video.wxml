px;position:absolute;right:-10rpx;top:-12rpx;" src="https://cloud.mrsqfw.com/static/wxapp/live_and_video/img/close_cover.png" data-event-opts="{{[['tap',[['deleteCoverImg',['$event']]]]]}}" catchtap="__e" class="data-v-7071c60f"></image></view></view></view></view><view data-event-opts="{{[['tap',[['addProduct',['$event']]]]]}}" class="flex addProduct data-v-7071c60f" bindtap="__e"><text class="addProductTil data-v-7071c60f">添加商品</text><block wx:if="{{$root.g1>0}}"><text class="addProductRg data-v-7071c60f">{{goodTxt}}</text></block></view><button class="btn_submit data-v-7071c60f" type="warn" data-event-opts="{{[['tap',[['create_video',['$event']]]]]}}" catchtap="__e">发布</button></view>