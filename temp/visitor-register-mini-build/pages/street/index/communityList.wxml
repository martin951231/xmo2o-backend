<view class="container" style="height:100vh;"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view class="card"><view class="card-left"><image class="user-img" src="{{item.logo}}" mode></image><view class="right-box"><view class="info-box"><view class="name">{{item.area_name}}</view></view><view class="address">{{"位置："+item.detail_address}}</view></view></view><view class="card-right"><image class="nopass" src="../static/images/phone_1.png" mode data-event-opts="{{[['tap',[['callPhone',['$0'],[[['listdata','',index,'phone']]]]]]]}}" bindtap="__e"></image></view></view></block></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="1cec6be2-1" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="1cec6be2-2" keywords="没有更多记录" bind:__l="__l"></lang></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="https://cloud.mrsqfw.com/static/images/house/no_data.png"></image><view class="no_tip_content">{{'暂无\n\t\t\t'+(config.config&&config.config.set_house_alias&&config.config.house_name?config.config.house_name:'小区')+''}}</view></view></block></view>