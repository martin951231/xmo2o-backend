<view class="container"><view class="card"><view class="mini-flex"><view class="text">内容描述</view><view class="text">{{dataList.content}}</view></view><view class="mini-flex"><view class="text">提交时间</view><view class="text">{{dataList.add_time_txt}}</view></view><block wx:if="{{dataList.img_arr}}"><view class="mini-flex1"><view class="text" style="flex-shrink:0;">内容图例</view><view class="img-box"><block wx:for="{{dataList.img_arr}}" wx:for-item="items" wx:for-index="indexs"><image class="img-item" src="{{items}}" mode></image></block></view><block wx:if="{{dataList.img_arr==''}}"><view class="text">无</view></block></view></block></view><block wx:if="{{reply_content}}"><view class="card"><view class="title">街道回复</view><block wx:for="{{reply_content}}" wx:for-item="item" wx:for-index="index"><view class="mini-flex"><view class="text" style="flex-shrink:0;margin-right:15rpx;">{{item.add_time_txt}}</view><view class="text" style="overflow-wrap:break-word;width:352rpx;line-height:45rpx;text-align:justify;">{{item.reply_content}}</view></view></block></view></block></view>