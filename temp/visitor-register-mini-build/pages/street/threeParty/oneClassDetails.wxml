<view class="container"><userinfo vue-id="6914accc-1" id="user" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo><block wx:if="{{now_news&&now_news.title}}"><view class="container-box"><view class="title">{{''+now_news.title+''}}</view><view class="text-box"><view data-event-opts="{{[['tap',[['goVillage',['$event']]]]]}}" class="address" bindtap="__e">{{village_name}}</view><view class="time">{{now_news.add_time}}</view></view><view class="content-box"><rich-text nodes="{{now_news.content}}" loading="{{loading}}"></rich-text></view><view class="read-box"><view class="read-num">{{"阅读"+now_news.read_sum}}</view></view></view></block><view class="comment"><view class="Selected-commernt">留言列表</view><view data-event-opts="{{[['tap',[['writecomment',['$event']]]]]}}" class="write-commernt" bindtap="__e">写留言</view></view><view class="container1"><block wx:for="{{news_reply_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{news_reply_list[0]}}"><view class="comment-box"><view class="comment-icon"><image class="comment-img" src="{{item.avatar}}"></image></view><view class="comment-info"><view class="comment-name"><text>{{item.nickname}}</text></view><view class="comment-text">{{item.content+''}}</view></view></view></block></block></view><view><uni-popups class="vue-ref" vue-id="6914accc-2" type="top" data-ref="popup" bind:__l="__l" vue-slots="{{['default']}}"><textarea class="prpup-box" value="{{notedata}}" placeholder="{{popup_placeholder}}" focus="{{popup_focus}}" data-event-opts="{{[['input',[['__set_model',['','notedata','$event',[]]]]]]}}" bindinput="__e"></textarea><button class="btn" form-type="submit" data-event-opts="{{[['tap',[['formSubmit',['$event']]]]]}}" bindtap="__e">发送</button></uni-popups></view></view>