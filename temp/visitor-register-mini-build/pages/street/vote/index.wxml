<view class="vote_index"><block wx:if="{{user_options.toLogin}}"><userinfo vue-id="2f870fb6-1" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo></block><view><view class="vote_list"><block wx:if="{{!no_data}}"><view><block wx:for="{{list_data}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{list_data}}"><view data-event-opts="{{[['tap',[['vote_detail',['$0'],[[['list_data','',index,'vote_id']]]]]]]}}" class="vote_msg" bindtap="__e"><view class="vote_title">{{''+item.vote_title+''}}<block wx:if="{{item.is_join}}"><text> (<text>已投票</text><block wx:if="{{item.vote_status==2}}"><text>，点击查看结果</text></block>) </text></block></view><view class="vote_time">{{''+item.start_time_txt+"至"+item.end_time_txt+''}}<block wx:if="{{item.vote_status==0}}"><text class="no_active">未开始</text></block><block wx:if="{{item.vote_status==1}}"><text class="in_active">进行中</text></block><block wx:if="{{item.vote_status==2}}"><text class="end_active">已结束</text></block></view><block wx:if="{{item.vote_image&&item.vote_image[0]}}"><view class="vote_img"><image style="width:100%;" src="{{item.vote_image[0]['file_url']}}" mode="widthFix"></image></view></block></view></block></block></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="https://cloud.mrsqfw.com/static/images/house/no_data.png"></image><view class="no_tip_content">还没有内容哦</view></view></block><block wx:if="{{isLoading}}"><view class="tip_msg"><view>加载中</view></view></block><block wx:if="{{finished}}"><view class="tip_msg"><view>我也是有底线的···</view></view></block></view></view></view>