<view class="goods-group data-v-aa97ef9c"><view data-event-opts="{{[['tap',[['goUrl',['$event']]]]]}}" class="container data-v-aa97ef9c" style="{{(containerStyle)}}" bindtap="__e"><view class="img-con data-v-aa97ef9c" style="{{(imgStyle)}}"><image src="{{content.group_image}}" mode="aspectFill" class="data-v-aa97ef9c"></image><text class="distance data-v-aa97ef9c">{{content.distance}}</text></view><view class="info data-v-aa97ef9c"><view class="name data-v-aa97ef9c">{{content.group_name}}</view><view class="price-block data-v-aa97ef9c" style="{{(primaryColor)}}"><text class="data-v-aa97ef9c">{{currency}}</text><text style="font-size:36rpx;font-weight:bold;" class="data-v-aa97ef9c">{{content.price}}</text><text class="old-price data-v-aa97ef9c">{{currency+content.old_price}}</text></view><view class="store data-v-aa97ef9c" style="{{(primaryColor)}}"><image src="{{content.store_logo}}" mode="aspectFill" class="data-v-aa97ef9c"></image><text class="store-name data-v-aa97ef9c">{{content.store_name}}</text></view></view></view></view>