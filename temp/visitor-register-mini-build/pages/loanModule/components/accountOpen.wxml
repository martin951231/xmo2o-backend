<view class="account_open data-v-31e5c740"><block wx:for="{{dataList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goDetail',['$0'],[[['dataList','',index]]]]]]]}}" class="account_list data-v-31e5c740" bindtap="__e"><view class="account_top data-v-31e5c740"><view class="title data-v-31e5c740">{{item.company_name}}</view><view class="status_close data-v-31e5c740"><block wx:if="{{item.status==0}}"><view class="status type_1 data-v-31e5c740">待受理</view></block><block wx:if="{{item.status==1}}"><view class="status type_2 data-v-31e5c740">已受理</view></block><block wx:if="{{item.status==2}}"><view class="status type_2 data-v-31e5c740">申请成功</view></block><block wx:if="{{item.status==3}}"><view class="status type_3 data-v-31e5c740">已拒绝</view></block><block wx:if="{{item.status==4}}"><view class="status type_4 data-v-31e5c740">已撤销</view></block><block wx:if="{{item.status==2||item.status==3||item.status==4}}"><image class="close_icon data-v-31e5c740" src="../static/images/list_close_icon.png" mode="widthFix" data-event-opts="{{[['tap',[['deleteThis',['$0'],[[['dataList','',index]]]]]]]}}" catchtap="__e"></image></block></view></view><view class="account_middle data-v-31e5c740"><view class="people_item data-v-31e5c740"><view class="title data-v-31e5c740">姓名：</view><view class="value data-v-31e5c740">{{item.name}}</view></view><view class="people_item data-v-31e5c740"><view class="title data-v-31e5c740">手机号：</view><view class="value data-v-31e5c740">{{item.phone}}</view></view><view class="people_item data-v-31e5c740"><view class="title data-v-31e5c740">身份证号：</view><view class="value data-v-31e5c740">{{item.id_number}}</view></view></view><view class="account_bottom data-v-31e5c740"><block wx:if="{{item.status==3}}"><view data-event-opts="{{[['tap',[['reapply',['$0'],[[['dataList','',index]]]]]]]}}" class="btn data-v-31e5c740" catchtap="__e">重新申请</view></block></view></view></block><block wx:if="{{noMore}}"><view class="no_more data-v-31e5c740"> --我是有底线的-- </view></block></view>