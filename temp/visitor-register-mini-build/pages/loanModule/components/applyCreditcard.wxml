<view class="credit_card data-v-35c1e676"><block wx:for="{{dataList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goDetail',['$0'],[[['dataList','',index]]]]]]]}}" class="credit_card_list data-v-35c1e676" bindtap="__e"><view class="left_img data-v-35c1e676"><image src="{{item.cover_image}}" mode class="data-v-35c1e676"></image></view><view class="right_con data-v-35c1e676"><view class="top_status_close data-v-35c1e676"><view class="title data-v-35c1e676">{{item.title}}</view><block wx:if="{{item.status==2||item.status==3||item.status==4}}"><image class="close_icon data-v-35c1e676" src="../static/images/list_close_icon.png" mode="widthFix" data-event-opts="{{[['tap',[['deleteThis',['$0'],[[['dataList','',index]]]]]]]}}" catchtap="__e"></image></block></view><view class="desc data-v-35c1e676">{{item.label?item.label:'暂无简介'}}</view><view class="bottom_con data-v-35c1e676"><block wx:if="{{item.status==0}}"><view class="status type_1 data-v-35c1e676">待受理</view></block><block wx:if="{{item.status==1}}"><view class="status type_2 data-v-35c1e676">已受理</view></block><block wx:if="{{item.status==2}}"><view class="status type_2 data-v-35c1e676">申请成功</view></block><block wx:if="{{item.status==3}}"><view class="status type_3 data-v-35c1e676">已拒绝</view></block><block wx:if="{{item.status==4}}"><view class="status type_4 data-v-35c1e676">已撤销</view></block><block wx:if="{{item.status==3}}"><view data-event-opts="{{[['tap',[['reapply',['$0'],[[['dataList','',index]]]]]]]}}" class="button data-v-35c1e676" catchtap="__e">重新申请</view></block></view></view></view></block><block wx:if="{{noMore}}"><view class="no_more data-v-35c1e676"> --我是有底线的-- </view></block></view>