<view class="deposit_com data-v-41a026c6"><block wx:for="{{dataList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goDetail',['$0'],[[['dataList','',index]]]]]]]}}" class="deposit_list data-v-41a026c6" bindtap="__e"><view class="year_rate data-v-41a026c6"><view class="value data-v-41a026c6" style="color:#FE3334;">{{item.deposit_interest_rate+"%"}}</view><view class="title data-v-41a026c6">年利率</view></view><view class="start_money data-v-41a026c6"><view class="value data-v-41a026c6" style="color:#FE3334;">{{item.deposit_start_money+"元"}}</view><view class="title data-v-41a026c6">起始金额</view></view><view class="shelf_life data-v-41a026c6"><view class="value data-v-41a026c6">{{item.deposit_term+item.deposit_term_type_txt}}</view><view class="title data-v-41a026c6">存期</view></view><view class="right_operation data-v-41a026c6"><view class="status_close data-v-41a026c6"><block wx:if="{{item.status==0}}"><view class="status type_1 data-v-41a026c6">待受理</view></block><block wx:if="{{item.status==1}}"><view class="status type_2 data-v-41a026c6">已受理</view></block><block wx:if="{{item.status==2}}"><view class="status type_2 data-v-41a026c6">申请成功</view></block><block wx:if="{{item.status==3}}"><view class="status type_3 data-v-41a026c6">已拒绝</view></block><block wx:if="{{item.status==4}}"><view class="status type_4 data-v-41a026c6">已撤销</view></block><block wx:if="{{item.status==2||item.status==3||item.status==4}}"><image class="close_icon data-v-41a026c6" src="../static/images/list_close_icon.png" mode="widthFix" data-event-opts="{{[['tap',[['deleteThis',['$0'],[[['dataList','',index]]]]]]]}}" catchtap="__e"></image></block></view><block wx:if="{{item.status==3}}"><view data-event-opts="{{[['tap',[['reapply',['$0'],[[['dataList','',index]]]]]]]}}" class="btn data-v-41a026c6" catchtap="__e">重新申请</view></block></view></view></block><block wx:if="{{noMore}}"><view class="no_more data-v-41a026c6"> --我是有底线的-- </view></block></view>