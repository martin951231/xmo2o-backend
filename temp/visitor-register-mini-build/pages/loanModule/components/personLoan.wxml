<view class="person_loan data-v-53cc63d8"><block wx:for="{{dataList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goDetail',['$0'],[[['dataList','',index]]]]]]]}}" class="loan_list data-v-53cc63d8" bindtap="__e"><view class="left_icon data-v-53cc63d8"><image src="{{item.cover_image}}" mode class="data-v-53cc63d8"></image></view><view class="right_con data-v-53cc63d8"><view class="right_top data-v-53cc63d8"><view class="title data-v-53cc63d8">{{item.title}}</view><view class="status_close data-v-53cc63d8"><block wx:if="{{item.status==0}}"><view class="status type_1 data-v-53cc63d8">待审核</view></block><block wx:if="{{item.status==1}}"><view class="status type_2 data-v-53cc63d8">已受理</view></block><block wx:if="{{item.status==2}}"><view class="status type_2 data-v-53cc63d8">已放款</view></block><block wx:if="{{item.status==3}}"><view class="status type_3 data-v-53cc63d8">已拒绝</view></block><block wx:if="{{item.status==4}}"><view class="status type_4 data-v-53cc63d8">已撤销</view></block><block wx:if="{{item.status==2||item.status==3||item.status==4}}"><image class="close_icon data-v-53cc63d8" src="../static/images/list_close_icon.png" mode="widthFix" data-event-opts="{{[['tap',[['deleteThis',['$0'],[[['dataList','',index]]]]]]]}}" catchtap="__e"></image></block></view></view><view class="right_bottom data-v-53cc63d8"><view class="left_quota data-v-53cc63d8"><view class="quota_name data-v-53cc63d8">申请额度</view><view class="quota_txt data-v-53cc63d8"><view class="value data-v-53cc63d8">{{item.money}}</view><view class="unit data-v-53cc63d8">元</view></view></view><block wx:if="{{item.status==3}}"><view data-event-opts="{{[['tap',[['reapply',['$0'],[[['dataList','',index]]]]]]]}}" class="right_deal data-v-53cc63d8" catchtap="__e"> 重新申请 </view></block></view></view></view></block><block wx:if="{{noMore}}"><view class="no_more data-v-53cc63d8"> --我是有底线的-- </view></block></view>