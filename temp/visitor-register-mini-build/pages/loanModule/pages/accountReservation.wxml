<view class="account_reservation data-v-0e06fd2c"><view class="form_label data-v-0e06fd2c"><view class="label_title data-v-0e06fd2c">对公账号预约申请</view></view><view class="people_form data-v-0e06fd2c"><view class="enterprise_name data-v-0e06fd2c"><view class="title data-v-0e06fd2c">企业名称</view><view class="value_input data-v-0e06fd2c"><input type="text" placeholder="请输入企业名称" data-event-opts="{{[['input',[['__set_model',['$0','company_name','$event',[]],['peopleForm']]]]]}}" value="{{peopleForm.company_name}}" bindinput="__e" class="data-v-0e06fd2c"/></view></view><view class="form_line data-v-0e06fd2c"></view><view class="username data-v-0e06fd2c"><view class="title data-v-0e06fd2c">姓名</view><view class="value_input data-v-0e06fd2c"><input type="text" placeholder="请输入姓名" data-event-opts="{{[['input',[['__set_model',['$0','name','$event',[]],['peopleForm']]]]]}}" value="{{peopleForm.name}}" bindinput="__e" class="data-v-0e06fd2c"/></view></view><view class="form_line data-v-0e06fd2c"></view><view class="phone data-v-0e06fd2c"><view class="title data-v-0e06fd2c">电话</view><view class="value_input data-v-0e06fd2c"><input type="text" placeholder="请输入电话" data-event-opts="{{[['input',[['__set_model',['$0','phone','$event',[]],['peopleForm']]]]]}}" value="{{peopleForm.phone}}" bindinput="__e" class="data-v-0e06fd2c"/></view></view><view class="form_line data-v-0e06fd2c"></view></view><view hidden="{{!(hideshow)}}" class="bottom data-v-0e06fd2c"><block wx:if="{{showReadAgreement*1==1}}"><view class="read_agree data-v-0e06fd2c"><view data-event-opts="{{[['tap',[['handleAgree',['$event']]]]]}}" class="left_icon data-v-0e06fd2c" bindtap="__e"><block wx:if="{{isAgree}}"><image src="../static/images/read_icon.png" mode="widthFix" class="data-v-0e06fd2c"></image></block><block wx:else><image src="../static/images/read_noagree.png" mode="widthFix" class="data-v-0e06fd2c"></image></block></view><view class="right_read data-v-0e06fd2c">我已阅读并同意此 <view data-event-opts="{{[['tap',[['readAgreement',['$event']]]]]}}" class="user_agreement data-v-0e06fd2c" bindtap="__e">用户协议</view></view></view></block><view class="bottom_con data-v-0e06fd2c"><view data-event-opts="{{[['tap',[['applyThis',['$event']]]]]}}" class="bottom_btn data-v-0e06fd2c" bindtap="__e">提交</view></view></view></view>