<view><userinfo vue-id="2b6a4b78-1" id="user" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo><view class="container"><view class="order_info bw"><view class="good_info cf"><block wx:if="{{order_info.order_info.img}}"><view class="fl"><image src="{{order_info.order_info.img}}"></image></view></block><view class="fl intro"><view class="name">{{order_info.order_info.order_name}}</view><block wx:if="{{order_info.order_info.order_txt_type!=0}}"><view class="info">{{order_info.order_info.order_txt_type}}</view></block><block wx:else><view class="info">{{order_info.order_info.order_price+" X "+order_info.order_info.order_num}}</view></block></view></view><view class="order_price cf"><view class="fl">订单总计</view><view class="fr cr fw">{{''+(currency+order_info.order_info.order_total_money)+''}}</view></view></view><block wx:if="{{order_info.pay_config.is_recharge!=1}}"><block><view class="tip">结算信息</view><view class="balanceBox bw"><block wx:if="{{order_info.pay_config.card_discount!=0}}"><view class="item cf"><view class="fl">会员卡折扣</view><view class="fr cr">{{order_info.pay_config.card_discount+"折"}}</view></view></block><block wx:if="{{order_info.order_info.pay_merchant_coupon!==false}}"><view data-event-opts="{{[['tap',[['changeMerchantCoupon',['$event']]]]]}}" class="item cf" bindtap="__e"><view class="fl">商家优惠券</view><block wx:if="{{order_info.mer_coupon.had_id==''}}"><view class="fr select no">不使用优惠券</view></block><block wx:if="{{order_info.mer_coupon.had_id!=''}}"><view class="fr select"><block wx:if="{{order_info.mer_coupon.order_money>0}}"><block>{{"满"+order_info.mer_coupon.order_money+"减"+order_info.mer_coupon.discount}}</block></block><block wx:else><block>{{"无门槛立减"+order_info.mer_coupon.discount}}</block></block></view></block></view></block><block wx:if="{{order_info.order_info.pay_system_coupon!==false}}"><view data-event-opts="{{[['tap',[['changeSystemCoupon',['$event']]]]]}}" class="item cf" bindtap="__e"><view class="fl">平台优惠券</view><block wx:if="{{order_info.system_coupon.had_id==''}}"><view class="fr select no">不使用优惠券</view></block><block wx:if="{{order_info.system_coupon.had_id!=''}}"><view class="fr select">{{'满'+order_info.system_coupon.order_money+"减"+order_info.system_coupon.discount+''}}</view></block></view></block><block wx:if="{{order_info.pay_config.score_count!=0}}"><view class="item cf"><view class="fl">{{'本单可使用'+config.score_name+''}}<text class="cr">{{order_info.pay_config.score_count+"分"}}</text> ,可抵扣金额 <view class="cr block-in">{{''+(currency+order_info.pay_config.score_money)+''}}</view></view><view class="fr"><checkbox-group bindchange="changeScore"><checkbox value="1" checked="{{use_score?true:false}}"></checkbox></checkbox-group></view></view></block><block wx:if="{{order_info.pay_config.merchant_money!=0}}"><view class="item cf"><view class="fl"><view>使用商家会员卡余额</view><view class="cr">{{'剩余\n\t\t\t\t\t\t\t'+(currency+order_info.pay_config.merchant_money)+''}}</view></view><view class="fr"><checkbox-group bindchange="changeMm"><checkbox value="1" checked="{{use_merchant_money?true:false}}"></checkbox></checkbox-group></view></view></block><block wx:if="{{order_info.pay_config.balance_money!=0}}"><view class="item cf"><view class="fl"><view>使用余额支付</view><view class="cr">{{'剩余\n\t\t\t\t\t\t\t'+(currency+order_info.pay_config.balance_money)+''}}</view></view><view class="fr"><checkbox-group bindchange="changePm"><checkbox value="1" checked="{{use_balance_money?true:false}}"></checkbox></checkbox-group></view></view></block><view class="item cf"><view class="fr" style="text-align:right;"><view> 实际支付： <view class="cr block-in">{{''+(currency+order_info.pay_config.pay_infact)+''}}</view></view><view style="color:#999;font-size:11px;">(运费不参与打折，部分商品不可用商家优惠券)</view></view></view></view></block></block><block wx:if="{{order_info.pay_config.online_pay!=0}}"><block><view class="tip">选择支付方式</view><radio-group bindchange="changePaymethod"><view class="balanceBox bw pay"><block wx:for="{{order_info.pay_method}}" wx:for-item="item" wx:for-index="pay_method" wx:key="pay_method"><block><block wx:if="{{item.type=='weixin'||item.type=='offline'||item.type=='merchantwarrior'}}"><view class="item cf"><view class="fl"><image src="{{item.pic}}"></image><text>{{item.name}}</text></view><view class="fr"><radio value="{{item.type}}" checked="{{checked_pay==item.type?true:false}}"></radio></view></view></block></block></block></view></radio-group></block></block><view class="footer_box"><block wx:if="{{order_info.pay_config.online_pay!=0}}"><view class="block-in">{{'还需在线支付\n\t\t\t\t'+(currency+order_info.pay_config.online_pay)+''}}</view></block><view data-event-opts="{{[['tap',[['payOrder',['$event']]]]]}}" class="fr" style="{{(click_confirm?'background:#999;':'')}}" bindtap="__e"><view>确认支付</view></view></view></view></view>