<view style="height:100%;"><view class="search-wrapper rel border-b"><view class="search flex flex-center"><text class="iconfont icon-sousuo1"></text><input class="ml5" placeholder="{{placeholder}}" data-event-opts="{{[['input',[['inputHandle',['$event']]]]]}}" value="{{input_value}}" bindinput="__e"/><block wx:if="{{input_value!=''}}"><text data-event-opts="{{[['tap',[['clearInput',['$event']]]]]}}" class="iconfont icon-cha1 ml5 rel" catchtap="__e"></text></block></view></view><scroll-view style="height:100%;" scroll-y="true" scroll-into-view="{{scroll_to}}"><block wx:if="{{address_info.now_city&&status==''}}"><view class="address-wrapper"><view class="title"><lang vue-id="6de0599e-1" keywords="你所在的地区" bind:__l="__l"></lang></view><block wx:if="{{address_info.now_city.city_id}}"><view class="flex flex-between flex-center now mb10"><text class="address border" data-area_id="{{address_info.now_city.area_id}}" data-city_id="{{address_info.now_city.city_id}}" data-name="{{address_info.now_city.area_name}}" data-event-opts="{{[['tap',[['selectNowAddress',['$event']]]]]}}" catchtap="__e">{{address_info.now_city.area_name}}</text></view></block><block wx:if="{{$root.g0}}"><block><view class="title"><lang vue-id="6de0599e-2" keywords="历史访问目的地" bind:__l="__l"></lang></view><view class="flex flex-wrap flex-center select-box"><block wx:for="{{history_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><text class="item border" data-word="history" data-index="{{index}}" data-event-opts="{{[['tap',[['selectArea',['$event']]]]]}}" catchtap="__e">{{item.area_name}}</text></block></view></block></block><block wx:for="{{address_info.all_city}}" wx:for-item="items" wx:for-index="index" wx:key="index"><view><view class="title" id="{{index}}">{{index}}</view><block wx:for="{{address_info.all_city[index]}}" wx:for-item="city" wx:for-index="top_index" wx:key="top_index"><view class="rel border-b select-box"><view class="flex flex-between flex-center" data-word="{{index}}" data-index="{{top_index}}" data-area_id="{{city.area_id}}" data-city_id="{{city.city_id}}" data-name="{{city.area_name}}" data-event-opts="{{[['tap',[['selectArea',['$event']]]]]}}" catchtap="__e"><text class="name">{{city.area_name}}</text></view></view></block></view></block></view></block><block wx:if="{{status=='search'}}"><view><block wx:if="{{$root.g1>0}}"><view class="search-list"><block wx:for="{{search_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="rel border-b item" data-word="search" data-index="{{index}}" data-event-opts="{{[['tap',[['selectArea',['$event']]]]]}}" catchtap="__e">{{item.now_area_name}}</view></block></view></block><block wx:if="{{$root.g2}}"><view class="search-empty"><lang vue-id="6de0599e-3" keywords="无结果" bind:__l="__l"></lang></view></block></view></block></scroll-view><block wx:if="{{status==''}}"><view class="word-list" catchtouchmove="touchmove"><block wx:for="{{address_info.all_city}}" wx:for-item="item" wx:for-index="index" wx:key="index"><text class="item" data-word="{{index}}" data-event-opts="{{[['tap',[['selectWord',['$event']]]]]}}" catchtap="__e">{{index}}</text></block></view></block><block wx:if="{{scroll_to!=''}}"><view class="wrod-popup">{{scroll_to}}</view></block></view>