<view style="height:100%;"><view class="search-wrapper rel border-b"><view class="search flex flex-center"><text class="iconfont icon-sousuo1"></text><input class="ml5" placeholder="{{placeholder}}" data-event-opts="{{[['input',[['inputHandle',['$event']]]]]}}" value="{{input_value}}" bindinput="__e"/><block wx:if="{{input_value!=''}}"><text data-event-opts="{{[['tap',[['clearInput',['$event']]]]]}}" class="iconfont icon-cha1 ml5 rel" catchtap="__e"></text></block></view></view><scroll-view style="height:100%;" scroll-y="true" scroll-into-view="{{scroll_to}}"><block wx:if="{{address_info.now_city&&status==''}}"><view class="address-wrapper"><view class="title"><lang vue-id="1c35ae5f-1" keywords="你所在的地区" bind:__l="__l"></lang></view><block wx:if="{{$root.g0>0}}"><view class="flex flex-between flex-center now mb10"><text class="address border" data-name="{{address_info.now_city[0].top_city.area_name}}" data-event-opts="{{[['tap',[['selectNowAddress',['$event']]]]]}}" catchtap="__e">{{address_info.now_city[0].top_city.area_name+(address_info.now_city[0].top_city.area_name==address_info.now_city[0].area_name?'':'-'+address_info.now_city[0].area_name)}}</text><block wx:if="{{pageFrom!='kuaidian'}}"><view class="btn gray" data-type="now" data-name="{{address_info.now_city[0].top_city.area_name}}" data-event-opts="{{[['tap',[['showArea',['$event']]]]]}}" catchtap="__e"><lang vue-id="1c35ae5f-2" keywords="选择区县" bind:__l="__l"></lang><block wx:if="{{show_area=='now'}}"><text class="iconfont icon-jiantou1 ml5"></text></block><block wx:else><text class="iconfont icon-xiala ml5"></text></block></view></block></view></block><block wx:if="{{show_area=='now'}}"><view class="flex flex-wrap flex-center select-box"><view class="{{['block-in item border '+(address_info.now_city[0].top_city.area_name==address_info.now_city[0].area_name?'bg-gray':'')]}}" data-word="now" data-index="all" data-event-opts="{{[['tap',[['selectArea',['$event']]]]]}}" catchtap="__e"><lang vue-id="1c35ae5f-3" keywords="全城" bind:__l="__l"></lang></view><block wx:for="{{address_info.now_city[0].child}}" wx:for-item="item" wx:for-index="index" wx:key="index"><text class="{{['item border '+(item.area_id==address_info.now_city[0].area_id?'bg-gray':'')]}}" data-word="now" data-index="{{index}}" data-event-opts="{{[['tap',[['selectArea',['$event']]]]]}}" catchtap="__e">{{item.area_name}}</text></block></view></block><block wx:if="{{$root.g1}}"><block><view class="title"><lang vue-id="1c35ae5f-4" keywords="历史访问目的地" bind:__l="__l"></lang></view><view class="flex flex-wrap flex-center select-box"><block wx:for="{{history_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><text class="item border" data-word="history" data-index="{{index}}" data-event-opts="{{[['tap',[['selectArea',['$event']]]]]}}" catchtap="__e">{{item.area_name}}</text></block></view></block></block><block wx:for="{{$root.l1}}" wx:for-item="word" wx:for-index="index" wx:key="index"><view><view class="title" id="{{word.$orig}}">{{word.$orig}}</view><block wx:for="{{word.l0}}" wx:for-item="city" wx:for-index="top_index" wx:key="top_index"><view class="rel border-b select-box"><block wx:if="{{city.g2>0}}"><block><view class="flex flex-between flex-center" data-type="{{city.$orig.area_id}}" data-name="{{city.$orig.area_name}}" data-event-opts="{{[['tap',[['showArea',['$event']]]]]}}" catchtap="__e"><text class="name">{{city.$orig.area_name}}</text><block wx:if="{{pageFrom!='kuaidian'}}"><view class="btn"><block wx:if="{{show_area==city.$orig.area_id}}"><text class="iconfont icon-jiantou1 gray"></text></block><block wx:else><text class="iconfont icon-xiala gray"></text></block></view></block></view><block wx:if="{{show_area==city.$orig.area_id}}"><view class="flex flex-wrap flex-center select-box pd10"><view class="block-in item border" data-word="{{word.$orig}}" data-index="{{top_index}}" data-two="all" data-event-opts="{{[['tap',[['selectArea',['$event']]]]]}}" catchtap="__e"><lang vue-id="{{'1c35ae5f-5-'+index+'-'+top_index}}" keywords="全城" bind:__l="__l"></lang></view><block wx:for="{{city.$orig.child}}" wx:for-item="item" wx:for-index="index" wx:key="index"><text class="item border" data-word="{{word.$orig}}" data-index="{{top_index}}" data-two="{{index}}" data-event-opts="{{[['tap',[['selectArea',['$event']]]]]}}" catchtap="__e">{{item.area_name}}</text></block></view></block></block></block><block wx:else><block><view class="flex flex-between flex-center" data-word="{{word.$orig}}" data-index="{{top_index}}" data-two="all" data-event-opts="{{[['tap',[['selectArea',['$event']]]]]}}" catchtap="__e"><text class="name">{{city.$orig.area_name}}</text></view></block></block></view></block></view></block></view></block><block wx:if="{{status=='search'}}"><view><block wx:if="{{$root.g3>0}}"><view class="search-list"><block wx:for="{{search_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="rel border-b item" data-word="search" data-index="{{index}}" data-event-opts="{{[['tap',[['selectArea',['$event']]]]]}}" catchtap="__e">{{item.now_area_name+(item.now_area_name==item.area_name?'':' '+item.area_name)}}</view></block></view></block><block wx:if="{{$root.g4}}"><view class="search-empty"><lang vue-id="1c35ae5f-6" keywords="无结果" bind:__l="__l"></lang></view></block></view></block></scroll-view><block wx:if="{{status==''}}"><view class="word-list" catchtouchmove="touchmove"><block wx:for="{{address_info.aCity}}" wx:for-item="item" wx:for-index="index" wx:key="index"><text class="item" data-word="{{item}}" data-event-opts="{{[['tap',[['selectWord',['$event']]]]]}}" catchtap="__e">{{item}}</text></block></view></block><block wx:if="{{scroll_to!=''}}"><view class="wrod-popup">{{scroll_to}}</view></block></view>