<block wx:if="{{pageInfo}}"><view class="wrapBox" style="background:#000;"><userinfo vue-id="02b1bda2-1" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo><view class="wrapBox_alap" style="{{'background-image:'+(pageInfo.image!=''?'url('+pageInfo.image+')':pageInfo.diypage_bgcolor)+';'+('background-size:'+('cover')+';')+('background-repeat:'+('no-repeat')+';')+('background-position:'+('center')+';')}}"></view><view class="wrapBox_con"><view class="wrapBox_til"><navigator url="#" hover-class="navigator-hover"><view class="text">{{pageInfo.name}}</view></navigator><view data-event-opts="{{[['tap',[['click_collect',['$event']]]]]}}" class="collect_icon" bindtap="__e"><block wx:if="{{!is_collect}}"><view class="iconbox"><text class="iconfont icon-star" style="color:#e6e6e6;"></text></view></block><view class="collect">{{collect_tip}}</view></view></view><view class="wrapBox_lab"><block wx:if="{{pageInfo.is_own==true}}"><view class="lab lab_i"><lang vue-id="02b1bda2-2" keywords="自营" bind:__l="__l"></lang></view></block><view class="lab lab_z"><lang vue-id="02b1bda2-3" keywords="综合评分" bind:__l="__l"></lang><view class="xing2"><view class="xing1" style="{{'width:'+(pageInfo.score_mean>0||pageInfo.score_mean<5?64-pageInfo.score_mean/5*64+'px':'0px')+';'}}"></view></view></view><view class="lab"><lang vue-id="02b1bda2-4" keywords="粉丝数X1" X1="{{pageInfo.fans}}" bind:__l="__l"></lang></view></view></view></view></block>