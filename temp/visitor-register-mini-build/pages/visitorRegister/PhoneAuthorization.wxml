<view class="{{['phone-overlay','data-v-7c918dfc',(visible&&entered)?'open':'']}}"><view data-event-opts="{{[['tap',[['$emit',['cancel']]]]]}}" class="phone-mask data-v-7c918dfc" bindtap="__e"></view><view class="phone-sheet data-v-7c918dfc"><view class="phone-title data-v-7c918dfc">授权手机号</view><view class="phone-notice data-v-7c918dfc">为本小区来访登记与安全管理，我们使用微信身份标识关联您当天的登记记录，收集授权的手机号及您填写的登记信息，由有权限的物业人员查看和处理。如需查询、更正或删除，请联系本小区物业服务中心。</view><checkbox-group data-event-opts="{{[['change',[['$emit',['consent','$event']]]]]}}" bindchange="__e" class="data-v-7c918dfc"><label class="phone-agreement data-v-7c918dfc"><checkbox value="agree" checked="{{consent}}" color="#3d7eff" class="data-v-7c918dfc"></checkbox>我已阅读并同意个人信息收集告知</label></checkbox-group><button class="phone-authorize data-v-7c918dfc" open-type="getPhoneNumber" disabled="{{!consent||!ready||busy}}" loading="{{busy}}" data-event-opts="{{[['getphonenumber',[['$emit',['authorize','$event']]]]]}}" bindgetphonenumber="__e">点击授权</button><button data-event-opts="{{[['tap',[['$emit',['cancel']]]]]}}" class="phone-cancel data-v-7c918dfc" bindtap="__e">取消</button></view></view>