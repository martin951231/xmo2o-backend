.registration{background:#f5f6f8;padding:32rpx;min-height:100vh;box-sizing:border-box;color:#333}.registration .field{background:#fff;padding:26rpx;border-bottom:1rpx solid #eee}.registration .label{font-size:28rpx;margin-bottom:16rpx}.registration .required{color:#e5484d;margin-right:8rpx}.registration input{font-size:28rpx;height:62rpx}.registration textarea{width:100%;font-size:28rpx;height:150rpx}.registration .privacy, .registration .hint{font-size:24rpx;color:#777;line-height:1.7}.registration .privacy{margin:30rpx 0 20rpx}.registration .consent{display:flex;align-items:center;font-size:25rpx}.registration .submit{background:#3d7eff;color:#fff;border-radius:12rpx;margin:36rpx 0}.registration .submit[disabled]{opacity:.6}.registration .notice{padding:80rpx 20rpx;text-align:center;line-height:2}.registration .authorize-button{display:inline-block;background:#3d7eff;color:#fff;border-radius:10rpx;font-size:24rpx;line-height:60rpx;padding:0 28rpx;margin:16rpx 0}.registration .authorize-button[disabled]{background:#3d7eff;color:#fff;opacity:.7}.registration .authorize-button::after{border:none}