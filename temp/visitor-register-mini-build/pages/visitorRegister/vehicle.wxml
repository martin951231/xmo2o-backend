<view><registration-nav vue-id="ce5c127e-1" theme="{{registrationTheme}}" village-id="{{villageId}}" title="外来车辆出入登记" bind:__l="__l"></registration-nav><view class="registration"><block wx:if="{{checking}}"><view class="notice">正在查询登记状态…</view></block><block wx:else><block wx:if="{{!available}}"><view class="notice">{{statusMessage}}<block wx:if="{{villageId}}"><button data-event-opts="{{[['tap',[['checkStatus',['$event']]]]]}}" bindtap="__e">重新查询</button></block></view></block><block wx:else><view><block wx:if="{{prefilled}}"><view class="hint">已填入您今天最近一次登记的信息，请确认本次来访内容。</view></block><view class="field"><view class="label"><text class="required">*</text>车牌号码</view><input maxlength="8" placeholder="普通或新能源车牌，如晋E12345" data-event-opts="{{[['input',[['__set_model',['$0','plate_number','$event',[]],['form']]]]]}}" value="{{form.plate_number}}" bindinput="__e"/></view><view class="field"><view class="label"><text class="required">*</text>进入时间</view><date-time-field bind:input="__e" vue-id="ce5c127e-2" value="{{form.entry_time}}" data-event-opts="{{[['^input',[['__set_model',['$0','entry_time','$event',[]],['form']]]]]}}" bind:__l="__l"></date-time-field></view><view class="field"><view class="label">离开时间（选填）</view><date-time-field bind:input="__e" vue-id="ce5c127e-3" optional="{{true}}" value="{{form.exit_time}}" data-event-opts="{{[['^input',[['__set_model',['$0','exit_time','$event',[]],['form']]]]]}}" bind:__l="__l"></date-time-field><view class="hint">未知可留空，离场后由物业工作人员补录</view></view><view class="field"><view class="label"><text class="required">*</text>车辆去向</view><input maxlength="120" placeholder="请输入车辆去向" data-event-opts="{{[['input',[['__set_model',['$0','destination','$event',[]],['form']]]]]}}" value="{{form.destination}}" bindinput="__e"/></view><view data-event-opts="{{[['tap',[['e0',['$event']]]]]}}" class="field" bindtap="__e"><view class="label"><text class="required">*</text>联系电话</view><input disabled="{{true}}" placeholder="点击此处授权填入手机号" value="{{form.phone}}"/></view><view class="hint">每次扫码重新生成进入时间，离开时间请按本次实际情况填写。</view><button class="submit" loading="{{submitting}}" disabled="{{submitting||phoneAuthorizing}}" data-event-opts="{{[['tap',[['submitRegistration',['$event']]]]]}}" bindtap="__e">提交登记</button></view></block></block></view><phone-authorization vue-id="ce5c127e-4" visible="{{showPhoneAuth}}" consent="{{consent}}" busy="{{phoneAuthorizing}}" ready="{{!!authToken}}" data-event-opts="{{[['^consent',[['consentChanged']]],['^authorize',[['authorizePhone']]],['^cancel',[['e1']]]]}}" bind:consent="__e" bind:authorize="__e" bind:cancel="__e" bind:__l="__l"></phone-authorization></view>