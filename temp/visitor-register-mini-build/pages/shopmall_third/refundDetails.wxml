<view class="header_banner data-v-28914d74"><view class="header_container data-v-28914d74"><view class="backgroundbox data-v-28914d74"><image src="{{$root.m0}}" alt class="_img data-v-28914d74"></image></view><view class="refund_statebox data-v-28914d74"><view class="title_block data-v-28914d74"><view class="pagetitle data-v-28914d74">{{orderList.status==0?'等待卖家处理':orderList.status==1?'申请通过':orderList.status==2?'申请失败':'售后关闭'}}</view></view><block wx:if="{{orderList.count_down}}"><view class="subtitle_box data-v-28914d74">{{"还剩余"+$root.f0}}</view></block></view><block wx:if="{{orderList.status==2}}"><view class="refund_reason data-v-28914d74">{{'未通过原因：'+orderList.refund_info.audit_reason+''}}</view></block><view class="address_container data-v-28914d74"><view class="refund data-v-28914d74"><view class="topinfobox data-v-28914d74"><view class="name data-v-28914d74">{{orderList.merchant_info.name}}</view><view class="phone data-v-28914d74">{{orderList.merchant_info.phone}}</view></view><view class="store_address data-v-28914d74">{{"商家地址："+orderList.merchant_info.address}}</view><block wx:if="{{orderList.status==0||orderList.status==-1}}"><view class="button_bar data-v-28914d74"><view data-event-opts="{{[['tap',[['callSeller']]]]}}" class="button_grey data-v-28914d74" bindtap="__e">联系卖家</view><view data-event-opts="{{[['tap',[['copyAddress',['$0'],['orderList.merchant_info.address']]]]]}}" class="button_grey data-v-28914d74" bindtap="__e">复制地址</view><block wx:if="{{orderList.status==0}}"><view data-event-opts="{{[['tap',[['revokeApply']]]]}}" class="button_orange data-v-28914d74" bindtap="__e"> 撤销申请 </view></block></view></block><block wx:else><view class="button_bar data-v-28914d74"><block wx:if="{{orderList.again==1||orderList.status==2}}"><view data-event-opts="{{[['tap',[['againApply']]]]}}" class="button_orange data-v-28914d74" bindtap="__e"> 再次申请 </view></block><view data-event-opts="{{[['tap',[['callSeller']]]]}}" class="button_grey data-v-28914d74" bindtap="__e">联系卖家</view><view data-event-opts="{{[['tap',[['copyAddress',['$0'],['orderList.merchant_info.address']]]]]}}" class="button_grey data-v-28914d74" bindtap="__e">复制地址</view></view></block></view></view></view><view class="refund_wrapper data-v-28914d74"><view class="title_block data-v-28914d74">退款信息</view><block wx:for="{{refundList.refund_list}}" wx:for-item="it" wx:for-index="index" wx:key="index"><view class="goods_modular data-v-28914d74"><view class="goodsrightbox data-v-28914d74"><view class="goodspic data-v-28914d74"><image style="width:100%;height:100%;border-radius:10rpx;" src="{{it.image}}" mode="aspectFill" class="data-v-28914d74"></image></view><view class="goodsinfo data-v-28914d74"><view class="goodsname data-v-28914d74">{{it.goods_name}}</view><view style="display:flex;align-items:center;margin-top:15rpx;justify-content:space-between;" class="data-v-28914d74"><view class="goodsizebox data-v-28914d74">{{it.sku_str}}</view><view class="countbox data-v-28914d74">{{"×"+it.num}}</view></view><view class="goodsname data-v-28914d74" style="color:#DE3F27;font-size:30rpx;">{{currency+it.goods_price}}</view></view></view></view></block><view class="jzbox data-v-28914d74"><view class="order_options data-v-28914d74"><view class="optionskey data-v-28914d74">退款原因:</view><view class="optionsvalue data-v-28914d74">{{refundList.reason}}</view></view><view class="order_options data-v-28914d74"><view class="optionskey data-v-28914d74">退款金额:</view><view class="optionsvalue data-v-28914d74">{{currency+refundList.money}}</view></view><view class="order_options data-v-28914d74"><view class="optionskey data-v-28914d74">{{(goods_activity_type=='periodic'?'申请期数':'申请件数')+":"}}</view><view class="optionsvalue data-v-28914d74">{{refundList.nums}}</view></view></view><view class="imgList data-v-28914d74"><block wx:for="{{refundList.imgs}}" wx:for-item="item" wx:for-index="index" wx:key="index"><image src="{{item}}" class="data-v-28914d74"></image></block></view></view></view>