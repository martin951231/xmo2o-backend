<view data-event-opts="{{[['touchmove',[['moveHandle',['$event']]]]]}}" class="bargainModel_model_wrapper" catchtouchmove="__e"><view class="alert_wrapper"><view class="avatar"><image src="{{bargainWin.user_image}}"></image></view><block wx:if="{{bargainWin.is_my_bar==1}}"><view class="title"> 恭喜您已砍价 <text style="color:#FF0C18;">{{bargainWin.bargain_money+currency_txt}}</text></view></block><block wx:if="{{bargainWin.activity_status==1&&bargainWin.is_my_bar!=1}}"><view class="title"> 谢谢你帮我砍价成功 </view></block><block wx:if="{{bargainWin.activity_status==0&&bargainWin.is_my_bar!=1}}"><view class="title"> 谢谢你帮我砍了 <text style="color:#FF0C18;">{{bargainWin.bargain_money+currency_txt}}</text></view></block><block wx:if="{{bargainWin.activity_status==2||bargainWin.activity_status==3}}"><view class="title"><view>很抱歉砍价失败</view><view>{{bargainWin.msg}}</view></view></block><view class="shop-info"><view class="shop-info-left"><image src="{{bargainWin.goods_image}}"></image></view><view class="shop-info-right"><view class="shop-info-right-tit">{{bargainWin.goods_name}}</view><view class="shop-info-right-kan"><text style="color:#FF0C18;">{{bargainWin.bargain_success+"人"}}</text> 已砍成 </view></view></view><block wx:if="{{bargainWin.activity_status!=1}}"><view class="detailbox"><view class="bargaining_info"> 已砍 <label class="_span">{{bargainWin.bar_total_price}}</label>{{''+currency_txt+'，仅剩'}}<label class="_span">{{bargainWin.left_bargain}}</label>{{''+currency_txt+''}}</view><view class="progress_bar" style="{{(bargainWin.activity_status==2||bargainWin.activity_status==3?{background:' #EEEEEE'}:{background:' #ffe5e3'})}}"><view class="percentbox" style="{{(bargainWin.activity_status==2||bargainWin.activity_status==3?{background:' #c1c1c1',width:$root.m0/($root.m1+$root.m2)*100+'%'}:{background:' #ff3119',width:$root.m3/($root.m4+$root.m5)*100+'%'})}}"></view></view></view></block><block wx:if="{{bargainWin.is_my_bar==1}}"><view data-event-opts="{{[['tap',[['shareBargain',['$event']]]]]}}" class="bargain-btn" bindtap="__e"><text class="text" style="left:136rpx;">找人砍价</text><image class="img" style="width:395rpx;height:93rpx;" src="../static/bargainBtn.png"></image></view></block><block wx:if="{{bargainWin.activity_status!=2&&bargainWin.is_my_bar!=1}}"><view data-event-opts="{{[['tap',[['navTo',['/pages/shopmall_third/commodity_details?goods_id='+bargainWin.goods_id]]]]]}}" class="bargain-btn" style="{{(bargainWin.activity_status!=2&&bargainWin.is_my_bar!=1?'margin-bottom: 0':'')}}" bindtap="__e"><text class="text">我也去砍价</text><image class="img" style="width:395rpx;height:93rpx;" src="../static/bargainBtn.png"></image></view></block><block wx:if="{{bargainWin.is_my_bar!=1}}"><view data-event-opts="{{[['tap',[['navTo',['/pages/shopmall_third/bargaining']]]]]}}" class="bargain-btn" style="{{(bargainWin.activity_status!=2&&bargainWin.is_my_bar!=1?'margin-top: 10rpx':'')}}" bindtap="__e"><text class="text">查看更多砍价</text><image class="img" style="width:395rpx;height:93rpx;" src="../static/bargainBtn.png"></image></view></block></view><view data-event-opts="{{[['tap',[['bargainBox',['$event']]]]]}}" class="shadowbox" bindtap="__e"></view></view>