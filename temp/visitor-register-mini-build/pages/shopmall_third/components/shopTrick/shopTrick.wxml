<block wx:if="{{pageInfo}}"><view class="wrapBox" style="background:#000;"><userinfo vue-id="47c94a40-1" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo><view class="wrapBox_alap" style="{{'background-image:'+(pageInfo.image!=''?'url('+pageInfo.image+')':pageInfo.diypage_bgcolor)+';'+('background-size:'+('cover')+';')+('background-repeat:'+('no-repeat')+';')+('background-position:'+('center')+';')}}"></view><view class="wrapBox_con"><view class="wrapBox_til"><view class="title"><view class="text">{{pageInfo.name}}</view><block wx:if="{{pageInfo.business_qualifications&&requestDomain}}"><view data-event-opts="{{[['tap',[['toQualification',['$event']]]]]}}" bindtap="__e"><image class="qualification" src="{{requestDomain+'/static/wxapp/mall/qualification_certificate.png'}}" mode="widthFix"></image></view></block></view><view data-event-opts="{{[['tap',[['click_collect',['$event']]]]]}}" class="collect_icon" bindtap="__e"><block wx:if="{{!is_collect}}"><view class="iconbox"><text class="iconfont icon-star" style="color:#e6e6e6;"></text></view></block><view class="collect">{{collect_tip}}</view></view></view><view class="wrapBox_lab"><block wx:if="{{pageInfo.is_own==true}}"><view class="lab lab_i">自营</view></block><view class="lab lab_z">综合评分 <view class="xing2"><view class="xing1" style="{{'width:'+(pageInfo.score_mean>0||pageInfo.score_mean<5?64-pageInfo.score_mean/5*64+'px':'0px')+';'}}"></view></view></view><view class="lab">{{"粉丝数"+pageInfo.fans}}</view></view></view></view></block>