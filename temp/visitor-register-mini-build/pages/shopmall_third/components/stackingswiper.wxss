.hha{width:526rpx}.swiperPanel{height:180rpx;width:100%;overflow:hidden;position:relative}.swiperPanel .swiperItem{height:100%;width:100%;position:absolute;top:0;left:0;transition:all .5s}.swiperPanel .swiperItem .children{height:100%;width:480rpx}.swiperPanel .swiperItem .children .pic{height:100%;width:100%;border-radius:16rpx}.swiperPanel .subscript_box{position:absolute;bottom:10rpx;z-index:999999;display:flex;width:100%;align-items:center;justify-content:center}.swiperPanel .subscript_box .subscript_items{width:8rpx;height:5rpx;background:hsla(0,0%,100%,.5);border-radius:3rpx;margin-left:2rpx;margin-right:2rpx}.swiperPanel .subscript_box .subscript_items_active{width:10rpx;height:5rpx;background:#fff}