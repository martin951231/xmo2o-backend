.richtext_container{width:100%;display:flex;flex-direction:column;align-items:center}.richtext_container .switch_tab{width:100%;height:80rpx;display:flex;align-items:center;justify-content:center}.richtext_container .switch_tab .switch_items{width:170rpx;height:100%;display:flex;align-items:center;justify-content:center}.richtext_container .switch_tab .switch_items .switch_text{font-size:24rpx;font-weight:500;color:#333}.richtext_container .switch_tab .switch_items .switch_text_active{color:#06c1ae}.richtext_container .box{width:100%}.richtext_container .imageDetail{margin-bottom:22rpx}.richtext_container .imageDetail  ._p{padding:0rpx 20rpx}.richtext_container .imageDetail.non-tab{margin-top:22rpx}.richtext_container .line{width:calc(100vw - 40rpx);height:1rpx;background-color:#f2f2f2;margin:0 auto}.richtext_container .crossed_price{padding:0 20rpx;margin:32rpx 0 26rpx}.richtext_container .crossed_price .title{width:100%;font-size:24rpx;box-sizing:border-box;font-weight:500;color:#666;margin-bottom:25rpx}.richtext_container .crossed_price .text_content{font-size:20rpx;font-weight:500;color:#999;line-height:40rpx}.imageDetail  ._img, .special-param  ._img, .pack-sale  ._img{width:100%;display:block}