<block wx:if="{{activity}}"><view class="countdown_activity"><label style="{{('background:'+color+';font-size:'+fontsize+'rpx;min-width:'+(size+4)+'rpx;height:'+size+'rpx;line-height:'+size+'rpx')}}" class="_span">{{day}}</label> 天 <label style="{{('background:'+color+';font-size:'+fontsize+'rpx;min-width:'+(size+4)+'rpx;height:'+size+'rpx;line-height:'+size+'rpx')}}" class="_span">{{hour}}</label> 小时 <label style="{{('background:'+color+';font-size:'+fontsize+'rpx;min-width:'+(size+4)+'rpx;height:'+size+'rpx;line-height:'+size+'rpx')}}" class="_span">{{minutes}}</label> 分钟 <label style="{{('background:'+color+';font-size:'+fontsize+'rpx;min-width:'+(size+4)+'rpx;height:'+size+'rpx;line-height:'+size+'rpx')}}" class="_span">{{''+secondtrue+''}}</label> 秒 </view></block><block wx:else><view class="{{[(true)?'countdown_container':'',(wipeFlag)?'wipe-contain':'']}}"><block wx:if="{{$root.m0}}"><view>{{$root.m1+"天"}}</view></block><label class="wipe-contain-item _span" style="{{('color:'+fcolor+';background:'+color+';font-size:'+fontsize+'rpx;width:'+(size+4)+'rpx;height:'+size+'rpx;line-height:'+size+'rpx')}}">{{hour}}</label> : <label class="wipe-contain-item _span" style="{{('color:'+fcolor+';background:'+color+';font-size:'+fontsize+'rpx;width:'+(size+4)+'rpx;height:'+size+'rpx;line-height:'+size+'rpx')}}">{{minutes}}</label> : <label class="wipe-contain-item _span" style="{{('color:'+fcolor+';background:'+color+';font-size:'+fontsize+'rpx;width:'+(size+4)+'rpx;height:'+size+'rpx;line-height:'+size+'rpx')}}">{{''+secondtrue+''}}</label></view></block>