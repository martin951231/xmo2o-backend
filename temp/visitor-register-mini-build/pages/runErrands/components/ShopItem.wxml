<view class="shop-item-wrap data-v-bdb1fb28"><view class="shop-item data-v-bdb1fb28"><view class="left data-v-bdb1fb28"><view class="shop-name data-v-bdb1fb28" style="{{(shop.is_close?'color: #999':'')}}">{{shop.name}}</view><block wx:if="{{shop.kefu_phone}}"><view class="data-v-bdb1fb28"><block wx:if="{{shop.is_close}}"><view class="shop-phone data-v-bdb1fb28"><image class="shop-img data-v-bdb1fb28" src="../static/images/phone.png"></image><text class="contact data-v-bdb1fb28" style="color:#999999;">联系商家</text></view></block><block wx:else><view class="shop-phone data-v-bdb1fb28"><image class="shop-img data-v-bdb1fb28" src="../static/images/phone2.png" data-event-opts="{{[['tap',[['callPhone',['$0'],['shop.kefu_phone']]]]]}}" catchtap="__e"></image><text data-event-opts="{{[['tap',[['callPhone',['$0'],['shop.kefu_phone']]]]]}}" class="contact data-v-bdb1fb28" style="color:#25ADFF;" catchtap="__e">联系商家</text></view></block></view></block></view><view class="right data-v-bdb1fb28"><block wx:if="{{shop.logo}}"><image class="shop-img data-v-bdb1fb28" src="{{shop.logo}}" lazy-load="{{true}}"></image></block><block wx:else><view class="shop-img no-img data-v-bdb1fb28"></view></block><block wx:if="{{shop.is_close}}"><view class="tag data-v-bdb1fb28">未营业</view></block></view></view><view class="delivery-mouthSale data-v-bdb1fb28"><text class="scale data-v-bdb1fb28">{{''+(shop.delivery_fee-0?'配送 '+currency+shop.delivery_fee+' 起':'免配送')+''}}</text><block wx:if="{{shop.mouth_sale_count}}"><text class="line scale data-v-bdb1fb28">|</text></block><block wx:if="{{shop.mouth_sale_count}}"><text class="scale data-v-bdb1fb28">{{'月售'+(shop.mouth_sale_count&&shop.mouth_sale_count>9999?'9999+':shop.mouth_sale_count)+''}}</text></block></view></view>