<view class="address-input data-v-05693e76"><block wx:if="{{addressFrom=='send'&&type=='sendStart'}}"><view class="address-from send data-v-05693e76">发</view></block><block wx:if="{{addressFrom=='receive'&&type=='sendEnd'}}"><view class="address-from receive data-v-05693e76">送</view></block><block wx:if="{{addressFrom=='send'&&type=='buyStart'}}"><view class="address-from send buy data-v-05693e76"></view></block><block wx:if="{{addressFrom=='receive'&&type=='buyEnd'}}"><view class="address-from receive buy data-v-05693e76">收货</view></block><view class="{{['data-v-05693e76','detail-box '+type]}}"><view data-event-opts="{{[['tap',[['goAdd',['$event']]]]]}}" class="info-box data-v-05693e76" bindtap="__e"><block wx:if="{{!addressInfo}}"><view class="address-desc data-v-05693e76">{{addressDesc}}</view></block><block wx:else><view class="address-box data-v-05693e76"><view class="address ellipsis data-v-05693e76">{{addressInfo.adress+' '+addressInfo.detail}}</view><view class="user ellipsis data-v-05693e76">{{addressInfo.name+' '+addressInfo.phone}}</view><block wx:if="{{!addressInfo.name}}"><view style="color:red;font-size:11px;" class="data-v-05693e76"> 请完善发件信息 </view></block></view></block></view><view data-event-opts="{{[['tap',[['goSelect',['$event']]]]]}}" class="right-btn data-v-05693e76" style="{{'background:'+(mobile_head_color)+';'}}" bindtap="__e">常用</view><block wx:if="{{addressTag&&showTag}}"><view data-event-opts="{{[['tap',[['selectAddressTag',['$event']]]]]}}" class="address-tag data-v-05693e76" bindtap="__e"><view class="triangle data-v-05693e76"><text class="icon iconfont data-v-05693e76"></text></view><view class="address data-v-05693e76"><view class="desc ellipsis data-v-05693e76">{{addressTag.adress+addressTag.detail}}</view><view class="desc ellipsis data-v-05693e76">{{addressTag.name+' '+addressTag.phone}}</view></view><view data-event-opts="{{[['tap',[['closeAddressTag',['$event']]]]]}}" class="cancel-btn data-v-05693e76" catchtap="__e"><text class="icon-chahao iconfont data-v-05693e76"></text></view></view></block></view></view>