<view class="total-price data-v-76326f5a"><view class="{{['btn-box','data-v-76326f5a',(showPriceMask)?'active':'']}}"><view data-event-opts="{{[['tap',[['openMask',['$event']]]]]}}" class="left data-v-76326f5a" bindtap="__e"><text class="desc data-v-76326f5a">总价</text><text class="red data-v-76326f5a">{{currency}}</text><text class="red price data-v-76326f5a">{{priceInfo.total_price}}</text><text class="icon-jiantou iconfont data-v-76326f5a"></text><text hidden="{{!(priceInfo.old_price&&priceInfo.old_price>priceInfo.total_price)}}" class="red price old data-v-76326f5a">{{currency+priceInfo.old_price}}</text></view><view class="right data-v-76326f5a"><view data-event-opts="{{[['tap',[['saveOrder',['$event']]]]]}}" class="btn-tijiao data-v-76326f5a" style="{{'background:'+(mobile_head_color)+';'}}" bindtap="__e">提交订单</view></view></view><view data-event-opts="{{[['tap',[['openMask',['$event']]]]]}}" class="{{['global_mask','price-mask','data-v-76326f5a',(showPriceMask)?'active':'']}}" bindtap="__e"><view data-event-opts="{{[['tap',[['preventClick',['$event']]]]]}}" class="mask-content data-v-76326f5a" catchtap="__e"><view class="title-box data-v-76326f5a"><text class="title data-v-76326f5a">费用明细</text></view><view class="list data-v-76326f5a"><view class="line data-v-76326f5a"><text class="txt data-v-76326f5a">基础配送费</text><text class="data-v-76326f5a">{{currency+priceInfo.basic_distance_price}}</text></view><block wx:if="{{priceInfo.extra_distance_price&&priceInfo.extra_distance_price>0}}"><view class="line data-v-76326f5a"><text class="txt data-v-76326f5a">超出距离费用</text><text class="data-v-76326f5a">{{currency+priceInfo.extra_distance_price}}</text></view></block><block wx:if="{{priceInfo.basic_weight_price&&priceInfo.basic_weight_price>0}}"><view class="line data-v-76326f5a"><text class="txt data-v-76326f5a">基础重量费</text><text class="data-v-76326f5a">{{currency+priceInfo.basic_weight_price}}</text></view></block><block wx:if="{{priceInfo.extra_weight_price&&priceInfo.extra_weight_price>0}}"><view class="line data-v-76326f5a"><text class="txt data-v-76326f5a">超出重量费用</text><text class="data-v-76326f5a">{{currency+priceInfo.extra_weight_price}}</text></view></block><block wx:if="{{priceInfo.tip_price&&priceInfo.tip_price>0}}"><view class="line data-v-76326f5a"><text class="txt data-v-76326f5a">小费</text><text class="data-v-76326f5a">{{currency+priceInfo.tip_price}}</text></view></block><block wx:if="{{priceInfo.discount_money&&priceInfo.discount_money>0}}"><view class="line data-v-76326f5a"><text class="txt data-v-76326f5a">优惠时段立减</text><text class="data-v-76326f5a">{{"-"+currency+priceInfo.discount_money}}</text></view></block><block wx:if="{{priceInfo.coupon_money&&priceInfo.coupon_money>0}}"><view class="line data-v-76326f5a"><text class="txt data-v-76326f5a">优惠券折扣</text><text class="data-v-76326f5a">{{"-"+currency+priceInfo.coupon_money}}</text></view></block></view></view></view></view>