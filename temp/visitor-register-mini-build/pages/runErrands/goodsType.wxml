<view class="goods-type-wrapper _div"><block wx:if="{{confirmType==3}}"><view class="type-list _div"><block wx:for="{{typeList}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['selectType',[index]]]]]}}" class="item _div" style="{{(selectIndex===index?activeStyle:'')}}" bindtap="__e">{{item}}</view></block></view></block><view class="weight-box _div"><view class="_div">重量</view><view class="select-num _div" style="{{'color:'+(mobile_head_color)+';'}}"><block wx:if="{{rangeValue<minValue}}"><label class="_span">{{"小于"+minValue+"公斤"}}</label></block><block wx:else><label class="_span">{{rangeValue+"公斤"}}</label></block></view><view class="range-box _div"><slider class="range" activeColor="#04b7a5" value="{{rangeValue}}" min="{{minValue-1}}" max="{{maxValue}}" data-event-opts="{{[['change',[['sliderChange',['$event']]]]]}}" bindchange="__e"></slider><view class="tip-box _div"><label class="tip left _span">{{"小于"+minValue+"公斤"}}</label><label class="tip right _span">{{maxValue+"公斤"}}</label></view></view></view><view class="btn-box _div"><button data-event-opts="{{[['tap',[['confirm',['$event']]]]]}}" class="btn" style="{{'background:'+(mobile_head_color)+';'}}" bindtap="__e">确定</button></view></view>