.open-map{background:#fff;height:100%;overflow:hidden}.open-map .head{padding:0 10px;box-shadow:2px 0 5px #999;border-bottom:1PX solid #ddd;height:50px;font-size:14px;display:flex;align-items:center}.open-map .head .back{font-size:24px;padding:10px;color:#999}.open-map .head .search{flex-grow:1;padding:10px 0 10px 10px}.open-map .head .city{padding:10px 0}.open-map .head .city .icon{font-size:20px;vertical-align:middle;color:#bbb}.open-map .head .cancel{padding:10px;color:#aaa}.open-map .map-box{position:relative}.open-map .map-box .bm-view{height:250px}.open-map .map-box .location-icon{position:absolute;top:calc(50% - 15px);left:calc(50% - 15px);width:30px;height:30px;background-image:url(https://cloud.mrsqfw.com/static/wxapp/runErrands/location_my.png);background-size:100%}.open-map .map-box .location-icon ._img{width:30px}.open-map .list{height:calc(100% - 300px);background:#fff;overflow-y:auto}.open-map .list .item{margin-left:10px;padding:8px 0;border-bottom:1PX solid #efefef;line-height:1.8;display:flex}.open-map .list .item:last-child{border-bottom:none}.open-map .list .item .icon-box{width:16px}.open-map .list .item .icon,
.open-map .list .item vertical-align top,
.open-map .list .item .color-red{color:#fe2947}.open-map .list .item .detail-box{width:calc(100% - 46px);padding:0 10px}.open-map .list .item .detail-box .first{font-size:16px;display:flex;align-items:baseline}.open-map .list .item .detail-box .first .tip{margin-right:5px;white-space:nowrap}.open-map .list .item .detail-box .first .address{flex-grow:1}.open-map .list .item .detail-box .first .distance{white-space:nowrap;margin-left:5px;font-size:12px}.open-map .list .item .detail-box .first .second{font-size:12px}.open-map .full-list{height:calc(100% - 50px)}.open-map .city-list{background:#f2f2f2;font-size:14px}.open-map .search-list .item .detail-box{width:calc(100% - 36px)}.open-map .search-list .item .detail-box .address-item.active{color:#04b7a5}.open-map .search-list .item:first-child .detail-box .address-item.active{color:red}