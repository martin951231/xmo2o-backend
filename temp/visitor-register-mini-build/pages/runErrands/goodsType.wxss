.goods-type-wrapper{height:100%;background:#fff}.goods-type-wrapper .type-list{padding:30px 0 15px 15px;display:flex;flex-wrap:wrap;border-bottom:1PX solid #e5e5e5}.goods-type-wrapper .type-list .item{width:calc(25% - 15px);margin-right:15px;margin-bottom:15px;font-size:14px;border:1PX solid #e5e5e5;box-sizing:border-box;padding:9px 0;text-align:center}.goods-type-wrapper .type-list .item.active{border-color:#04b7a5;color:#04b7a5}.goods-type-wrapper .weight-box{padding:30px 15px 0;text-align:center;font-size:16px}.goods-type-wrapper .weight-box .select-num{color:#04b7a5;margin-top:20px}.goods-type-wrapper .weight-box .range-box{padding:0 25px;position:relative}.goods-type-wrapper .weight-box .range-box .range{padding:10px 15px}.goods-type-wrapper .weight-box .range-box .range .mt-range-progress{background:#04b7a5}.goods-type-wrapper .weight-box .range-box .tip-box{display:flex;justify-content:space-between;font-size:14px}.goods-type-wrapper .btn-box{padding:35px 15px 0}.goods-type-wrapper .btn-box .btn{width:100%;color:#fff;background:#04b7a5;font-size:17px;line-height:2.56;border-radius:2px}.goods-type-wrapper .btn-box .btn:active{background:#04a595}