<view class="lottory data-v-62aad59f"><block wx:if="{{showPlate}}"><view class="lottory_activity data-v-62aad59f"><view data-event-opts="{{[['tap',[['closePlate',['$event']]]]]}}" class="close data-v-62aad59f" bindtap="__e"><image src="https://cloud.mrsqfw.com/static/wxapp/lottory/lottory_close.png" mode="widthFix" class="data-v-62aad59f"></image></view><view data-event-opts="{{[['tap',[['startRollTap',['$event']]]]]}}" class="plate_btn data-v-62aad59f" bindtap="__e">立即<view class="_br data-v-62aad59f"></view>抽奖</view><view class="luck_draw data-v-62aad59f"><view class="draw_main data-v-62aad59f" animation="{{aniData}}"><view class="main_con data-v-62aad59f"></view><view class="gb_wheel_list data-v-62aad59f"><block wx:for="{{awards}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="gb_wheel_item data-v-62aad59f"><view class="gb_wheel_icontent data-v-62aad59f" style="{{'transform:'+('rotate('+index*turnNum+'turn)')+';'+('transform-origin:'+('50%  '+size.h/2+'rpx')+';')}}"><block wx:if="{{item.discount*1!=0}}"><view class="prize_name data-v-62aad59f" style="{{'color:'+(item.textColor)+';'}}">{{item.discount+"元"}}<view class="_br data-v-62aad59f"></view>优惠券</view></block><block wx:else><view class="prize_name data-v-62aad59f" style="{{'color:'+(item.textColor)+';'}}">谢谢惠顾</view></block></view></view></block></view></view></view><view class="lottory_tip data-v-62aad59f">{{'点击转盘开始抽奖，剩余'+lotteryObj.surplus+'次机会'}}</view><view data-event-opts="{{[['tap',[['lookRecords',['$event']]]]]}}" class="draw_records data-v-62aad59f" bindtap="__e"> 抽奖记录 </view><view data-event-opts="{{[['tap',[['lookRules',['$event']]]]]}}" class="draw_rules data-v-62aad59f" bindtap="__e"> 规则 </view></view></block><block wx:if="{{showRules}}"><view class="rules_panel data-v-62aad59f"><view class="rules_con data-v-62aad59f"><view class="rules_rich data-v-62aad59f"><view class="data-v-62aad59f"><rich-text nodes="{{lotteryObj.note}}"></rich-text></view></view></view><view data-event-opts="{{[['tap',[['closeRules',['$event']]]]]}}" class="rules_close data-v-62aad59f" bindtap="__e"></view></view></block><block wx:if="{{showRecords}}"><view class="records_panel data-v-62aad59f"><view class="records_con data-v-62aad59f"><view class="records_list data-v-62aad59f"><block wx:for="{{records}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view class="records_item data-v-62aad59f"><view class="time data-v-62aad59f">{{''+item.record_time+''}}</view><view class="desc data-v-62aad59f">{{''+item.title+''}}</view></view></block></view></view><view data-event-opts="{{[['tap',[['closeRecords',['$event']]]]]}}" class="records_close data-v-62aad59f" bindtap="__e"></view></view></block><block wx:if="{{showCongratulate}}"><view class="congratulate data-v-62aad59f"><view class="congratulate_con data-v-62aad59f"><view class="text data-v-62aad59f">{{drawRecords.title}}</view><block wx:if="{{drawRecords.left_nums*1!=0}}"><view data-event-opts="{{[['tap',[['closeCongratulate',['$event']]]]]}}" class="button data-v-62aad59f" bindtap="__e">再抽一次</view></block></view><view data-event-opts="{{[['tap',[['closeCongratulate',['$event']]]]]}}" class="congratulate_close data-v-62aad59f" bindtap="__e"></view></view></block><block wx:if="{{isShowTip}}"><view class="tip data-v-62aad59f"><view class="text data-v-62aad59f">{{tipMsg}}</view></view></block></view>