<view class="container"><view class="shopDetail"><view class="imgInfo cf"><view class="fl"><image src="{{store_data.now_store.all_pic[0]}}"></image></view><view class="fl ml20"><view class="brand">{{store_data.now_store.name}}</view><view class="rateInfo"><view class="star fl"><block wx:if="{{store_data.store_score>0}}"><block><block wx:for="{{[0,1,2,3,4]}}" wx:for-item="i" wx:for-index="store_list_star_index" wx:key="store_list_star_index"><block><block wx:if="{{store_data.store_score>=i+1}}"><image src="https://cloud.mrsqfw.com/static/wxapp/images/full_star.png"></image></block><block wx:else><block wx:if="{{store_data.store_score>i}}"><image src="https://cloud.mrsqfw.com/static/wxapp/images/mid_star.png"></image></block><block wx:else><image src="https://cloud.mrsqfw.com/static/wxapp/images/none_star.png"></image></block></block></block></block></block></block><block wx:else><block><image src="https://cloud.mrsqfw.com/static/wxapp/images/full_star.png"></image><image src="https://cloud.mrsqfw.com/static/wxapp/images/full_star.png"></image><image src="https://cloud.mrsqfw.com/static/wxapp/images/full_star.png"></image><image src="https://cloud.mrsqfw.com/static/wxapp/images/mid_star.png"></image><image src="https://cloud.mrsqfw.com/static/wxapp/images/none_star.png"></image></block></block></view></view></view></view><view class="linkInfo" data-lat="{{store_data.now_store.lat}}" data-lng="{{store_data.now_store.long}}" data-type="baidu" data-name="{{store_data.now_store.name}}" data-address="{{store_data.now_store.adress}}" data-event-opts="{{[['tap',[['openMap',['$event']]]]]}}" bindtap="__e"><view class="text">{{store_data.now_store.adress}}</view><view class="phoneBox" data-phone="{{store_data.now_store.phone}}" data-event-opts="{{[['tap',[['callPhone',['$event']]]]]}}" catchtap="__e"><view class="phone"></view></view></view><block wx:if="{{store_data.now_store.have_shop==1}}"><view data-event-opts="{{[['tap',[['goShop',['$event']]]]]}}" class="linkInfo link" bindtap="__e"><view class="icon shop">快</view><view class="text">快店</view></view></block><block wx:if="{{store_data.now_store.pay_in_store==1}}"><view data-event-opts="{{[['tap',[['goPrepay',['$event']]]]]}}" class="linkInfo link" bindtap="__e"><view class="icon store">付</view><view class="text">快速买单</view></view></block></view><block wx:if="{{$root.g0>0}}"><view class="group_list bw"><view class="titleDiv"><view class="title">{{store_data.store_group_list_name}}</view></view><block wx:for="{{store_data.store_group_list}}" wx:for-item="item" wx:for-index="group_list" wx:key="group_list"><block><view class="menulink" data-group_id="{{item.group_id}}" data-event-opts="{{[['tap',[['goGroup',['$event']]]]]}}" bindtap="__e"><view class="fl ml_left"><image src="{{item.list_pic}}"></image><view class="{{['pos '+(item.pin_num==0?'group':'fight')]}}"></view></view><view class="ml_menu"><view class="tit">{{item.group_name}}</view><view class="cf bot"><view class="fl cf"><view class="fl val"><text class="mall">￥</text><text class="price">{{item.price}}</text></view><view class="fl rackrate">{{item.old_price}}</view></view><view class="fr sold">{{"已售 "+item.sale_count}}</view></view></view></view></block></block></view></block></view>