<view><view class="container"><form data-event-opts="{{[['submit',[['prepaySubmit',['$event']]]]]}}" bindsubmit="__e"><block wx:if="{{mer_data.store_list&&store_data.name}}"><view data-event-opts="{{[['tap',[['showChooseStore',['$event']]]]]}}" class="pay_top" bindtap="__e"><text class="i">付款给</text><text class="span">{{store_data.name}}</text><text class="em">更换</text></view></block><view class="inputBox bw"><view class="item"><view class="title">消费总额:</view><input type="digit" placeholder="询问服务员后输入" name="total_money" focus="{{total_focus}}" data-event-opts="{{[['input',[['inputTotalMoney',['$event']]]]]}}" bindinput="__e"/></view><block wx:if="{{store_data.discount_type!=0}}"><block><view class="tip">输入不参与优惠金额(酒水、特价菜等)</view><view class="item"><view class="title">不可优惠金额:</view><input type="digit" placeholder="询问服务员后输入" name="no_discount_money" data-event-opts="{{[['input',[['inputNoMoney',['$event']]]]]}}" bindinput="__e"/></view></block></block></view><block wx:if="{{store_data.discount_type&&store_data.discount_type!=0}}"><view class="bw discount clearfix"><block wx:if="{{store_data.discount_type==1}}"><view class="fl"><text class="i zhe">折</text>{{store_data.discount_percent+"折"}}</view></block><block wx:else><block wx:if="{{store_data.discount_type==2}}"><view class="fl"><text class="i jian">减</text>{{"每满"+(currency+store_data.condition_price)+"减"+(currency+store_data.minus_price)}}</view></block></block><view class="{{['fr cg '+(discount_money>0?'show':'hide')]}}">{{"-"+discount_money}}</view></view></block><button class="block_btn mlr20" formType="submit">确认支付</button></form><block wx:if="{{showChooseStore&&mer_data.store_list}}"><view class="choice"><view class="h2">请选择所在的门店</view><scroll-view class="iscroll" scroll-y="{{true}}"><view class="ul"><block wx:for="{{mer_data.store_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block><view class="li" data-id="{{index}}" data-event-opts="{{[['tap',[['chooseStore',['$event']]]]]}}" bindtap="__e"><view class="lh2">{{item.name}}</view><view class="p">{{item.adress}}</view><block wx:if="{{item.range}}"><view class="distance">{{"距离您的位置 "+item.range}}</view></block></view></block></block></view></scroll-view><block wx:if="{{store_data.name}}"><view data-event-opts="{{[['tap',[['closeChooseStore',['$event']]]]]}}" class="close" bindtap="__e">关闭</view></block></view></block><block wx:if="{{showChooseStore&&mer_data.store_list}}"><view data-event-opts="{{[['tap',[['closeChooseStore',['$event']]]]]}}" class="mask" bindtap="__e"></view></block></view><block wx:if="{{showAuthBtn}}"><view class="auth_btn_bg"><view class="auth_btn_div"><view class="auth_btn_title">微信授权</view><view class="auth_btn_content"><view class="h2">为了更快的给您提供免注册服务，我们需要授权获得以下信息。</view><view class="p">您微信的公开信息（昵称、头像等）</view></view><view class="auth_btn_btn_div"><button open-type="getUserInfo" data-event-opts="{{[['getuserinfo',[['authGetUserInfo',['$event']]]]]}}" bindgetuserinfo="__e">获取基础信息</button></view></view></view></block></view>