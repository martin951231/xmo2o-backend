<view class="container"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{listdata&&listdata[0]}}"><view class="card"><view class="card-top"><view class="top-title">{{"物料名称："+item.type_name}}</view><block wx:if="{{item.confirm_status==0}}"><view class="top-tips">待确认</view></block><block wx:if="{{item.confirm_status==1}}"><view class="top-tips-old">已确认</view></block></view><view class="card-bottom"><view class="bottom-text"><view class="text">{{"领用人："+item.receive_name}}</view></view><view class="text">{{"领用时间："+item.receive_time}}</view><view class="text">{{"手机号："+item.receive_phone}}</view><view class="text">{{"领用数量："+item.receive_num}}</view><view class="text">{{"备 注："+item.remark}}</view></view><block wx:if="{{item.confirm_status==0}}"><view class="btn-box"><button class="btn-left" style="{{('background-color:'+actcolor+';-webkit-box-shadow:0rpx 4rpx 16rpx #b1b1b1;box-shadow:0rpx 4rpx 16rpx #b1b1b1;')}}" type="primary" data-event-opts="{{[['tap',[['confirmPickup',['$0'],[[['listdata','',index,'id']]]]]]]}}" bindtap="__e">确认</button></view></block></view></block></block></view>