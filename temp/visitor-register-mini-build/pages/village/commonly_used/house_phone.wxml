<view class="info_box" style="{{(box_style)}}"><userinfo vue-id="0e1b2f24-1" id="user" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo><block wx:if="{{listData.phone_list&&listData.phone_list[0]}}"><view class="container"><block wx:for="{{listData.phone_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view><view class="list_title">{{item.cat_name}}</view><view class="phone_list"><block wx:for="{{item.phone_list}}" wx:for-item="items" wx:for-index="indexs" wx:key="indexs"><view data-event-opts="{{[['tap',[['tel_phone',['$0'],[[['listData.phone_list','',index],['phone_list','',indexs]]]]]]]}}" class="list-item" bindtap="__e"><view class="list_box">{{items.name}}</view><view class="tel_phone">{{items.phone}}</view><view class="right-icon"><image class="right-img" src="https://cloud.mrsqfw.com/static/wxapp/images/right.png"></image></view></view></block></view><view style="height:16rpx;background-color:#f4f4f4;"></view></view></block></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" style="width:85%;height:auto;" src="https://cloud.mrsqfw.com/static/images/house/no_data.png" mode="widthFix"></image><view class="no_tip_content"><lang vue-id="0e1b2f24-2" keywords="暂无其他常用电话~" bind:__l="__l"></lang></view></view></block><block wx:if="{{listData.now_village&&listData.now_village.property_phone&&listData.now_village.property_phone[0]}}"><view class="tel_btn" style="{{(no_other_info)}}"><button class="tel_property" style="{{(btn_style)}}" type="primary" data-event-opts="{{[['tap',[['tel_property_phone',['$0'],['listData.now_village.property_phone']]]]]}}" bindtap="__e">联系物业</button></view></block><view><uni-popup class="popup_box_msg vue-ref" style="width:100%;" vue-id="0e1b2f24-3" type="center" maskClick="{{false}}" data-ref="popup" bind:__l="__l" vue-slots="{{['default']}}"><view class="popup-box" style="{{(popup_box_style)}}"><view class="popup-title" style="{{(popup_box_content)}}"> 联系物业 </view><scroll-view class="popup-list" scroll-y="true" scroll-top="0" show-scrollbar="false"><block wx:if="{{kf_url}}"><view data-event-opts="{{[['tap',[['kf_parse_url',['$0'],['kf_url']]]]]}}" class="popup_conten" style="{{(popup_box_content)}}" bindtap="__e"><view class="tel_tip"><image class="tel_img" src="{{kf_img}}"></image><view class="tel_msg">在线客服</view></view></view></block><block wx:if="{{!phone_list||!phone_list[0]}}"><view data-event-opts="{{[['tap',[['tel',['$0'],['phone']]]]]}}" class="popup_conten" style="{{(popup_box_content)}}" bindtap="__e"><view class="tel_tip"><image class="tel_img" src="https://cloud.mrsqfw.com/static/wxapp/images/tel_phone.png?t=01"></image><view class="tel_msg">{{phone_name}}</view></view></view></block><block wx:for="{{phone_list}}" wx:for-item="val" wx:for-index="key"><block wx:if="{{phone_list&&phone_list[0]}}"><view data-event-opts="{{[['tap',[['tel',['$0'],[[['phone_list','',key]]]]]]]}}" class="popup_conten" style="{{(popup_box_content)}}" bindtap="__e"><view class="tel_tip"><image class="tel_img" src="https://cloud.mrsqfw.com/static/wxapp/images/tel_phone.png?t=01"></image><view class="tel_msg">{{val}}</view></view></view></block></block></scroll-view></view><view class="close_box" style="{{(popup_box_style)}}"><view data-event-opts="{{[['tap',[['closePopup',['$event']]]]]}}" class="close_click_box" bindtap="__e"><image class="close_img" src="https://cloud.mrsqfw.com/static/wxapp/images/close.png"></image></view></view></uni-popup></view></view>