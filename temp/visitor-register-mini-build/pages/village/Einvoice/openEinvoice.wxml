<view class="container"><view class="list-box"><view class="list-item"><view class="title">抬头类型</view><block wx:for="{{select_box}}" wx:for-item="item" wx:for-index="index"><view class="select-box"><view data-event-opts="{{[['tap',[['selectTag',[index,'$0'],[[['select_box','',index,'head_up_type']]]]]]]}}" class="{{['select_icon '+(static==index?'select_iconed':'')]}}" catchtap="__e"></view><view class="text">{{item.name}}</view></view></block></view><view class="list-item"><view class="xinghao">✳</view><block wx:if="{{head_up_type==2}}"><view class="title">公司名称</view></block><block wx:else><view class="title">个人名称</view></block><input class="input-box" placeholder-class="pla-text" type="text" value="{{name}}" placeholder="请填写发票抬头" data-event-opts="{{[['input',[['__set_model',['','name','$event',[]]]]]]}}" bindinput="__e"/></view><view class="list-item"><view class="xinghao">✳</view><block wx:if="{{head_up_type==2}}"><view class="title">公司税号</view></block><block wx:else><view class="title">税号</view></block><input class="input-box" placeholder-class="pla-text" type="text" value="{{taxnum}}" placeholder="请填写纳税人识别号" data-event-opts="{{[['input',[['__set_model',['','taxnum','$event',[]]]]]]}}" bindinput="__e"/></view></view><block wx:if="{{head_up_type==2}}"><view class="list-box"><view class="list-item"><view class="title">公司地址</view><input class="input-box" placeholder-class="pla-text" type="text" value="{{address}}" placeholder="请填写公司地址" data-event-opts="{{[['input',[['__set_model',['','address','$event',[]]]]]]}}" bindinput="__e"/></view><view class="list-item"><view class="title">公司电话</view><input class="input-box" placeholder-class="pla-text" type="number" value="{{phone}}" placeholder="请填写公司电话" data-event-opts="{{[['input',[['__set_model',['','phone','$event',[]]]]]]}}" bindinput="__e"/></view><view class="list-item"><view class="title">公司开户行</view><input class="input-box" placeholder-class="pla-text" type="text" value="{{bank_of_deposit}}" placeholder="请填写公司开户行" data-event-opts="{{[['input',[['__set_model',['','bank_of_deposit','$event',[]]]]]]}}" bindinput="__e"/></view><view class="list-item"><view class="title">开户行账号</view><input class="input-box" placeholder-class="pla-text" type="text" value="{{account_number}}" placeholder="请填写开户行账号" data-event-opts="{{[['input',[['__set_model',['','account_number','$event',[]]]]]]}}" bindinput="__e"/></view><view class="list-item"><view class="title">备注</view><input class="input-box" placeholder-class="pla-text" type="text" value="{{remark}}" placeholder="请填写备注" data-event-opts="{{[['input',[['__set_model',['','remark','$event',[]]]]]]}}" bindinput="__e"/></view></view></block><view class="list-box"><view class="list-item"><view class="title">总金额</view><view class="right-text">{{moneyall+"元"}}</view></view><view class="list-item"><view class="title">短信接收</view><input class="input-box" placeholder-class="pla-text" type="text" value="{{receive_tel}}" placeholder="请填写手机号" data-event-opts="{{[['input',[['__set_model',['','receive_tel','$event',[]]]]]]}}" bindinput="__e"/></view></view><view data-event-opts="{{[['tap',[['goEinvoiceHistory',['$event']]]]]}}" class="btn" style="{{(btn_style)}}" catchtap="__e">提交</view><uni-popups class="vue-ref" vue-id="33a7e179-1" type="center" maskClick="{{false}}" data-ref="popups" bind:__l="__l" vue-slots="{{['default']}}"><view class="box-success"><view class="top-box"><view class="time">{{seconds+"s"}}</view><image class="close-icon" src="https://cloud.mrsqfw.com/static/wxapp/images/guanbi.png" mode data-event-opts="{{[['tap',[['close',['$event']]]]]}}" bindtap="__e"></image></view><image class="success-img" src="https://cloud.mrsqfw.com/static/wxapp/images/successful.png" mode></image><view class="sunccess-text">提交成功,请注意短信查收</view></view></uni-popups></view>