<view class="container"><view class="details"><view data-event-opts="{{[['tap',[['opensee',['$event']]]]]}}" class="list-box" bindtap="__e"><view class="title">电子发票</view><view class="right-box"><view class="text">查看发票</view><image class="right-icon" src="https://cloud.mrsqfw.com/static/wxapp/images/right.png" mode></image></view></view><view class="list-item"><block wx:if="{{listdata.head_up_type==2}}"><view class="title-text">公司名称</view></block><block wx:else><view class="title-text">个人名称</view></block><block wx:if="{{listdata.name}}"><view class="right-text">{{listdata.name}}</view></block><block wx:else><view class="right-text">空</view></block></view><view class="list-item"><block wx:if="{{listdata.head_up_type==2}}"><view class="title-text">公司税号</view></block><block wx:else><view class="title-text">税号</view></block><block wx:if="{{listdata.taxnum}}"><view class="right-text">{{listdata.taxnum}}</view></block><block wx:else><view class="right-text">空</view></block></view><block wx:if="{{listdata.head_up_type==2}}"><view><view class="list-item"><view class="title-text">公司地址</view><block wx:if="{{listdata.address}}"><view class="right-text">{{listdata.address}}</view></block><block wx:else><view class="right-text">空</view></block></view><view class="list-item"><view class="title-text">公司电话</view><block wx:if="{{listdata.phone}}"><view class="right-text">{{listdata.phone}}</view></block><block wx:else><view class="right-text">空</view></block></view><view class="list-item"><view class="title-text">公司开户行</view><block wx:if="{{listdata.bank_of_deposit}}"><view class="right-text">{{listdata.bank_of_deposit}}</view></block><block wx:else><view class="right-text">空</view></block></view><view class="list-item"><view class="title-text">开户行账号</view><block wx:if="{{listdata.account_number}}"><view class="right-text">{{listdata.account_number}}</view></block><block wx:else><view class="right-text">空</view></block></view><view class="list-item"><view class="title-text">备注</view><block wx:if="{{listdata.remark}}"><view class="right-text">{{listdata.remark}}</view></block><block wx:else><view class="right-text">空</view></block></view></view></block><view class="list-item"><view class="title-text">发票内容</view><block wx:if="{{listdata.property_type}}"><view class="right-text">{{listdata.property_type}}</view></block><block wx:else><view class="right-text">空</view></block></view><view class="list-item"><view class="title-text">发票金额</view><block wx:if="{{listdata.money}}"><view class="right-text">{{listdata.money}}</view></block><block wx:else><view class="right-text">空</view></block></view><view class="list-item"><view class="title-text">申请时间</view><block wx:if="{{listdata.create_time}}"><view class="right-text">{{listdata.create_time}}</view></block><block wx:else><view class="right-text">空</view></block></view></view><view class="details"><view class="list-item"><view class="title-text">短信接收</view><block wx:if="{{listdata.name}}"><view class="right-text">{{listdata.receive_tel}}</view></block><block wx:else><view class="right-text">空</view></block></view></view><block wx:if="{{isshow}}"><view data-event-opts="{{[['tap',[['close',['$event']]]]]}}" class="show-box" bindtap="__e"><image src="{{Einvoice}}" mode></image></view></block></view>