<view class="container"><scroll-view class="gopay_view" scroll-top="{{scrollTop}}" scroll-y="true"><block wx:for="{{check_list}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view class="tip_box_data"><block wx:if="{{item.is_show==1}}"><view data-event-opts="{{[['tap',[['selectTag',['$0',index],[[['check_list','',index]]]]]]]}}" class="{{['select_icon '+(item.static==true?'select_iconed':'')]}}" bindtap="__e"></view></block><block wx:else><view class="no_select"></view></block><view class="bigbox"><view class="contentbox"><view class="flex-box"><view class="text">{{item.order_name}}</view></view><view class="num">￥<text class="nummoney">{{item.money}}</text></view></view><view class="textnum"><view class="title">{{item.time}}</view></view></view></view></block></block><block wx:if="{{no_data}}"><view class="tip_box_no_data _div"><image class="no_data_img" src="https://cloud.mrsqfw.com/static/images/house/no_data.png"></image><view class="no_tip_content _div"><lang vue-id="ac44f4f6-1" keywords="暂无账单~" bind:__l="__l"></lang></view></view></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="ac44f4f6-2" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="ac44f4f6-3" keywords="没有更多记录" bind:__l="__l"></lang></view></block></scroll-view><view class="pay-bottom"><block wx:if="{{true}}"><view data-event-opts="{{[['tap',[['allcheck',['$event']]]]]}}" class="check-box1" style="margin-left:30rpx;" bindtap="__e"><view class="{{['select_icon '+(allchecked==true?'select_iconed':'')]}}"></view></view></block><block wx:if="{{false}}"><view class="check-box1" style="margin-left:30rpx;"><view class="no_select"></view></view></block><view class="paybox"><view class="payminbox"><view class="allpay">全选</view><view class="allpaynum">{{"合计：￥"+moneyall}}</view></view><block wx:if="{{true}}"><view data-event-opts="{{[['tap',[['goallpay',['$event']]]]]}}" class="gopay" style="{{('background:'+actcolor)}}" bindtap="__e"><text class="pay-text">去开票</text></view></block><block wx:if="{{false}}"><view class="gopay" style="background-color:rgb(235, 237, 240);color:#999999;"><text class="pay-text">收款</text></view></block></view></view><view data-event-opts="{{[['tap',[['goEinvoiceHistory',['$event']]]]]}}" class="independent_payment" bindtap="__e"><image class="independent-img" src="../static/images/Einvoice-icon1.png"></image></view></view>