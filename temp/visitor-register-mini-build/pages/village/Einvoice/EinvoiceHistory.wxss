page{background:#fff}.container{margin:0;padding:0;background:#fff}.white{background:#f5f5f5;padding-top:25rpx}.list-item{margin:30rpx;box-shadow:0 4px 13px 0 rgba(108,165,255,.14);border:solid 2rpx #ebedf1;border-radius:20rpx;overflow:hidden}.top-box{background-color:#f8fafc;padding:0rpx 25rpx}.bottom-box{background-color:#fff;font-size:26rpx;font-weight:400;font-stretch:normal;line-height:90rpx;letter-spacing:0rpx;color:#999;padding:0rpx 25rpx}.box1{display:flex;flex-direction:row;justify-content:space-between;align-items:center}.box2{display:flex;flex-direction:row;justify-content:space-between;align-items:center}.right-box{display:flex;flex-direction:row;align-items:center}.time-icon{display:block;width:30rpx;height:30rpx;flex-shrink:0}.time-text{font-size:25rpx;line-height:90rpx;letter-spacing:0rpx;color:#aeaeae;margin-left:20rpx}.right-icon{display:block;width:30rpx;height:30rpx;flex-shrink:0}.title{font-size:28rpx;line-height:90rpx;letter-spacing:0rpx;color:#7b7b7b}.tips{border-radius:5rpx;border:solid 2rpx #c9c9c9;padding:0rpx 10rpx;margin-left:25rpx;font-size:22rpx;letter-spacing:0rpx;color:#c9c9c9}.right-money{font-size:34rpx;font-weight:400;font-stretch:normal;line-height:60rpx;letter-spacing:0rpx;color:#333}.tip_box_no_data{padding-top:calc((100vh - 170rpx - 288rpx -150rpx)/2);font-size:28rpx;text-align:center}.tip_box_no_data .tip_title{width:100%;text-align:center}