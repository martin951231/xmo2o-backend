page{background:#f5f5f5}.container{margin:0;padding:0}.QS-tabs-box{width:100%;position:-webkit-sticky;position:sticky;top:0;z-index:998!important;background-color:#fff}.scroll-items{margin-top:15rpx;background-color:#fff;display:flex;flex-direction:row;justify-content:space-between;align-items:center;padding:10rpx 20rpx}.left-box{display:flex;flex-direction:column}.right-box{flex-shrink:0;width:260rpx;height:200rpx;display:block}.time-box{display:flex;flex-direction:row;align-items:center;margin-top:15rpx}.title{font-size:28rpx;font-weight:700;line-height:60rpx}.content{margin-top:15rpx;font-size:28rpx;line-height:50rpx}.time-text{color:#b7b7b7}.time-img{width:32rpx;height:32rpx;display:block;margin-right:8rpx}.swiper-height{height:calc(100vh - 80rpx)}.tip_box_no_data{padding-top:calc((100vh - 170rpx - 288rpx - 400rpx)/2);font-size:28rpx;text-align:center}.tip_box_no_data .tip_title{width:100%;text-align:center}.tip{display:flex;justify-content:center;align-items:center;font-size:14px;color:#666;padding:10px 0;background:#f8f8f8}.tip image{width:20px;height:20px;margin-right:5px}