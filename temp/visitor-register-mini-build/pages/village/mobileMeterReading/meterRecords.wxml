<view class="container"><view class="top-box" style="{{('background-color:'+actcolor)}}"><view class="postion-box"><sl-filter vue-id="b119b422-1" independence="{{true}}" color="{{titleColor}}" reflexTitle="{{true}}" themeColor="{{themeColor}}" menuList="{{menuList}}" data-event-opts="{{[['^updateMenuList',[['__set_sync',['$0','menuList','$event'],['']]]],['^updateMenuList',[['__set_sync',['$0','menuList','$event'],['']]]],['^result',[['result']]]]}}" bind:updateMenuList="__e" bind:result="__e" bind:__l="__l"></sl-filter><view data-event-opts="{{[['tap',[['selecttime',['$event']]]]]}}" bindtap="__e"><uni-collapse vue-id="b119b422-2" accordion="{{true}}" bind:__l="__l" vue-slots="{{['default']}}"><uni-collapse-item vue-id="{{('b119b422-3')+','+('b119b422-2')}}" title="时间(全部)" animation="{{true}}" bind:__l="__l"></uni-collapse-item></uni-collapse></view></view><view class="seach-box"><block wx:if="{{record_log_count}}"><view class="text-num">{{"共"+record_log_count+"条"}}</view></block><view data-event-opts="{{[['tap',[['search_btn',['$event']]]]]}}" class="search" bindtap="__e"><image class="search-img" src="https://cloud.mrsqfw.com/static/wxapp/images/search1.png" mode></image></view></view></view><block wx:for="{{numlist}}" wx:for-item="item" wx:for-index="index"><block wx:if="{{!no_data}}"><view class="big-box"><view class="card"><view class="left-card"><view class="text1">{{"记录类别："+item.cate_name}}</view><view class="text1">{{"项目名称："+item.project_name}}</view><view class="text1">{{"记录时间："+item.add_time}}</view><view class="text1">{{"记录人："+item.worker_name}}</view></view><view data-event-opts="{{[['tap',[['onClick',[index]]]]]}}" class="right-card" bindtap="__e"><image class="{{['right-top',(isOpen[index])?'right-top-hide':'']}}" src="https://cloud.mrsqfw.com/static/wxapp/images/xiangshang.png" mode></image></view></view><block wx:if="{{isOpen[index]}}"><view class="card-child"><view class="text">{{"业主姓名："+item.user_name}}</view><view class="text">{{"业主联系方式："+item.user_phone}}</view><view class="text">{{"业主\n\t\t\t"+(config.config&&config.config.room_name?config.config.room_name:'房间')+"\n\t\t\t："+item.user_address}}</view><view class="text">{{"单价："+item.unit_price}}</view><view class="text">{{"倍率："+item.rate}}</view><view class="text">{{"公摊："+item.pool}}</view><view class="text">{{"起度："+item.start_num}}</view><view class="text">{{"止度："+item.end_num}}</view></view></block></view></block></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="b119b422-4" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="b119b422-5" keywords="没有更多记录" bind:__l="__l"></lang></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="https://cloud.mrsqfw.com/static/images/house/no_data.png"></image><view class="no_tip_content">没搜到相关记录</view></view></block><view><w-picker class="vue-ref" vue-id="b119b422-6" mode="date" startYear="2017" endYear="2099" defaultVal="{{['2019','12','28']}}" current="{{false}}" disabledAfter="{{false}}" themeColor="#f00" data-ref="date" data-event-opts="{{[['^confirm',[['onConfirm']]]]}}" bind:confirm="__e" bind:__l="__l"></w-picker></view></view>