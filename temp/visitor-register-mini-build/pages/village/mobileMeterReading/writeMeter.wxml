<view class="container"><view class="background-color" style="{{('background:'+mobile_head_color)}}"><view class="topbox"><view class="name">{{listdata.room_address}}</view><view class="info-box"><view class="name">{{listdata.user_name}}</view><view class="tips">业主</view></view><view class="phone">{{listdata.user_phone}}</view><block wx:if="{{listdata.village_address}}"><view class="address-box"><view class="address-icon"><image class="address-img" src="https://cloud.mrsqfw.com/static/wxapp/images/address.png"></image></view><view class="address-text">{{listdata.village_address}}</view></view></block></view></view><view class="box"><view class="title">单价： <text style="color:#3c3c3c;">{{(dataList.unit_price?dataList.unit_price:'0')+"(元/立方米)"}}</text></view><view class="title">倍率：<text style="color:#3c3c3c;">{{dataList.rate}}</text></view><view class="title">公摊：<text style="color:#3c3c3c;">{{(dataList.pool?dataList.pool:'0')+"(元)"}}</text></view><view class="title">起度：</view><input class="ipt-box" type="text" value="{{start_num}}" placeholder-style="text-align:center;font-size:24rpx" placeholder="{{placeholder_text}}" data-event-opts="{{[['input',[['__set_model',['','start_num','$event',[]]]]]]}}" bindinput="__e"/><view class="title">止度：</view><input class="ipt-box" type="text" value="{{end_num}}" placeholder-style="text-align:center;font-size:24rpx" placeholder="请输入止度" data-event-opts="{{[['input',[['__set_model',['','end_num','$event',[]]]]]]}}" bindinput="__e"/><button class="btn" style="{{(btn_style)}}" type="primary" data-event-opts="{{[['tap',[['gopass',['$event']]]]]}}" bindtap="__e">提交</button></view></view>