page{background:#f5f5f5}.container{margin:0;padding:0}.topbox{padding:40rpx;display:flex;flex-direction:column;background:url(https://cloud.mrsqfw.com/static/wxapp/images/visitor-bg1.png);background-position-x:500rpx;background-position-y:70rpx;background-repeat:no-repeat;background-size:30%}.info-box{display:flex;flex-direction:row;justify-content:flex-start;align-items:center}.name{font-size:32rpx;font-weight:400;font-stretch:normal;line-height:60rpx;letter-spacing:0rpx;color:#fff}.tips{background-color:#ffa112;border-radius:4rpx;font-size:22rpx;font-weight:400;font-stretch:normal;text-align:center;letter-spacing:0;color:#fff;padding:2rpx 10rpx;margin-left:15rpx}.phone{font-size:28rpx;font-weight:400;font-stretch:normal;line-height:60rpx;letter-spacing:0;color:#fff}.address-box{display:flex;flex-direction:row;justify-content:flex-start;align-items:center;margin-top:20rpx}.address-icon{width:25rpx;height:30rpx;margin-right:8rpx}.address-img{width:100%;height:100%;display:block}.address-text{font-size:26rpx;font-weight:400;font-stretch:normal;line-height:60rpx;letter-spacing:0;color:#fff}.card{display:flex;flex-direction:row;justify-content:space-between;align-items:center;background:#fff;padding:0rpx 30rpx;border-bottom:1rpx solid #f1f1f1}.card:last-of-type{border-bottom:0rpx solid #f1f1f1}.left{font-size:32rpx;color:#666;line-height:100rpx}.right{font-size:32rpx;color:#000;line-height:100rpx}.btn{font-size:32rpx;font-weight:400;font-stretch:normal;line-height:90rpx;letter-spacing:0;text-align:center;color:#fff;background-color:#2681f3;border-radius:44rpx;margin:0rpx 100rpx;margin-top:100rpx;border:0rpx}