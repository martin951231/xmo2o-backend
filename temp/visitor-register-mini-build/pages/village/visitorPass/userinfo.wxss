page{background:#f5f5f5}.container{margin:0;padding:0;margin-top:15rpx}.card{display:flex;flex-direction:row;justify-content:space-between;align-items:center;background:#fff;padding:0rpx 30rpx;border-bottom:1rpx solid #f1f1f1}.card:last-of-type{border-bottom:0rpx solid #f1f1f1}.left{font-size:32rpx;color:#666;line-height:100rpx}.right{font-size:32rpx;color:#000;line-height:100rpx}.btn{font-size:32rpx;font-weight:400;font-stretch:normal;line-height:90rpx;letter-spacing:0;text-align:center;color:#fff;background-color:#2681f3;border-radius:44rpx;margin:0rpx 100rpx;margin-top:100rpx;border:0rpx}