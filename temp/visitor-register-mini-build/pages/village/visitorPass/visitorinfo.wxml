<view class="container"><userinfo vue-id="d2f0d4b4-1" id="user" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo><block wx:if="{{choose_options.need_choose_house}}"><village-choose-house vue-id="d2f0d4b4-2" options="{{choose_options}}" data-event-opts="{{[['^goVillagehouse',[['goVillagehouse']]],['^chooseHouseId',[['chooseHouseId']]]]}}" bind:goVillagehouse="__e" bind:chooseHouseId="__e" bind:__l="__l"></village-choose-house></block><view class="background-color" style="{{('background:'+mobile_head_color)}}"><view class="topbox"><view style="display:flex;flex-direction:row;align-items:center;justify-content:space-between;"><view class="info-box"><view class="name">{{listdata.owner_name}}</view><view class="tips">业主</view></view></view><view class="phone">{{listdata.owner_phone}}</view><view class="address-box"><view class="address-icon"><image class="address-img" src="https://cloud.mrsqfw.com/static/wxapp/images/address.png"></image></view><block wx:if="{{listdata.owner_address}}"><view class="address-text">{{listdata.owner_address}}</view></block></view></view></view><view class="card"><view class="left">访客姓名</view><view class="right">{{listdata.visitor_name}}</view></view><view class="card"><view class="left">访客联系方式</view><view class="right">{{listdata.visitor_phone}}</view></view><view class="card"><view class="left">到访时间</view><view class="right">{{listdata.add_time}}</view></view><block wx:if="{{is_ewm_expire!=1&&isbtn}}"><view data-event-opts="{{[['tap',[['goPass',['$event']]]]]}}" class="btn" style="{{(btn_style)}}" catchtap="__e">确认放行</view></block></view>