<view class="container"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><view class="big-box"><view class="card"><view class="title">{{item.record_name}}</view><block wx:for="{{item.record_cate_field_config}}" wx:for-item="items" wx:for-index="indexs"><view><block wx:if="{{items.type==1}}"><view><view class="top-title">{{''+items.title+''}}</view><view class="input-box"><textarea class="input-btn" maxlength="1000" value="{{listdata[index]['record_cate_field_config'][indexs]['aricle_title']}}" placeholder="如有问题,请填写情况说明" data-event-opts="{{[['input',[['__set_model',['$0','aricle_title','$event',[]],['listdata.'+index+'.record_cate_field_config.'+indexs+'']],['iptText',['$event',index,indexs]]]]]}}" bindinput="__e"></textarea></view></view></block><block wx:if="{{items.type==2}}"><view><view class="top-title">{{''+items.title+''}}</view><view class="image-box"><upload-img class="vue-ref-in-for" vue-id="{{'59f11ea8-1-'+index+'-'+indexs}}" sourceTypeT="{{sourceType}}" currentIndex="{{index}}" indexs="{{indexs}}" canUploadFile="{{true}}" limit="{{9}}" isshow_text="{{false}}" upborder_radius="{{true}}" fileKeyName="imgFile" uploadFileUrl="{{requestDomain+'appapi.php?g=Appapi&c=HouseApi&a=qrcode_image'}}" uImgList_a="{{uImgList_a}}" data-ref="upimg" data-event-opts="{{[['^deleteItem',[['deleteThis']]],['^updateUImgList_a',[['__set_sync',['$0','uImgList_a','$event'],['']]]],['^updateUImgList_a',[['__set_sync',['$0','uImgList_a','$event'],['']]]],['^uploadSuccess',[['uploadSuccess',['$event',index,indexs]]]]]}}" bind:deleteItem="__e" bind:updateUImgList_a="__e" bind:uploadSuccess="__e" bind:__l="__l"></upload-img></view></view></block><block wx:if="{{items.type==3}}"><view><view class="top-title">{{''+items.title+''}}</view><block wx:for="{{items.use_field}}" wx:for-item="itm" wx:for-index="idx"><view data-event-opts="{{[['tap',[['switchBtn',[index,indexs,idx,'$0'],[[['listdata','',index],['record_cate_field_config','',indexs],['use_field','',idx]]]]]]]}}" class="switch-box" bindtap="__e"><view class="{{['switch',(type=='radio'&&items['num']==idx)?'switch1':'']}}"><view class="{{['switch-mini',(type=='radio'&&items['num']==idx)?'switch-mini1':'']}}"></view></view><view class="switch-text">{{itm}}</view></view></block></view></block></view></block></view></view></block><button class="btn" style="{{(btn_style)}}" type="primary" data-event-opts="{{[['tap',[['uPublishTap',['$event']]]]]}}" bindtap="__e">提交</button></view>