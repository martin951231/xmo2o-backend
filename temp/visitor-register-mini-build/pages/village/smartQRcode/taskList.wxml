<view class="container"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><view data-event-opts="{{[['tap',[['gomap',['$0'],[[['listdata','',index,'cate_id']]]]]]]}}" class="card" bindtap="__e"><view class="top-box"><view class="top-title">{{'任务名称：'+item.cate_name+''}}</view><block wx:if="{{item.desc_status==1}}"><view class="tips">{{item.desc}}</view></block><block wx:if="{{item.desc_status==2}}"><view class="tips" style="background:rgb(24, 210, 160);">{{item.desc}}</view></block><block wx:if="{{item.desc_status==3}}"><view class="tips" style="background:rgb(108, 167, 255);">{{item.desc}}</view></block></view><view class="text">{{"任务完成进度："+item.num}}</view><view class="text">{{"任务完成周期："+item.record_type_desc}}</view><block wx:if="{{item.record_type==1}}"><view class="text">{{"任务完成时间："+item.record_time_one}}</view></block><block wx:if="{{item.record_type==2}}"><view class="text">{{"任务完成时间："+item.record_time_two}}</view></block><block wx:if="{{item.record_type==3}}"><view class="text">{{"任务完成时间："+item.record_time_three}}</view></block></view></block><view data-event-opts="{{[['tap',[['goinspection',['$event']]]]]}}" class="report" bindtap="__e"><image class="publish-img" src="https://cloud.mrsqfw.com/static/wxapp/images/historyList.png"></image></view></view>