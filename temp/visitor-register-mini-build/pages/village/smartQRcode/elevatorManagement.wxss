page{background:#f5f5f5}.container{margin:0;padding:0}.top-icon{margin:20rpx;height:350rpx;border-radius:10rpx;overflow:hidden}.top-img{width:100%;height:350rpx;border-radius:10rpx;display:block}.card{background:#fff;margin:30rpx 30rpx 0rpx 30rpx;padding:0rpx 20rpx 20rpx 20rpx;border-radius:20rpx}.top-box{display:flex;flex-direction:row;justify-content:space-between;align-items:center;border-bottom:1rpx solid #f1f1f1;margin-bottom:10rpx}.top-title{font-size:30rpx;font-weight:700;line-height:90rpx;display:flex;flex-direction:row;align-items:center}.top-title:before{content:"";background:#fff;display:block;width:8rpx;height:8rpx;border:4rpx solid #4a97f8;border-radius:8rpx;margin-right:15rpx}.text{font-size:26rpx;color:#828282;line-height:50rpx}.card-img{width:200rpx;height:200rpx;display:block;border-radius:10rpx}.btn-box{display:flex;flex-direction:row;justify-content:space-between;margin:100rpx 50rpx}.btn{background:#157ff6!important;width:280rpx;box-shadow:0rpx 0rpx 17rpx 1rpx hsla(0,0%,84.7%,.68);border-radius:50rpx;font-size:30rpx;line-height:80rpx}uni-button:after{border:0rpx}