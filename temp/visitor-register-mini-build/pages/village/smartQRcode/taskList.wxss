page{background:#f5f5f5}.container{margin:0;padding:0}.card{background:#fff;margin:30rpx;padding:0rpx 20rpx 20rpx 20rpx;border-radius:20rpx}.top-box{display:flex;flex-direction:row;justify-content:space-between;align-items:center;border-bottom:1rpx solid #f1f1f1;margin-bottom:10rpx}.top-title{font-size:30rpx;font-weight:700;line-height:90rpx;display:flex;flex-direction:row;align-items:center}.top-title:before{content:"";background:#fff;display:block;width:8rpx;height:8rpx;border:4rpx solid #4a97f8;border-radius:8rpx;margin-right:15rpx}.tips{font-size:28rpx;color:#fff;background:#ffa300;border-radius:0rpx 30rpx 30rpx 30rpx;padding:5rpx 28rpx}.text{font-size:28rpx;color:#828282;line-height:50rpx}.report{position:fixed;box-shadow:0rpx 0rpx 17rpx 1rpx hsla(0,0%,84.7%,.68);bottom:165rpx;right:24rpx;width:102rpx;height:102rpx;border-radius:102rpx;z-index:99}.publish-img{width:100%;height:100%;border-radius:100%;box-shadow:0rpx 0rpx 17rpx 1rpx hsla(0,0%,84.7%,.68)}