<view class="container"><view style="z-index:0;height:100%;"><map style="width:100%;height:100vh;" id="myMap" latitude="{{latitude}}" longitude="{{longitude}}" markers="{{markers}}" show-location="{{openaddress}}" enable-scroll="{{true}}" polyline="{{polylines}}" include-points="{{include_points}}" data-event-opts="{{[['tap',[['bindtap',['$event']]]],['markertap',[['callouttap',['$event']]]],['callouttap',[['callouttap',['$event']]]],['regionchange',[['regionchange',['$event']]]],['updated',[['updated',['$event']]]]]}}" bindtap="__e" bindmarkertap="__e" bindcallouttap="__e" bindregionchange="__e" bindupdated="__e"></map></view><view class="store-tips"><block wx:if="{{storeFlag}}"><cover-view data-event-opts="{{[['tap',[['storeDesEvn',['$event']]]]]}}" class="store-des-box" bindtap="__e"><cover-image class="store-img" src="https://cloud.mrsqfw.com/static/wxapp/images/dingwei.png"></cover-image><cover-view class="store-des"><cover-view class="store-name">{{store.name}}</cover-view><cover-view class="store-address">{{"地址:"+store.address}}</cover-view><cover-view class="store-tel">{{"电话:"+store.tel}}</cover-view></cover-view></cover-view></block></view><view class="card"><view class="text">{{"待完成："+numlist.qrcode_uncount+"/"+numlist.qrcode_count}}</view><view class="title-box"><view class="title">待记录</view><view class="title1">已记录</view></view></view><cover-image class="gorecording" src="https://cloud.mrsqfw.com/static/wxapp/images/recording.png" data-event-opts="{{[['tap',[['gorecording',['$event']]]]]}}" bindtap="__e"></cover-image><cover-image class="gocheckme" src="https://cloud.mrsqfw.com/static/wxapp/images/dingwei3.png" data-event-opts="{{[['tap',[['gocheckme',['$event']]]]]}}" bindtap="__e"></cover-image></view>