<view class="container"><view class="container-box"><view class="background-color" style="{{('background:'+mobile_head_color)}}"><view class="topbox"><view class="text">{{"当前快递柜剩余"+numlist.express_count+"个柜子，其中大柜："+numlist.express_max_conunt+"个；中柜："+numlist.express_in_count+"个；小柜："+numlist.express_small_count+"个"}}</view></view></view><view class="title">快递单号</view><view class="select-box"><radio-group data-event-opts="{{[['change',[['radioChange',['$event']]]]]}}" class="selectChange" bindchange="__e"><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index"><label class="box"><view><radio value="{{item.value}}" checked="{{item.type==1}}"></radio></view><view>{{item.name}}</view></label></block></radio-group></view><view class="title">快递单号</view><view data-event-opts="{{[['tap',[['selecttime',['$event']]]]]}}" class="input-box" bindtap="__e"><input class="input-btn" type="text" placeholder-style="padding-left: 30rpx;font-size: 28rpx;font-weight: normal;font-stretch: normal;line-height: 60rpx;letter-spacing: 0rpx;color: #c3c3c3;text-align:center" placeholder="请输入快递单号" data-event-opts="{{[['input',[['__set_model',['','num','$event',[]]]]]]}}" value="{{num}}" bindinput="__e"/><view class="right-icon"><image class="right-img" src="https://cloud.mrsqfw.com/static/wxapp/images/saoyisao.png"></image></view></view><view class="title">手机号码</view><input class="inp-box" type="number" placeholder-style="font-size: 28rpx;font-weight: normal;font-stretch: normal;line-height: 50rpx;letter-spacing: 0rpx;color: #c3c3c3;text-align:center" placeholder="请输入手机号码" data-event-opts="{{[['input',[['__set_model',['','phone','$event',[]]]]]]}}" value="{{phone}}" bindinput="__e"/><view class="title">姓名(非必填)</view><input class="inp-box" type="text" placeholder-style="font-size: 28rpx;font-weight: normal;font-stretch: normal;line-height: 50rpx;letter-spacing: 0rpx;color: #c3c3c3;text-align:center" placeholder="请输入姓名" data-event-opts="{{[['input',[['__set_model',['','name','$event',[]]]]]]}}" value="{{name}}" bindinput="__e"/></view><view class="btn"><button class="btn-pry" style="{{(btn_style)}}" type="primary" data-event-opts="{{[['tap',[['uPublishTap',['$event']]]]]}}" bindtap="__e">提交</button></view></view>