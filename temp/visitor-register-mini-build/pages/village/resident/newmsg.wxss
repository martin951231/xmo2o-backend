.container{padding:0 0 0 0;margin:0;background:#f5f5f5;padding-top:15rpx}.container-box{background:#fff}.msg-box{display:flex;flex-direction:row;justify-content:space-between;align-items:center;padding:18rpx 18rpx 18rpx 0;border-bottom:1rpx solid #ececec;margin-left:18rpx}.info-box{display:flex;flex-direction:row}.info-icon{width:85rpx;height:85rpx}.info-img{width:100%;height:100%}.info-text{display:flex;flex-direction:column;justify-content:center;padding-left:18rpx}.name{font-size:26rpx;font-weight:700;color:#5f6e95;line-height:44rpx}.text{font-size:26rpx;font-weight:500;color:#131313;line-height:44rpx}.text-zan{width:30rpx;height:30rpx}.text-zanimg{width:100%;height:100%}.time{font-size:24rpx;font-weight:500;color:#5b5b5b;line-height:44rpx}.msg-icon{width:110rpx;height:110rpx}.msg-text{font-size:20rpx;width:110rpx;height:110rpx;word-wrap:break-word;word-break:break-all;overflow:hidden}.msg-img{width:100%;height:100%}