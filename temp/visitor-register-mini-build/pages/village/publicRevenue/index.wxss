page{background:#f6f6f6;min-height:100%}.page{padding:28rpx}.hero{padding:24rpx 8rpx 30rpx}.title{font-size:42rpx;font-weight:700;color:#333}.village{margin-top:12rpx;color:#777;font-size:26rpx}.balance-card{padding:34rpx;border-radius:20rpx;background:linear-gradient(135deg,#ffe3a8,#ffc873);box-shadow:0 12rpx 28rpx rgba(211,143,36,.18)}.card-head{display:flex;justify-content:space-between;font-size:32rpx;font-weight:600;color:#59401e}.link{font-size:26rpx;font-weight:400}.date{margin-top:18rpx;font-size:24rpx;color:#8a6b3d}.balances{display:flex;align-items:center;margin-top:34rpx}.balance-item{flex:1;text-align:center}.amount{font-size:54rpx;font-weight:700;color:#3c3020}.unit{margin-left:6rpx;font-size:22rpx;color:#735c3a}.label{margin-top:10rpx;font-size:24rpx;color:#785f3a}.divider{width:1px;height:76rpx;background:rgba(104,72,24,.2)}.empty{margin-top:160rpx;text-align:center;color:#999;font-size:28rpx}