page{min-height:100%;background:#f3f4f6}.page{position:relative;box-sizing:border-box;min-height:100vh;overflow:hidden;color:#2f3133}.page-background-image{position:absolute;top:0;left:0;z-index:0;width:100%}.page-content{position:relative;z-index:1;box-sizing:border-box;padding:32rpx 28rpx 48rpx}.page-header{padding:12rpx 4rpx 30rpx}.page-title{font-size:40rpx;line-height:1.4;font-weight:700;color:#27292b}.village{margin-top:14rpx;font-size:30rpx;color:#55595e}.period{margin-top:8rpx;font-size:27rpx;color:#999da2}.section-card{margin-bottom:24rpx;padding:28rpx 24rpx;border:1rpx solid #eceef0;border-radius:14rpx;background:#fff;box-shadow:0 4rpx 16rpx rgba(31,35,41,.04)}.section-heading{display:flex;align-items:center;justify-content:space-between}.section-title{padding-left:14rpx;border-left:5rpx solid #e7b65d;font-size:29rpx;line-height:1.15;font-weight:600}.more{font-size:22rpx;color:#9a9da1}.arrow{margin-left:4rpx;font-size:30rpx;vertical-align:-2rpx}.metric-grid{display:flex;margin-top:30rpx}.metric-column{box-sizing:border-box;width:50%;min-width:0}.metric-column:first-child{padding-right:24rpx}.metric-column + .metric-column{padding-left:24rpx;border-left:1rpx solid #f0f1f2}.sub-title{margin:32rpx 0 0;padding-top:25rpx;border-top:1rpx solid #f0f1f2;font-size:24rpx;font-weight:600;color:#5e6267}.income-title{color:#4f9f68}.expense-title{color:#d56868}.net-panel{display:flex;align-items:center;justify-content:space-between;margin-top:30rpx;padding:22rpx 20rpx;border-radius:10rpx;background:#f7f8f9}.net-label{flex-shrink:0;font-size:27rpx;color:#62666a}.net-values{display:flex;flex-direction:column;align-items:flex-end;font-size:27rpx;line-height:1.75;font-weight:600;color:#34373a}.result-grid{padding-bottom:8rpx}.formula{margin-top:26rpx;padding-top:20rpx;border-top:1rpx solid #f0f1f2;text-align:right;font-size:21rpx;color:#a0a3a6}.notice{padding:2rpx 8rpx 20rpx;font-size:21rpx;line-height:1.7;color:#9a9da1}.empty{margin-top:180rpx;text-align:center;font-size:26rpx;color:#999}