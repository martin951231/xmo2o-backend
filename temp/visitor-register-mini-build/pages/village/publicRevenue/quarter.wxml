<view class="page" style="{{(pageStyle)}}"><block wx:if="{{pageBackgroundImage}}"><image class="page-background-image" src="{{pageBackgroundImage}}" mode="widthFix"></image></block><custom-nav-bar vue-id="26f1a67c-1" title="收支明细" titleSize="34rpx" showMenu="home" titleColor="black" bgColor="transparent" customHeader="{{false}}" bind:__l="__l"></custom-nav-bar><view class="page-content"><block wx:if="{{loading}}"><view class="empty">加载中...</view></block><block wx:else><block wx:if="{{!data.has_data}}"><view class="empty">暂无数据</view></block><block wx:else><view class="page-header"><view class="page-title">公共资源经营收益</view><view class="village">{{villageName}}</view><view class="period">{{data.year+"年第"+quarterText[data.quarter]+"季度 · 截至"+data.as_of_date}}</view></view><view class="section-card"><view class="section-title income-title">本期收入</view><view class="metric-grid"><view class="metric"><view><text class="amount">{{$root.m0}}</text><text class="unit">元</text></view><view class="metric-label">应收收入</view></view><view class="metric"><view><text class="amount">{{$root.m1}}</text><text class="unit">元</text></view><view class="metric-label">实收收入</view></view></view><block wx:if="{{$root.g0}}"><view class="details"><block wx:for="{{incomeList}}" wx:for-item="item" wx:for-index="__i0__" wx:key="subject_id"><detail-row vue-id="{{'26f1a67c-2-'+__i0__}}" item="{{item}}" first-label="应收" second-label="实收" bind:__l="__l"></detail-row></block></view></block></view><view class="section-card"><view class="section-title expense-title">本期支出</view><view class="metric-grid"><view class="metric"><view><text class="amount">{{$root.m2}}</text><text class="unit">元</text></view><view class="metric-label">应付支出</view></view><view class="metric"><view><text class="amount">{{$root.m3}}</text><text class="unit">元</text></view><view class="metric-label">实付支出</view></view></view><block wx:if="{{$root.g1}}"><view class="details"><block wx:for="{{expenseList}}" wx:for-item="item" wx:for-index="__i1__" wx:key="subject_id"><detail-row vue-id="{{'26f1a67c-3-'+__i1__}}" item="{{item}}" first-label="应付" second-label="实付" bind:__l="__l"></detail-row></block></view></block></view><view class="section-card"><view class="section-title balance-title">本期结余</view><view class="metric-grid"><view class="metric"><view><text class="amount">{{$root.m4}}</text><text class="unit">元</text></view><view class="metric-label">结余</view></view></view></view><view class="note"><view>注：</view><view>1. 金额单位为元，负数表示冲销或调账。</view><view>2. 收益结余可能存在细微差异，如有疑问请联系物业服务中心。</view></view></block></block></view></view>