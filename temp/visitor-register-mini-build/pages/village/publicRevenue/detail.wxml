<view class="page" style="{{(pageStyle)}}"><block wx:if="{{pageBackgroundImage}}"><image class="page-background-image" src="{{pageBackgroundImage}}" mode="widthFix"></image></block><custom-nav-bar vue-id="30993d86-1" title="公共收益" titleSize="34rpx" showMenu="home" titleColor="black" bgColor="transparent" customHeader="{{false}}" bind:__l="__l"></custom-nav-bar><view class="page-content"><block wx:if="{{loading}}"><view class="empty">加载中...</view></block><block wx:else><block wx:if="{{!data.has_data}}"><view class="empty">暂无数据</view></block><block wx:else><view class="page-header"><view class="page-title">公共资源经营收益结余</view><view class="village">{{data.village_name||'当前小区'}}</view><view class="period">{{data.year+"年"+data.quarter_name}}</view></view><view class="section-card"><view class="section-title">年初结余</view><view class="metric-grid"><amount-item vue-id="30993d86-2" value="{{data.opening_actual_balance}}" bind:__l="__l"></amount-item></view></view><view data-event-opts="{{[['tap',[['goQuarter',['$event']]]]]}}" class="section-card clickable" bindtap="__e"><view class="section-heading"><view class="section-title">收益及使用情况</view><view class="more">季度详情 <text class="arrow">›</text></view></view><view class="sub-title income-title">本年度收入</view><view class="metric-grid"><view class="metric-column"><amount-item vue-id="30993d86-3" label="应收收入" value="{{data.annual_accrual_income}}" bind:__l="__l"></amount-item></view><view class="metric-column"><amount-item vue-id="30993d86-4" label="实收收入" value="{{data.annual_actual_income}}" bind:__l="__l"></amount-item></view></view><view class="sub-title expense-title">本年度支出</view><view class="metric-grid"><view class="metric-column"><amount-item vue-id="30993d86-5" label="应付支出" value="{{data.annual_accrual_expense}}" bind:__l="__l"></amount-item></view><view class="metric-column"><amount-item vue-id="30993d86-6" label="实付支出" value="{{data.annual_actual_expense}}" bind:__l="__l"></amount-item></view></view><view class="net-panel"><view class="net-label">本年度收支净额</view><view class="net-values"><text>{{$root.m0+" 元"}}</text></view></view></view><view class="section-card"><view class="section-title">年度结余</view><view class="metric-grid result-grid"><amount-item vue-id="30993d86-7" value="{{data.actual_balance}}" bind:__l="__l"></amount-item></view><view class="formula">年初结余 + 本年度收入 − 本年度支出</view></view><view class="notice"><view>注：</view><view>1. 金额单位为元，负数表示冲销或调账。</view><view>2. 数据按季度更新，如有疑问请联系物业服务中心。</view></view></block></block></view></view>