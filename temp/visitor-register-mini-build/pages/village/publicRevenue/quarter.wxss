page{min-height:100%;background:#f3f4f6}.page{position:relative;box-sizing:border-box;min-height:100vh;overflow:hidden;color:#2f3133}.page-background-image{position:absolute;top:0;left:0;z-index:0;width:100%}.page-content{position:relative;z-index:1;box-sizing:border-box;padding:32rpx 28rpx 48rpx}.page-header{padding:12rpx 4rpx 30rpx}.page-title{font-size:40rpx;line-height:1.4;font-weight:700;color:#27292b}.village{margin-top:14rpx;font-size:30rpx;color:#55595e}.period{margin-top:8rpx;font-size:27rpx;color:#999da2}.section-card{margin-bottom:24rpx;padding:28rpx 24rpx;border:1rpx solid #eceef0;border-radius:14rpx;background:#fff;box-shadow:0 4rpx 16rpx rgba(31,35,41,.04)}.section-title{padding-left:14rpx;border-left:5rpx solid;font-size:29rpx;line-height:1.15;font-weight:600}.income-title{border-color:#55b76e}.expense-title{border-color:#e36c6c}.balance-title{border-color:#e7b65d}.metric-grid{display:flex;margin-top:32rpx}.metric{flex:1;min-width:0;text-align:left}.metric + .metric{padding-left:28rpx;border-left:1rpx solid #f0f1f2}.amount{font-size:46rpx;line-height:1.25;font-weight:700;color:#303336}.unit{margin-left:5rpx;font-size:20rpx;color:#92969a}.metric-label{margin-top:9rpx;font-size:26rpx;color:#888c90}.details{margin-top:28rpx;padding:4rpx 18rpx;border-radius:10rpx;background:#f7f8f9}.note{padding:2rpx 8rpx 20rpx;font-size:21rpx;line-height:1.7;color:#9a9da1}.empty{margin-top:180rpx;text-align:center;font-size:26rpx;color:#999}