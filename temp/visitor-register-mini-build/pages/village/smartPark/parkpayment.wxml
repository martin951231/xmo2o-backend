<view class="container"><view class="topbox"><block wx:if="{{infoData}}"><view class="text"><block wx:if="{{village_name}}"><label class="_span">{{"当前\n\t\t\t"+(config.config&&config.config.set_house_alias&&config.config.house_name?config.config.house_name:'小区')+"\n\t\t\t："+village_name+"；"}}</label></block><block wx:if="{{infoData.garage_num}}"><label class="_span">{{"所属车库："+infoData.garage_num+"；"}}</label></block><block wx:if="{{infoData.position_num}}"><label class="_span">{{"车位号："+infoData.position_num+"；"}}</label></block><block wx:if="{{infoData.car_number}}"><label class="_span">{{"车牌号："+infoData.car_number+"；"}}</label></block><view class="_br"></view><block wx:if="{{infoData.end_time}}"><label class="_span">{{"车位到期时间："+infoData.end_time+"；"}}</label></block></view></block></view><view class="paycard"><view class="card-text"> 请选择您要缴纳的停车费时间 </view><view class="card-box"><block wx:for="{{listData}}" wx:for-item="item" wx:for-index="index" wx:key="index"><block wx:if="{{listData&&listData[0]}}"><view data-event-opts="{{[['tap',[['selectmonth',[index]]]]]}}" class="{{['mini-card',num==index?'active':'']}}" bindtap="__e"><view class="text4">{{''+item.park_month_num_desc+''}}</view><block wx:if="{{listData&&listData[0]&&item.presented_park_month_num_desc}}"><view class="tips">{{''+item.presented_park_month_num_desc+''}}</view></block></view></block></block></view><view class="diybox"><view class="diytext">生效日期</view><view data-event-opts="{{[['tap',[['chooseStart',['$event']]]]]}}" class="diy_content" style="display:flex;align-items:center;color:#666;" bindtap="__e">{{(start_date?start_date:'今天')+''}}<u-icon style="margin-left:10rpx;" vue-id="366bb8b2-1" name="arrow-down" bind:__l="__l"></u-icon></view></view><block wx:if="{{diy_content}}"><view class="diybox"><view class="diytext">赠送物品</view><view class="diy_content">{{diy_content}}</view></view></block><block wx:if="{{end_time}}"><view class="diybox"><view class="diytext">预计到期时间</view><view class="diy_content">{{end_time}}</view></view></block><view class="cell"></view><view class="paynum"><view class="text1"> 缴费总额 </view><view class="num">{{'￥'+totle_price+''}}</view></view></view><button class="btn" style="{{('background-color:'+btncolor)}}" type="primary" data-event-opts="{{[['tap',[['btnpay',['$event']]]]]}}" bindtap="__e">去支付</button><u-calendar vue-id="366bb8b2-2" min-date="{{getCurrentDate}}" defaultDate="{{getCurrentDate}}" max-date="2099-12-30" list="{{[]}}" mode="date" value="{{showStart}}" data-event-opts="{{[['^change',[['handleDateConfirm']]],['^input',[['__set_model',['','showStart','$event',[]]]]]]}}" bind:change="__e" bind:input="__e" bind:__l="__l"></u-calendar></view>