<view class="container"><view class="select-plate">{{''+car_number+''}}</view><block wx:if="{{listdata.duration_num>0}}"><view class="box"><view class="minibox"><view class="title">停车场：</view><view class="title">{{listdata.village_name}}</view></view><view class="minibox"><view class="title">进场时间：</view><view class="title">{{listdata.in_time}}</view></view><view class="minibox"><view class="title">停车时间：</view><view class="title">{{listdata.duration}}</view></view><block wx:if="{{listdata&&listdata.free_out_time_desc}}"><view class="minibox"><view class="title">免费离场时间：</view><view class="title">{{listdata.free_out_time_desc+"分钟"}}</view></view></block></view></block><block wx:if="{{listdata.duration_num>0}}"><view class="text"><text style="font-size:28;">¥</text>{{listdata.price}}</view></block><block wx:if="{{listdata.duration_num>0}}"><button class="btn" style="{{(btn_style)}}" type="primary" data-event-opts="{{[['tap',[['uPublishTap',['$event']]]]]}}" bindtap="__e">立即支付</button></block></view>