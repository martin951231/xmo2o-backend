<view><userinfo vue-id="4f3004a3-1" id="user" options="{{user_options}}" data-event-opts="{{[['^getUserscope',[['getUserInfo']]],['^toLogin',[['getUserInfo']]]]}}" bind:getUserscope="__e" bind:toLogin="__e" bind:__l="__l"></userinfo><view class="container"><block wx:if="{{!no_data}}"><view><block wx:for="{{listdata}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['goUrl',['$0','$1'],[[['listdata','',index,'id']],[['listdata','',index,'from_id']]]]]]]}}" class="report-card" bindtap="__e"><view class="title">{{''+item.title+''}}</view><view class="text-box"><view class="time">{{''+item.add_time_txt+''}}</view><block wx:if="{{item&&item.diy_tatus=='0'}}"><view class="accept">{{''+item.diy_tatus_txt+''}}</view></block><block wx:if="{{item&&item.diy_tatus=='1'}}"><view class="accept active">{{''+item.diy_tatus_txt+''}}</view></block><block wx:if="{{item&&item.diy_tatus=='3'}}"><view class="accept active1">{{''+item.diy_tatus_txt+''}}</view></block></view></view></block></view></block><block wx:if="{{pageLoading}}"><view class="tip"><lang vue-id="4f3004a3-2" keywords="加载中" bind:__l="__l"></lang></view></block><block wx:if="{{pageLoadings}}"><view class="tip"><lang vue-id="4f3004a3-3" keywords="没有更多记录" bind:__l="__l"></lang></view></block><block wx:if="{{no_data}}"><view class="tip_box_no_data"><image class="no_data_img" src="https://cloud.mrsqfw.com/static/images/house/no_data.png"></image><view class="no_tip_content">还没有内容哦</view></view></block></view><block wx:if="{{template_id}}"><view data-event-opts="{{[['tap',[['goreport',['$event']]]]]}}" class="report" bindtap="__e"><image class="publish-img" src="https://cloud.mrsqfw.com/static/wxapp/images/waterReport.png"></image></view></block></view>