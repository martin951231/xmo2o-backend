page{background-color:#f5f5f5}.container{margin:0;padding:0}.report-card{display:flex;flex-direction:column;justify-content:space-between;padding:15rpx 15rpx 15rpx 30rpx;margin:20rpx 25rpx;background-color:#fff;box-shadow:0rpx 0rpx 17rpx 1rpx hsla(0,0%,84.7%,.68);border-radius:20rpx;overflow:hidden}.text-box{display:flex;flex-direction:row;justify-content:space-between;align-items:center}.title{font-size:32rpx;color:#000;line-height:70rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-right:30rpx}.time{font-size:24rpx;color:#ccc;line-height:70rpx}.accept{font-size:24rpx;color:#fff;background-color:red;line-height:40rpx;border-radius:23rpx;flex-shrink:0;margin-right:30rpx;padding:0 15rpx}.active{background-color:#3adb99}.active1{background-color:#7ca6f7}.active2{background-color:#2681f3}.active3{background-color:#ffa801}.report{position:fixed;bottom:165rpx;right:24rpx;width:102rpx;height:102rpx;z-index:99}.publish-img{width:100%;height:100%}.bgbox{position:fixed;top:0;left:0;bottom:0;right:0;display:flex;align-items:center;justify-content:center}.tip{display:flex;justify-content:center;align-items:center;font-size:14px;color:#666;padding:10px 0;background:#f8f8f8}.tip image{width:20px;height:20px;margin-right:5px}.tip_box_no_data{padding-top:calc((100vh - 80rpx - 288rpx - 21rpx)/2);font-size:28rpx;text-align:center}.tip_box_no_data .tip_title{width:100%;text-align:center}.no_data_img{width:374rpx;height:288rpx}